{
  "title": "Family",
  "note": "Possessives agree with the thing owned, not the owner: meu pai, minha mãe, meus irmãos. To say his or her clearly, put dele or dela after the noun: o irmão dela (her brother). Watch the accent: avô is grandfather, avó is grandmother.",
  "src": {"t": "Língua da Gente, Beginning 10: Your Sister Is Beautiful", "u": "https://linguadagente.coerll.utexas.edu/beginning-your-sister-is-beautiful/"},
  "items": [
    {"c": "a família", "a": "the family", "d": ["the house", "the friends"]},
    {"c": "o pai", "a": "the father", "d": ["the mother", "the uncle"], "ex": "Meu pai é médico.", "exT": "My father is a doctor."},
    {"c": "a mãe", "a": "the mother", "d": ["the father", "the aunt"], "ex": "Minha mãe se chama Rosa.", "exT": "My mother's name is Rosa."},
    {"c": "os pais", "a": "the parents", "d": ["the relatives", "the grandparents"], "ex": "Meus pais moram em Recife.", "exT": "My parents live in Recife."},
    {"c": "o filho", "a": "the son", "d": ["the daughter", "the brother"], "ex": "O filho dela tem cinco anos.", "exT": "Her son is five."},
    {"c": "a filha", "a": "the daughter", "d": ["the son", "the sister"]},
    {"c": "os filhos", "a": "the children (sons and daughters)", "d": ["the brothers and sisters", "the grandparents"]},
    {"c": "o irmão", "a": "the brother", "d": ["the sister", "the cousin"], "ex": "Meu irmão mora em Brasília.", "exT": "My brother lives in Brasília."},
    {"c": "a irmã", "a": "the sister", "d": ["the brother", "the aunt"], "ex": "Sua irmã é linda!", "exT": "Your sister is beautiful!"},
