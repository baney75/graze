    {"c": "os avós", "a": "the grandparents", "d": ["the parents", "the grandchildren"]},
    {"c": "o tio", "a": "the uncle", "d": ["the cousin", "the nephew"], "ex": "O meu tio é engenheiro.", "exT": "My uncle is an engineer."},
    {"c": "a tia", "a": "the aunt", "d": ["the niece", "the cousin (female)"]},
