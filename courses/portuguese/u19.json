{
  "title": "Feelings and opinions",
  "note": "Use estar for how you feel now, and make the adjective agree: Ele está cansado, Ela está cansada. Some feelings use estar com + noun: Estou com medo, Estou com saudade. Give opinions with Acho que... (I think that...), Para mim... (For me...) or Na minha opinião... After para, use mim, not eu.",
  "src": {"t": "Língua da Gente, Elementary 16: Dessert Makes Me Happy", "u": "https://linguadagente.coerll.utexas.edu/elementary-dessert-makes-me-happy/"},
  "items": [
    {"c": "feliz", "a": "happy", "d": ["sad", "tired"], "ex": "Estou muito feliz hoje.", "exT": "I'm very happy today."},
    {"c": "triste", "a": "sad", "d": ["happy", "angry"], "ex": "Por que você está triste?", "exT": "Why are you sad?"},
    {"c": "contente", "a": "glad, pleased", "d": ["worried", "bored"]},
    {"c": "preocupado", "a": "worried", "d": ["busy", "bored"], "ex": "Ela está preocupada com a prova.", "exT": "She's worried about the test."},
    {"c": "nervoso", "a": "nervous", "d": ["calm", "proud"]},
    {"c": "calmo", "a": "calm", "d": ["nervous", "tired"]},
    {"c": "animado", "a": "excited, in good spirits", "d": ["bored", "worried"]},
    {"c": "entediado", "a": "bored", "d": ["excited", "scared"]},
    {"c": "Estou com medo.", "a": "I'm scared.", "d": ["I'm angry.", "I'm cold."]},
    {"c": "Estou com raiva.", "a": "I'm angry.", "d": ["I'm afraid.", "I'm in a hurry."]},
    {"c": "Estou com saudade de você.", "a": "I miss you.", "d": ["I'm proud of you.", "I'm worried about you."], "ex": "Mãe, estou com saudade de você!", "exT": "Mom, I miss you!"},
    {"c": "Que pena!", "a": "What a shame!", "d": ["What a relief!", "How nice!"], "ex": "Você não pode vir? Que pena!", "exT": "You can't come? What a shame!"},
    {"c": "Que bom!", "a": "How nice!", "d": ["How sad!", "Too bad!"]},
    {"c": "chato", "a": "boring, annoying", "d": ["fun", "kind"], "ex": "Esse filme é muito chato.", "exT": "This movie is really boring."},
    {"c": "divertido", "a": "fun", "d": ["boring", "tiring"], "ex": "A festa foi muito divertida.", "exT": "The party was a lot of fun."},
    {"c": "engraçado", "a": "funny", "d": ["serious", "boring"]},
    {"c": "O que você acha?", "a": "What do you think?", "d": ["What did you find?", "What are you looking for?"], "ex": "Vamos de ônibus. O que você acha?", "exT": "Let's go by bus. What do you think?"},
    {"c": "Acho que sim.", "a": "I think so.", "d": ["I don't think so.", "I know so."]},
    {"c": "Acho que não.", "a": "I don't think so.", "d": ["I think so.", "I don't know."]},
    {"c": "Na minha opinião...", "a": "In my opinion...", "d": ["In my experience...", "In my house..."]},
    {"c": "Concordo.", "a": "I agree.", "d": ["I disagree.", "I remember."], "ex": "O filme é ótimo. Concordo!", "exT": "The movie is great. I agree!"},
    {"c": "Não concordo.", "a": "I don't agree.", "d": ["I agree.", "I don't remember."]},
    {"c": "Eu adoro música.", "a": "I love music.", "d": ["I hate music.", "I make music."]},
    {"c": "Eu odeio acordar cedo.", "a": "I hate waking up early.", "d": ["I love waking up early.", "I need to wake up early."]},
    {"c": "Prefiro ficar em casa.", "a": "I'd rather stay home.", "d": ["I have to stay home.", "I stayed home."], "ex": "Prefiro ficar em casa e ver um filme.", "exT": "I'd rather stay home and watch a movie."},
    {"c": "Ela está muito ___. (cansado)", "a": "cansada", "d": ["cansado", "cansadas"]},
    {"c": "Eles estão ___. (preocupado)", "a": "preocupados", "d": ["preocupado", "preocupadas"]},
    {"c": "Eu ___ que o filme é bom. (achar)", "a": "acho", "d": ["acha", "achamos"]},
    {"c": "Nós ___ de dançar. (gostar)", "a": "gostamos", "d": ["gosta", "gostam"], "ex": "Nós gostamos de dançar samba.", "exT": "We like to dance samba."},
    {"c": "Hoje eu ___ feliz. (estar)", "a": "estou", "d": ["sou", "está"]},
    {"c": "Para ___, o verão é a melhor estação.", "a": "mim", "d": ["eu", "me"]}
  ]
}
