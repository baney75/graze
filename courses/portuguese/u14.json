{
  "title": "Work and school",
  "note": "Professions follow ser with no article: Sou professor, Ela é engenheira. Most change -o to -a for women: o advogado, a advogada. Ask about work with O que você faz? or Você trabalha em quê?",
  "src": {"t": "Língua da Gente, Beginning 09: What Do You Do For Work?", "u": "https://linguadagente.coerll.utexas.edu/beginning-what-do-you-do-for-work/"},
  "items": [
    {"c": "o trabalho", "a": "the work, job", "d": ["the office", "the boss"], "ex": "Você gosta do seu trabalho?", "exT": "Do you like your job?"},
    {"c": "o emprego", "a": "the job, employment", "d": ["the employee", "the company"]},
    {"c": "a empresa", "a": "the company", "d": ["the job", "the meeting"], "ex": "Ela trabalha numa empresa grande.", "exT": "She works at a big company."},
    {"c": "o escritório", "a": "the office", "d": ["the writer", "the desk"], "ex": "O escritório fica no centro.", "exT": "The office is downtown."},
    {"c": "o chefe", "a": "the boss", "d": ["the cook", "the coworker"], "ex": "Meu chefe é legal.", "exT": "My boss is nice."},
    {"c": "o colega", "a": "the coworker, classmate", "d": ["the college", "the boss"]},
    {"c": "a reunião", "a": "the meeting", "d": ["the reunion party", "the schedule"], "ex": "A reunião é às duas.", "exT": "The meeting is at two."},
    {"c": "o salário", "a": "the salary, pay", "d": ["the salad", "the bill"]},
    {"c": "o professor", "a": "the teacher (male)", "d": ["the student (male)", "the principal"], "ex": "O professor fala devagar.", "exT": "The teacher speaks slowly."},
    {"c": "a aluna", "a": "the student (female)", "d": ["the teacher (female)", "the classroom"]},
    {"c": "o estudante", "a": "the student", "d": ["the teacher", "the school"]},
    {"c": "a faculdade", "a": "college, university", "d": ["the faculty staff", "high school"]},
    {"c": "a aula", "a": "the class, lesson", "d": ["the classroom building", "the school year"], "ex": "A aula começa às oito.", "exT": "Class starts at eight."},
    {"c": "o livro", "a": "the book", "d": ["the notebook", "the magazine"]},
    {"c": "o caderno", "a": "the notebook", "d": ["the book", "the pen"]},
    {"c": "a caneta", "a": "the pen", "d": ["the pencil", "the cup"]},
    {"c": "o lápis", "a": "the pencil", "d": ["the pen", "the eraser"]},
    {"c": "a prova", "a": "the test, exam", "d": ["the proof of purchase", "the homework"], "ex": "Amanhã tenho prova de matemática.", "exT": "Tomorrow I have a math test."},
    {"c": "o dever de casa", "a": "the homework", "d": ["the housework", "the test"]},
    {"c": "o médico, a médica", "a": "doctor (man, woman)", "d": ["nurse (man, woman)", "lawyer (man, woman)"]},
    {"c": "a advogada", "a": "the lawyer (female)", "d": ["the doctor (female)", "the judge (female)"]},
    {"c": "o engenheiro", "a": "the engineer", "d": ["the mechanic", "the architect"]},
    {"c": "o enfermeiro", "a": "the nurse (male)", "d": ["the patient (male)", "the doctor (male)"]},
    {"c": "o vendedor", "a": "the salesperson", "d": ["the buyer", "the waiter"]},
    {"c": "O que você faz?", "a": "What do you do (for a living)?", "d": ["What are you doing right now?", "What did you do?"], "ex": "O que você faz? Sou enfermeira.", "exT": "What do you do? I'm a nurse."},
    {"c": "Sou estudante.", "a": "I'm a student.", "d": ["I study a lot.", "I'm a teacher."], "ex": "Sou estudante de medicina.", "exT": "I'm a medical student."},
    {"c": "aprender", "a": "to learn", "d": ["to teach", "to study"], "ex": "Quero aprender a dirigir.", "exT": "I want to learn to drive."},
    {"c": "ensinar", "a": "to teach", "d": ["to learn", "to show"]},
    {"c": "Ela é ___. (a doctor)", "a": "médica", "d": ["médico", "a médica"]},
    {"c": "Eu ___ português na faculdade. (estudar)", "a": "estudo", "d": ["estuda", "estudam"]},
    {"c": "Os alunos ___ muito. (aprender)", "a": "aprendem", "d": ["aprende", "aprendemos"]},
    {"c": "Ela ___ crianças. (ensinar)", "a": "ensina", "d": ["ensino", "ensinam"]}
  ]
}
