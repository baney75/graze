    {"c": "a farmácia", "a": "the pharmacy", "d": ["the bakery", "the hospital"], "ex": "Tem uma farmácia aqui perto?", "exT": "Is there a pharmacy near here?"},
    {"c": "a igreja", "a": "the church", "d": ["the school", "the square"]},
    {"c": "a escola", "a": "the school", "d": ["the church", "the library"]},
    {"c": "a biblioteca", "a": "the library", "d": ["the bookstore", "the school"]},
    {"c": "a praça", "a": "the town square", "d": ["the beach", "the street"], "ex": "A igreja fica na praça.", "exT": "The church is on the square."},
    {"c": "a loja", "a": "the store, shop", "d": ["the market stall", "the bank"]},
    {"c": "a praia", "a": "the beach", "d": ["the square", "the river"]},
    {"c": "o prédio", "a": "the building", "d": ["the house", "the bridge"]},
    {"c": "a esquina", "a": "the street corner", "d": ["the crosswalk", "the block"], "ex": "A padaria fica na esquina.", "exT": "The bakery is on the corner."},
    {"c": "o shopping", "a": "the shopping mall", "d": ["the supermarket", "the store"]},
