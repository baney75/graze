    {"c": "Onde fica o banco?", "a": "Where is the bank?", "d": ["When does the bank open?", "Is the bank open?"], "ex": "Com licença, onde fica o banco?", "exT": "Excuse me, where is the bank?"},
    {"c": "Vira à direita.", "a": "Turn right.", "d": ["Turn left.", "It's on the right."], "ex": "Vira à direita na esquina.", "exT": "Turn right at the corner."},
