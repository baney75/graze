{
  "title": "Question words, connectors and frequency",
  "note": "Questions: o que (what), quem (who), onde (where), quando (when), como (how), qual (which), quanto (how much), por que (why). Por que is two words when asking why; porque is one word and means because. Use qual, not o que, with ser: Qual é o seu nome? Frequency words like sempre and nunca usually come before the verb.",
  "src": {"t": "Tá Falado, Grammar Lesson 17: Também x Também não", "u": "https://coerll.utexas.edu/brazilpod/tafalado/lesson-gra17.html"},
  "items": [
    {"c": "o que", "a": "what", "d": ["who", "where"], "ex": "O que é isso?", "exT": "What is that?"},
    {"c": "quem", "a": "who", "d": ["what", "when"], "ex": "Quem é aquela menina?", "exT": "Who is that girl?"},
    {"c": "onde", "a": "where", "d": ["when", "how"], "ex": "Onde fica a estação?", "exT": "Where is the station?"},
    {"c": "quando", "a": "when", "d": ["where", "how much"], "ex": "Quando você vai ao Brasil?", "exT": "When are you going to Brazil?"},
    {"c": "por que", "a": "why", "d": ["because", "how"]},
    {"c": "porque", "a": "because", "d": ["why", "although"], "ex": "Estou em casa porque estou doente.", "exT": "I'm home because I'm sick."},
    {"c": "como", "a": "how", "d": ["when", "which"]},
    {"c": "qual", "a": "which, what", "d": ["who", "how many"]},
    {"c": "quanto", "a": "how much", "d": ["how often", "how long ago"]},
    {"c": "e", "a": "and", "d": ["or", "but"]},
    {"c": "ou", "a": "or", "d": ["and", "but"], "ex": "Café ou chá?", "exT": "Coffee or tea?"},
    {"c": "mas", "a": "but", "d": ["or", "so"]},
    {"c": "então", "a": "so, then", "d": ["but", "although"]},
    {"c": "também não", "a": "not either, neither", "d": ["also, too", "not yet"], "ex": "Não gosto de chuva. Eu também não.", "exT": "I don't like rain. Me neither."},
    {"c": "sempre", "a": "always", "d": ["never", "sometimes"], "ex": "Eu sempre almoço ao meio-dia.", "exT": "I always have lunch at noon."},
    {"c": "nunca", "a": "never", "d": ["always", "often"], "ex": "Ele nunca chega atrasado.", "exT": "He's never late."},
    {"c": "às vezes", "a": "sometimes", "d": ["always", "rarely"], "ex": "Às vezes eu vou a pé.", "exT": "Sometimes I walk."},
    {"c": "todo dia", "a": "every day", "d": ["all day long", "once a day"]},
    {"c": "de vez em quando", "a": "now and then", "d": ["every time", "right now"]},
    {"c": "muitas vezes", "a": "often, many times", "d": ["rarely", "only once"]},
    {"c": "já", "a": "already", "d": ["still", "never"], "ex": "Você já almoçou?", "exT": "Have you had lunch yet?"},
    {"c": "ainda", "a": "still, yet", "d": ["already", "soon"]},
    {"c": "depois", "a": "after, later", "d": ["before", "now"]},
    {"c": "antes", "a": "before", "d": ["after", "later"]},
    {"c": "agora", "a": "now", "d": ["later", "before"]},
    {"c": "Por que você estuda português?", "a": "Why do you study Portuguese?", "d": ["Where do you study Portuguese?", "How long have you studied Portuguese?"]},
    {"c": "Quantas vezes por semana?", "a": "How many times a week?", "d": ["How many weeks?", "Which day of the week?"]},
    {"c": "___ você mora? (where)", "a": "Onde", "d": ["Quando", "Quem"]},
    {"c": "Não vou à praia ___ está chovendo.", "a": "porque", "d": ["por que", "mas"]},
    {"c": "___ é o seu nome?", "a": "Qual", "d": ["O que", "Quem"]},
    {"c": "Eu ___ como carne. (never)", "a": "nunca", "d": ["sempre", "às vezes"]},
    {"c": "Ele ___ está dormindo. (still)", "a": "ainda", "d": ["já", "sempre"]},
    {"c": "___ custa o pão? (how much)", "a": "Quanto", "d": ["Quantos", "Qual"]}
  ]
}
