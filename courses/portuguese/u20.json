{
  "title": "Essential conversation sentences",
  "note": "When you get lost, ask: Pode repetir? Mais devagar, por favor. Como se diz... em português? In speech, tá (from está) means OK and pra is short for para. Brazilians soften requests with Você pode...? and often answer a yes-no question by repeating the verb: Você mora aqui? Moro.",
  "src": {"t": "Língua da Gente, Beginning 64: Small Talk I, Meeting Strangers", "u": "https://linguadagente.coerll.utexas.edu/beginning-small-talk-i-meeting-strangers/"},
  "items": [
    {"c": "Pode repetir, por favor?", "a": "Could you repeat that, please?", "d": ["Could you write that, please?", "Could you translate that, please?"], "ex": "Desculpa, não entendi. Pode repetir, por favor?", "exT": "Sorry, I didn't understand. Could you repeat that, please?"},
    {"c": "Mais devagar, por favor.", "a": "More slowly, please.", "d": ["Louder, please.", "Faster, please."], "ex": "Não entendo. Mais devagar, por favor.", "exT": "I don't understand. More slowly, please."},
    {"c": "Como se diz \"dog\" em português?", "a": "How do you say \"dog\" in Portuguese?", "d": ["Is \"dog\" a Portuguese word?", "How do you spell \"dog\" in Portuguese?"]},
    {"c": "O que significa \"saudade\"?", "a": "What does \"saudade\" mean?", "d": ["How do you write \"saudade\"?", "Who said \"saudade\"?"]},
    {"c": "Você fala inglês?", "a": "Do you speak English?", "d": ["Do you like English?", "Are you English?"]},
    {"c": "Falo um pouco de português.", "a": "I speak a little Portuguese.", "d": ["I speak Portuguese very well.", "I don't speak Portuguese."], "ex": "Desculpa, falo só um pouco de português.", "exT": "Sorry, I only speak a little Portuguese."},
    {"c": "Onde você mora?", "a": "Where do you live?", "d": ["Where are you from?", "Where are you going?"], "ex": "Onde você mora? Moro perto da praia.", "exT": "Where do you live? I live near the beach."},
    {"c": "Tá bom.", "a": "OK, all right.", "d": ["That's wrong.", "Not now."], "ex": "Às oito? Tá bom.", "exT": "At eight? OK."},
    {"c": "Combinado!", "a": "It's a deal!", "d": ["It's canceled!", "Congratulations!"], "ex": "Às oito na praça? Combinado!", "exT": "At eight in the square? It's a deal!"},
    {"c": "Pode deixar.", "a": "Leave it to me.", "d": ["Leave me alone.", "You can go now."]},
    {"c": "Sem problema.", "a": "No problem.", "d": ["That's the problem.", "There's a problem."], "ex": "Desculpa! Sem problema.", "exT": "Sorry! No problem."},
    {"c": "Tudo certo.", "a": "Everything's fine.", "d": ["Everything's wrong.", "Nothing's certain."]},
    {"c": "Fica à vontade.", "a": "Make yourself at home.", "d": ["Stay over there.", "Feel better soon."]},
    {"c": "Desculpa o atraso.", "a": "Sorry I'm late.", "d": ["Sorry for the mess.", "Sorry, I have to go."]},
    {"c": "Estou com pressa.", "a": "I'm in a hurry.", "d": ["I'm in pain.", "I'm bored."]},
    {"c": "Que horas a gente se encontra?", "a": "What time are we meeting?", "d": ["Where are we meeting?", "When did we meet?"]},
    {"c": "Parabéns!", "a": "Congratulations!", "d": ["Get well soon!", "Good luck!"], "ex": "Parabéns pelo novo emprego!", "exT": "Congratulations on the new job!"},
    {"c": "Feliz aniversário!", "a": "Happy birthday!", "d": ["Happy New Year!", "Merry Christmas!"]},
    {"c": "Boa sorte!", "a": "Good luck!", "d": ["Good night!", "Have fun!"]},
    {"c": "Boa viagem!", "a": "Have a good trip!", "d": ["Welcome back!", "Enjoy your meal!"], "ex": "Você vai para Recife amanhã? Boa viagem!", "exT": "You're going to Recife tomorrow? Have a good trip!"},
    {"c": "Foi um prazer.", "a": "It was a pleasure.", "d": ["It will be a pleasure.", "It's my turn."]},
    {"c": "Quanto tempo!", "a": "Long time no see!", "d": ["What great weather!", "Time's up!"], "ex": "Oi, Carla! Quanto tempo!", "exT": "Hi, Carla! Long time no see!"},
    {"c": "Eu te ligo amanhã.", "a": "I'll call you tomorrow.", "d": ["Call me tomorrow.", "I called you yesterday."]},
    {"c": "Me manda uma mensagem.", "a": "Send me a message.", "d": ["I sent you a message.", "Read my message."]},
    {"c": "Eu ___ de São Paulo, mas moro no Rio. (ser)", "a": "sou", "d": ["estou", "é"]},
    {"c": "Ontem a gente ___ ao cinema. (ir)", "a": "foi", "d": ["fomos", "vai"]},
    {"c": "Amanhã a gente ___ jantar fora. (ir)", "a": "vai", "d": ["vamos", "foi"]},
    {"c": "Prazer em ___ você. (conhecer)", "a": "conhecer", "d": ["conheço", "conheci"]},
    {"c": "Você ___ falar mais devagar? (poder)", "a": "pode", "d": ["posso", "podem"]},
    {"c": "Moro ___ minha tia. (with)", "a": "com", "d": ["de", "em"]}
  ]
}
