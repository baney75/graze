{
  "title": "People, pronouns and \"to be\"",
  "note": "Ser is for identity, origin, profession and lasting traits: Eu sou brasileiro. Estar is for where people are and how they feel now: Eu estou cansado. In Brazil, você (you) and a gente (we) use the same verb form as ele and ela: você é, a gente está.",
  "src": {"t": "Língua da Gente, Beginning 28: Who Is That Guy?", "u": "https://linguadagente.coerll.utexas.edu/beginning-who-is-that-guy/"},
  "items": [
    {"c": "eu", "a": "I", "d": ["you", "he"], "ex": "Eu sou o Pedro.", "exT": "I'm Pedro."},
    {"c": "você", "a": "you (one person)", "d": ["you (several people)", "we"], "ex": "Você é muito simpática.", "exT": "You are very nice."},
    {"c": "ele", "a": "he", "d": ["she", "they"], "ex": "Ele é meu irmão.", "exT": "He's my brother."},
    {"c": "ela", "a": "she", "d": ["he", "they"]},
    {"c": "nós", "a": "we", "d": ["they", "you (plural)"], "ex": "Nós somos amigos.", "exT": "We're friends."},
    {"c": "a gente", "a": "we (informal)", "d": ["they (informal)", "people over there"], "ex": "A gente mora no Rio.", "exT": "We live in Rio."},
    {"c": "vocês", "a": "you (plural)", "d": ["we", "they (feminine)"]},
    {"c": "eles", "a": "they (masculine or mixed)", "d": ["they (all feminine)", "we"]},
    {"c": "elas", "a": "they (all feminine)", "d": ["they (masculine or mixed)", "you (plural)"]},
    {"c": "o senhor", "a": "you (polite, to a man)", "d": ["the boy", "my friend"], "ex": "O senhor é o professor?", "exT": "Are you the teacher, sir?"},
    {"c": "a senhora", "a": "you (polite, to a woman)", "d": ["the girl", "my aunt"], "ex": "A senhora fala inglês?", "exT": "Do you speak English, ma'am?"},
    {"c": "o homem", "a": "the man", "d": ["the woman", "the boy"]},
    {"c": "a mulher", "a": "the woman", "d": ["the man", "the girl"]},
    {"c": "o menino", "a": "the boy", "d": ["the girl", "the man"]},
    {"c": "a menina", "a": "the girl", "d": ["the boy", "the woman"]},
    {"c": "o amigo", "a": "the friend (male)", "d": ["the neighbor (male)", "the cousin (male)"]},
    {"c": "a amiga", "a": "the friend (female)", "d": ["the friend (male)", "the aunt"]},
    {"c": "a pessoa", "a": "the person", "d": ["the people", "the city"]},
    {"c": "brasileiro", "a": "Brazilian (masculine)", "d": ["Brazilian (feminine)", "Portuguese (masculine)"], "ex": "O João é brasileiro.", "exT": "João is Brazilian."},
    {"c": "De onde você é?", "a": "Where are you from?", "d": ["Where are you now?", "Who are you?"]},
    {"c": "Sou dos Estados Unidos.", "a": "I'm from the United States.", "d": ["I'm in the United States.", "I'm going to the United States."]},
    {"c": "Quem é ele?", "a": "Who is he?", "d": ["Where is he?", "How is he?"], "ex": "Quem é ele? É o primo do Carlinhos.", "exT": "Who is he? He's Carlinhos's cousin."},
    {"c": "Este é o meu amigo João.", "a": "This is my friend João.", "d": ["João is at my friend's.", "My friend is called João?"]},
    {"c": "cansado", "a": "tired", "d": ["busy", "happy"], "ex": "Estou cansado hoje.", "exT": "I'm tired today."},
    {"c": "ocupado", "a": "busy", "d": ["tired", "ready"]},
    {"c": "aqui", "a": "here", "d": ["there", "now"], "ex": "Estou aqui!", "exT": "I'm here!"},
    {"c": "Eu ___ brasileiro. (ser)", "a": "sou", "d": ["é", "estou"]},
    {"c": "Você ___ professora? (ser)", "a": "é", "d": ["são", "sou"]},
    {"c": "Nós ___ amigos. (ser)", "a": "somos", "d": ["são", "estamos"]},
    {"c": "Eles ___ de São Paulo. (ser)", "a": "são", "d": ["é", "somos"]},
    {"c": "Eu ___ cansado hoje. (estar)", "a": "estou", "d": ["sou", "está"]},
    {"c": "Onde ___ as meninas? (estar)", "a": "estão", "d": ["está", "estamos"]},
    {"c": "A gente ___ aqui. (estar)", "a": "está", "d": ["estamos", "estão"], "ex": "A gente está aqui na praia.", "exT": "We're here at the beach."},
    {"c": "Nós ___ em casa. (estar)", "a": "estamos", "d": ["está", "estão"]}
  ]
}
