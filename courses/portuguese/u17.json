{
  "title": "The past tense: core forms",
  "note": "The preterite tells finished actions. Endings: -ar falei, falou, falamos, falaram; -er comi, comeu, comemos, comeram; -ir abri, abriu, abrimos, abriram. Ir and ser share forms: fui, foi, fomos, foram. Learn fazer (fiz, fez), ter (tive, teve), estar (estive, esteve). Spelling shifts before -ei: cheguei, fiquei, almocei.",
  "src": {"t": "Língua da Gente, Beginning 67: How Was Your Weekend?", "u": "https://linguadagente.coerll.utexas.edu/how-was-your-weekend/"},
  "items": [
    {"c": "ontem à noite", "a": "last night", "d": ["tonight", "tomorrow night"], "ex": "Ontem à noite eu fiquei em casa.", "exT": "Last night I stayed home."},
    {"c": "a semana passada", "a": "last week", "d": ["next week", "this week"], "ex": "A semana passada foi difícil.", "exT": "Last week was hard."},
    {"c": "o ano passado", "a": "last year", "d": ["next year", "this year"], "ex": "No ano passado, eu fui ao Brasil.", "exT": "Last year I went to Brazil."},
    {"c": "anteontem", "a": "the day before yesterday", "d": ["the day after tomorrow", "yesterday morning"]},
    {"c": "há dois dias", "a": "two days ago", "d": ["in two days", "every two days"], "ex": "Cheguei há dois dias.", "exT": "I arrived two days ago."},
    {"c": "Como foi o fim de semana?", "a": "How was the weekend?", "d": ["How's the weekend going?", "What will you do this weekend?"], "ex": "Como foi o fim de semana? Foi bom!", "exT": "How was the weekend? It was good!"},
    {"c": "Foi ótimo.", "a": "It was great.", "d": ["It's great.", "It will be great."], "ex": "Como foi o jantar? Foi ótimo.", "exT": "How was dinner? It was great."},
    {"c": "Você dormiu bem?", "a": "Did you sleep well?", "d": ["Are you sleeping well?", "Will you sleep well?"]},
    {"c": "O que vocês fizeram?", "a": "What did you all do?", "d": ["What are you all doing?", "What will you all do?"]},
    {"c": "Eu fui ao cinema.", "a": "I went to the movies.", "d": ["I'm going to the movies.", "I like the movies."], "ex": "Sábado eu fui ao cinema com a Ana.", "exT": "On Saturday I went to the movies with Ana."},
    {"c": "Eu fiquei em casa.", "a": "I stayed home.", "d": ["I'm staying home.", "I left home."], "ex": "Choveu, então eu fiquei em casa.", "exT": "It rained, so I stayed home."},
    {"c": "Choveu muito.", "a": "It rained a lot.", "d": ["It rains a lot.", "It's going to rain a lot."]},
    {"c": "Gostei!", "a": "I liked it!", "d": ["I'll like it!", "She liked it!"], "ex": "Você gostou do filme? Gostei!", "exT": "Did you like the movie? I did!"},
    {"c": "Já almocei.", "a": "I already had lunch.", "d": ["I'll have lunch soon.", "I'm having lunch now."]},
    {"c": "Eles chegaram tarde.", "a": "They arrived late.", "d": ["They arrive late.", "They'll arrive late."]},
    {"c": "Eu vi um filme.", "a": "I saw a movie.", "d": ["I'm seeing a movie.", "He saw a movie."]},
    {"c": "Ela comeu tudo.", "a": "She ate everything.", "d": ["She eats everything.", "I ate everything."]},
    {"c": "Ele disse que sim.", "a": "He said yes.", "d": ["He says yes.", "He said no."]},
    {"c": "Eu tive uma reunião.", "a": "I had a meeting.", "d": ["I have a meeting.", "I'll have a meeting."]},
    {"c": "Ele esteve aqui ontem.", "a": "He was here yesterday.", "d": ["He's here today.", "He'll be here tomorrow."]},
    {"c": "Ontem eu ___ muito. (trabalhar)", "a": "trabalhei", "d": ["trabalhou", "trabalho"], "ex": "Ontem eu trabalhei muito.", "exT": "Yesterday I worked a lot."},
    {"c": "Ontem ela ___ para o Rio. (viajar)", "a": "viajou", "d": ["viajei", "viajaram"]},
    {"c": "Eles ___ pizza ontem. (comer)", "a": "comeram", "d": ["comeu", "comemos"]},
    {"c": "Você ___ para ela? (escrever, past)", "a": "escreveu", "d": ["escrevi", "escreveram"]},
    {"c": "Eu ___ ao mercado ontem. (ir)", "a": "fui", "d": ["foi", "vou"], "ex": "Eu fui ao mercado ontem.", "exT": "I went to the market yesterday."},
    {"c": "Nós ___ ao Rio em 2020. (ir)", "a": "fomos", "d": ["foram", "vamos"]},
    {"c": "O que você ___ ontem? (fazer)", "a": "fez", "d": ["fiz", "faz"]},
    {"c": "Eu ___ uma ideia. (ter, past)", "a": "tive", "d": ["teve", "tenho"]},
    {"c": "A festa ___ ótima. (ser, past)", "a": "foi", "d": ["fui", "foram"]},
    {"c": "Eu ___ às oito. (chegar, past)", "a": "cheguei", "d": ["chegei", "chegou"]},
    {"c": "Vocês ___ o filme? (ver, past)", "a": "viram", "d": ["viu", "vimos"]},
    {"c": "Eu ___ a porta. (abrir, past)", "a": "abri", "d": ["abriu", "abro"]}
  ]
}
