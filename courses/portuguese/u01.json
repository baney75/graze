{
  "title": "Greetings and courtesy",
  "note": "Brazilians say oi or olá, then ask Tudo bem? (How's everything?). Bom dia is used until noon, boa tarde until dark, boa noite after dark. Some words change with the speaker: a man says obrigado, a woman says obrigada.",
  "src": {"t": "Língua da Gente, Beginning 02: Greetings", "u": "https://linguadagente.coerll.utexas.edu/greetings/"},
  "items": [
    {"c": "oi", "a": "hi", "d": ["bye", "please"], "ex": "Oi, Paulo!", "exT": "Hi, Paulo!"},
    {"c": "olá", "a": "hello", "d": ["goodbye", "thanks"]},
    {"c": "bom dia", "a": "good morning", "d": ["good afternoon", "good night"], "ex": "Bom dia, Dona Maria!", "exT": "Good morning, Mrs. Maria!"},
    {"c": "boa tarde", "a": "good afternoon", "d": ["good morning", "good night"]},
    {"c": "boa noite", "a": "good evening, good night", "d": ["good afternoon", "good morning"]},
    {"c": "tchau", "a": "bye", "d": ["hi", "thanks"], "ex": "Tchau, até amanhã!", "exT": "Bye, see you tomorrow!"},
    {"c": "até logo", "a": "see you later", "d": ["see you tomorrow", "good morning"], "ex": "Até logo, Ana!", "exT": "See you later, Ana!"},
    {"c": "até amanhã", "a": "see you tomorrow", "d": ["see you later", "good evening"]},
    {"c": "Tudo bem?", "a": "How's everything?", "d": ["What's your name?", "Where are you?"], "ex": "Tudo bem, Paulo? Tudo, e você?", "exT": "How's everything, Paulo? All good, and you?"},
    {"c": "Como vai?", "a": "How are you doing?", "d": ["Where are you going?", "What is it?"]},
    {"c": "Tudo ótimo.", "a": "Everything's great.", "d": ["Everything's bad.", "Nothing's new."]},
    {"c": "Estou bem.", "a": "I'm fine.", "d": ["I'm here.", "I'm tired."]},
    {"c": "obrigado", "a": "thank you (said by a man)", "d": ["you're welcome", "excuse me"], "ex": "Muito obrigado!", "exT": "Thank you very much!"},
    {"c": "obrigada", "a": "thank you (said by a woman)", "d": ["thank you (said by a man)", "you're welcome"]},
    {"c": "por favor", "a": "please", "d": ["thank you", "sorry"], "ex": "Um café, por favor.", "exT": "A coffee, please."},
    {"c": "de nada", "a": "you're welcome", "d": ["nice to meet you", "see you later"]},
    {"c": "com licença", "a": "excuse me (to pass or get attention)", "d": ["I'm sorry, my fault", "you're welcome"], "ex": "Com licença, onde é o banheiro?", "exT": "Excuse me, where is the bathroom?"},
    {"c": "desculpa", "a": "sorry", "d": ["please", "thanks"]},
    {"c": "prazer", "a": "nice to meet you", "d": ["see you soon", "good luck"], "ex": "Eu sou a Ana. Prazer!", "exT": "I'm Ana. Nice to meet you!"},
    {"c": "Como você se chama?", "a": "What's your name?", "d": ["How old are you?", "Where are you from?"]},
    {"c": "Meu nome é Ana.", "a": "My name is Ana.", "d": ["Ana is my friend.", "This is Ana's house."]},
    {"c": "Eu me chamo Pedro.", "a": "I'm called Pedro.", "d": ["I'm calling Pedro.", "I'm with Pedro."]},
    {"c": "sim", "a": "yes", "d": ["no", "maybe"]},
    {"c": "não", "a": "no, not", "d": ["yes", "also"]},
    {"c": "também", "a": "also, too", "d": ["only", "never"], "ex": "Eu também!", "exT": "Me too!"},
    {"c": "Que ótimo!", "a": "That's great!", "d": ["What a shame!", "How strange!"]},
    {"c": "Não entendo.", "a": "I don't understand.", "d": ["I don't know.", "I don't remember."]},
    {"c": "Não sei.", "a": "I don't know.", "d": ["I don't understand.", "I don't want to."]},
    {"c": "né?", "a": "right? (tag question)", "d": ["why?", "where?"], "ex": "Hoje está quente, né?", "exT": "It's hot today, right?"},
    {"c": "Bem-vindo!", "a": "Welcome!", "d": ["Goodbye!", "Congratulations!"]},
    {"c": "Bom dia, como ___? (how are you doing)", "a": "vai", "d": ["vou", "vamos"], "ex": "Bom dia, como vai?", "exT": "Good morning, how are you doing?"},
    {"c": "Ele diz: Muito ___! (thanks)", "a": "obrigado", "d": ["obrigada"]},
    {"c": "___ tarde! (good)", "a": "Boa", "d": ["Bom", "Bons"]},
    {"c": "___ dia! (good)", "a": "Bom", "d": ["Boa", "Boas"]},
    {"c": "Tudo bem, e ___? (you)", "a": "você", "d": ["eu", "ele"]}
  ]
}
