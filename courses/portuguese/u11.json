{
  "title": "Travel and transport",
  "note": "Use de for the means of transport: de ônibus, de carro, de avião, but a pé (on foot). Pegar means to catch or take: pegar o metrô. Brazilian words differ from Portugal's: ônibus (bus), trem (train), passagem (travel ticket).",
  "src": {"t": "Língua da Gente, Beginning 12: Let's Take The Subway", "u": "https://linguadagente.coerll.utexas.edu/beginning-lets-take-the-subway/"},
  "items": [
    {"c": "o ônibus", "a": "the bus", "d": ["the train", "the truck"], "ex": "O ônibus está atrasado.", "exT": "The bus is late."},
    {"c": "o carro", "a": "the car", "d": ["the bus", "the cart"], "ex": "O carro dele é novo.", "exT": "His car is new."},
    {"c": "o trem", "a": "the train", "d": ["the subway", "the bus"]},
    {"c": "o avião", "a": "the airplane", "d": ["the airport", "the helicopter"], "ex": "O avião sai às dez.", "exT": "The plane leaves at ten."},
    {"c": "o metrô", "a": "the subway", "d": ["the train", "the bus stop"], "ex": "Vamos pegar o metrô?", "exT": "Shall we take the subway?"},
    {"c": "a bicicleta", "a": "the bicycle", "d": ["the motorcycle", "the car"]},
    {"c": "o aeroporto", "a": "the airport", "d": ["the airplane", "the port"], "ex": "Vou de táxi para o aeroporto.", "exT": "I'm taking a taxi to the airport."},
    {"c": "a estação", "a": "the station", "d": ["the stop", "the airport"]},
    {"c": "a rodoviária", "a": "the bus terminal", "d": ["the highway", "the train station"]},
    {"c": "o ponto de ônibus", "a": "the bus stop", "d": ["the bus terminal", "the bus ticket"]},
    {"c": "a passagem", "a": "the travel ticket", "d": ["the passport", "the passenger"], "ex": "Quanto custa a passagem?", "exT": "How much is the ticket?"},
    {"c": "a mala", "a": "the suitcase", "d": ["the backpack", "the ticket"], "ex": "Minha mala é muito grande.", "exT": "My suitcase is very big."},
    {"c": "a viagem", "a": "the trip", "d": ["the traveler", "the road"]},
    {"c": "viajar", "a": "to travel", "d": ["to arrive", "to drive"], "ex": "Eu adoro viajar.", "exT": "I love to travel."},
    {"c": "chegar", "a": "to arrive", "d": ["to leave", "to travel"], "ex": "A que horas o trem chega?", "exT": "What time does the train arrive?"},
    {"c": "sair", "a": "to leave, go out", "d": ["to arrive", "to enter"]},
    {"c": "dirigir", "a": "to drive", "d": ["to ride", "to park"]},
    {"c": "pegar o ônibus", "a": "to take the bus", "d": ["to miss the bus", "to wait for the bus"]},
    {"c": "de carro", "a": "by car", "d": ["in front of the car", "for the car"]},
    {"c": "a pé", "a": "on foot", "d": ["by bike", "by car"], "ex": "Eu vou para a escola a pé.", "exT": "I walk to school."},
    {"c": "lotado", "a": "packed, full", "d": ["empty", "late"]},
    {"c": "atrasado", "a": "late", "d": ["early", "crowded"]},
    {"c": "A que horas sai o ônibus?", "a": "What time does the bus leave?", "d": ["What time does the bus arrive?", "Which bus goes there?"]},
    {"c": "uma passagem de ida e volta", "a": "a round-trip ticket", "d": ["a one-way ticket", "a return flight only"]},
