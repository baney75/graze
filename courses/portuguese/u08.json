{
  "title": "Everyday verbs in the present",
  "note": "Regular present endings: -ar falo, fala, falamos, falam; -er como, come, comemos, comem; -ir abro, abre, abrimos, abrem. Você, ele, ela and a gente share one form (fala); vocês, eles and elas share another (falam). Some common verbs are irregular: faço, vou, tenho, posso.",
  "src": {"t": "Língua da Gente, Beginning 24: What Are You Doing?", "u": "https://linguadagente.coerll.utexas.edu/beginning-what-are-you-doing/"},
  "items": [
    {"c": "falar", "a": "to speak", "d": ["to listen", "to read"], "ex": "Você fala inglês?", "exT": "Do you speak English?"},
    {"c": "trabalhar", "a": "to work", "d": ["to travel", "to study"], "ex": "Eu trabalho num banco.", "exT": "I work at a bank."},
    {"c": "estudar", "a": "to study", "d": ["to stay", "to work"]},
    {"c": "morar", "a": "to live (reside)", "d": ["to die", "to love"], "ex": "Eu moro em Curitiba.", "exT": "I live in Curitiba."},
    {"c": "comer", "a": "to eat", "d": ["to drink", "to cook"], "ex": "Vamos comer?", "exT": "Shall we eat?"},
    {"c": "beber", "a": "to drink", "d": ["to eat", "to buy"]},
    {"c": "escrever", "a": "to write", "d": ["to read", "to draw"]},
    {"c": "ler", "a": "to read", "d": ["to write", "to see"], "ex": "Eu leio o jornal de manhã.", "exT": "I read the newspaper in the morning."},
    {"c": "abrir", "a": "to open", "d": ["to close", "to leave"]},
    {"c": "fechar", "a": "to close", "d": ["to open", "to fix"]},
    {"c": "dormir", "a": "to sleep", "d": ["to wake up", "to dream"], "ex": "Eu durmo cedo.", "exT": "I go to bed early."},
    {"c": "acordar", "a": "to wake up", "d": ["to remember", "to sleep"]},
    {"c": "fazer", "a": "to do, to make", "d": ["to say", "to have"]},
    {"c": "ir", "a": "to go", "d": ["to come", "to see"], "ex": "Vou ao mercado.", "exT": "I'm going to the market."},
    {"c": "vir", "a": "to come", "d": ["to go", "to see"]},
    {"c": "ver", "a": "to see", "d": ["to come", "to hear"]},
    {"c": "ouvir", "a": "to hear, to listen", "d": ["to see", "to speak"]},
    {"c": "querer", "a": "to want", "d": ["to try", "to be able"]},
    {"c": "poder", "a": "to be able, can", "d": ["to want", "to need"]},
    {"c": "precisar de", "a": "to need", "d": ["to want", "to like"], "ex": "Preciso de ajuda.", "exT": "I need help."},
    {"c": "saber", "a": "to know (a fact, how to)", "d": ["to know (a person or place)", "to learn"]},
    {"c": "conhecer", "a": "to know (a person or place)", "d": ["to know (a fact)", "to remember"], "ex": "Você conhece o Rio?", "exT": "Do you know Rio?"},
    {"c": "entender", "a": "to understand", "d": ["to hear", "to explain"], "ex": "Você entende português?", "exT": "Do you understand Portuguese?"},
    {"c": "Eu ___ em São Paulo. (morar)", "a": "moro", "d": ["mora", "moram"]},
    {"c": "Ela ___ inglês. (falar)", "a": "fala", "d": ["falo", "falam"]},
    {"c": "Nós ___ muito. (trabalhar)", "a": "trabalhamos", "d": ["trabalha", "trabalham"]},
    {"c": "Eles ___ o jornal. (ler)", "a": "leem", "d": ["lê", "lemos"]},
    {"c": "Eu ___ o jantar. (fazer)", "a": "faço", "d": ["faz", "fazo"]},
    {"c": "Eu ___ para casa agora. (ir)", "a": "vou", "d": ["vai", "vamos"]},
    {"c": "Eu ___ oito horas. (dormir)", "a": "durmo", "d": ["dormo", "dorme"]},
    {"c": "Vocês ___ a janela? (abrir)", "a": "abrem", "d": ["abre", "abrimos"]},
    {"c": "Eu não ___ nadar. (saber)", "a": "sei", "d": ["sabo", "sabe"], "ex": "Eu não sei nadar.", "exT": "I don't know how to swim."},
    {"c": "O que vocês estão fazendo?", "a": "What are you all doing?", "d": ["What did you all do?", "What will you all do?"]}
  ]
