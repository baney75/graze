{
  "title": "Places in town and directions",
  "note": "离 (lí) states distance between two places: 学校离我家很近. 从 (cóng) marks a starting point, often with 到: 从这儿到机场. 往 (wǎng) means \"toward\": 往左拐 \"turn left\". Ask the way with Place + 怎么走？",
  "src": { "t": "Chinese Grammar Wiki: A2 grammar points (离, 从…到, 往)", "u": "https://resources.allsetlearning.com/chinese/grammar/A2_grammar_points" },
  "items": [
    { "c": "商店", "r": "shāngdiàn", "a": "store, shop", "d": ["bank", "hotel"] },
    { "c": "超市", "r": "chāoshì", "a": "supermarket", "d": ["restaurant", "post office"], "ex": "我去超市买水果。", "exT": "I'm going to the supermarket to buy fruit." },
    { "c": "银行", "r": "yínháng", "a": "bank", "d": ["hospital", "store"] },
    { "c": "医院", "r": "yīyuàn", "a": "hospital", "d": ["school", "pharmacy"] },
    { "c": "学校", "r": "xuéxiào", "a": "school", "d": ["library", "company"] },
    { "c": "公园", "r": "gōngyuán", "a": "park", "d": ["garden at home", "playground"] },
    { "c": "宾馆", "r": "bīnguǎn", "a": "hotel", "d": ["restaurant", "museum"] },
    { "c": "地方", "r": "dìfang", "a": "place", "d": ["road", "map"], "ex": "这个地方很漂亮。", "exT": "This place is beautiful." },
    { "c": "路", "r": "lù", "a": "road, street", "d": ["bridge", "door"] },
    { "c": "附近", "r": "fùjìn", "a": "nearby; vicinity", "d": ["far away", "downtown"], "ex": "附近有银行吗？", "exT": "Is there a bank nearby?" },
    { "c": "左边", "r": "zuǒbian", "a": "left side", "d": ["right side", "front side"] },
    { "c": "右边", "r": "yòubian", "a": "right side", "d": ["left side", "back side"] },
    { "c": "对面", "r": "duìmiàn", "a": "opposite, across from", "d": ["next to", "behind"] },
    { "c": "东", "r": "dōng", "a": "east", "d": ["west", "north"] },
    { "c": "西", "r": "xī", "a": "west", "d": ["east", "south"] },
    { "c": "南", "r": "nán", "a": "south", "d": ["north", "west"] },
    { "c": "北", "r": "běi", "a": "north", "d": ["south", "east"] },
    { "c": "走", "r": "zǒu", "a": "to walk; to go, leave", "d": ["to run", "to drive"], "ex": "我们走吧。", "exT": "Let's go." },
    { "c": "到", "r": "dào", "a": "to arrive, reach; to", "d": ["to leave, depart; from", "to pass, cross; over"] },
    { "c": "远", "r": "yuǎn", "a": "far", "d": ["near", "long"] },
    { "c": "近", "r": "jìn", "a": "near, close", "d": ["far", "short"] },
    { "c": "离", "r": "lí", "a": "away from (in distance)", "d": ["toward", "until"] },
    { "c": "从", "r": "cóng", "a": "from (a starting point)", "d": ["to (a destination)", "toward"] },
    { "c": "往", "r": "wǎng", "a": "toward, in the direction of", "d": ["away from", "starting from"] },
    { "c": "一直", "r": "yīzhí", "a": "straight on; continuously", "d": ["suddenly; once", "nearby; almost"] },
    { "c": "往左拐", "r": "wǎng zuǒ guǎi", "a": "turn left", "d": ["turn right", "go straight"] },
    { "c": "一直往前走。", "r": "Yīzhí wǎng qián zǒu.", "a": "Go straight ahead.", "d": ["Turn around and go back.", "Walk slowly."] },
    { "c": "请问，银行在哪儿？", "r": "Qǐngwèn, yínháng zài nǎr?", "a": "Excuse me, where is the bank?", "d": ["Excuse me, is the bank open?", "Excuse me, is the bank far?"] },
    { "c": "医院离这儿很近。", "r": "Yīyuàn lí zhèr hěn jìn.", "a": "The hospital is close to here.", "d": ["The hospital is far from here.", "Leave the hospital from here."] },
    { "c": "学校___我家很近。", "r": "Xuéxiào ___ wǒ jiā hěn jìn.", "a": "离", "d": ["从", "在"], "ex": "学校离我家很近。", "exT": "The school is close to my home." },
    { "c": "___这儿到机场要一个小时。", "r": "___ zhèr dào jīchǎng yào yī gè xiǎoshí.", "a": "从", "d": ["离", "往"] },
    { "c": "请问，火车站怎么___？", "r": "Qǐngwèn, huǒchēzhàn zěnme ___?", "a": "走", "d": ["是", "有"] },
    { "c": "一直___前走。", "r": "Yīzhí ___ qián zǒu.", "a": "往", "d": ["离", "从"] },
    { "c": "银行在超市___。(opposite)", "r": "Yínháng zài chāoshì ___.", "a": "对面", "d": ["旁边", "后面"] }
