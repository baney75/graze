{
  "title": "Greetings and courtesy",
  "note": "Add 吗 (ma) to the end of a statement to make a yes-no question: 你好 → 你好吗？ Use 呢 (ne) to bounce a question back: 你呢？ \"And you?\" Adjectives usually take 很 (hěn) in plain statements: 我很好.",
  "src": { "t": "Chinese Grammar Wiki: yes-no questions with 吗", "u": "https://resources.allsetlearning.com/chinese/grammar/ASGQ2AZA" },
  "items": [
    { "c": "你好", "r": "nǐ hǎo", "a": "hello", "d": ["goodbye", "thank you"], "ex": "你好，王老师！", "exT": "Hello, Teacher Wang!" },
    { "c": "您好", "r": "nín hǎo", "a": "hello (polite)", "d": ["good night (polite)", "welcome (polite)"], "ex": "您好，请进。", "exT": "Hello, please come in." },
    { "c": "你好吗？", "r": "Nǐ hǎo ma?", "a": "How are you?", "d": ["Where are you?", "Who are you?"] },
    { "c": "我很好。", "r": "Wǒ hěn hǎo.", "a": "I'm well.", "d": ["I'm busy.", "I'm sorry."] },
    { "c": "你呢？", "r": "Nǐ ne?", "a": "And you?", "d": ["Are you?", "Who, you?"], "ex": "我很好，你呢？", "exT": "I'm well, and you?" },
    { "c": "我也很好。", "r": "Wǒ yě hěn hǎo.", "a": "I'm well too.", "d": ["I'm not well.", "I'm very busy."] },
    { "c": "谢谢", "r": "xièxie", "a": "thank you", "d": ["you're welcome", "sorry"], "ex": "谢谢你！", "exT": "Thank you!" },
    { "c": "不客气", "r": "bù kèqi", "a": "you're welcome", "d": ["thank you", "it doesn't matter"], "ex": "谢谢！——不客气。", "exT": "Thanks! — You're welcome." },
    { "c": "对不起", "r": "duìbuqǐ", "a": "I'm sorry", "d": ["excuse me, may I ask", "no problem"], "ex": "对不起，我来晚了。", "exT": "Sorry, I'm late." },
    { "c": "没关系", "r": "méi guānxi", "a": "it doesn't matter", "d": ["you're welcome", "I'm sorry"], "ex": "对不起！——没关系。", "exT": "Sorry! — That's okay." },
    { "c": "不好意思", "r": "bù hǎoyìsi", "a": "sorry to trouble you; excuse me", "d": ["nice to meet you", "long time no see"] },
    { "c": "再见", "r": "zàijiàn", "a": "goodbye", "d": ["hello", "welcome"] },
    { "c": "明天见", "r": "míngtiān jiàn", "a": "see you tomorrow", "d": ["see you later today", "see you next week"] },
    { "c": "早上好", "r": "zǎoshang hǎo", "a": "good morning", "d": ["good evening", "good afternoon"] },
    { "c": "晚上好", "r": "wǎnshang hǎo", "a": "good evening", "d": ["good morning", "good night"] },
    { "c": "晚安", "r": "wǎn'ān", "a": "good night", "d": ["good morning", "good evening"] },
    { "c": "欢迎", "r": "huānyíng", "a": "welcome", "d": ["goodbye", "please"], "ex": "欢迎你来北京！", "exT": "Welcome to Beijing!" },
    { "c": "好久不见", "r": "hǎojiǔ bù jiàn", "a": "long time no see", "d": ["see you soon", "nice to meet you"] },
    { "c": "请", "r": "qǐng", "a": "please", "d": ["thanks", "sorry"], "ex": "请喝茶。", "exT": "Please have some tea." },
    { "c": "请进", "r": "qǐng jìn", "a": "please come in", "d": ["please sit down", "please wait"] },
    { "c": "请坐", "r": "qǐng zuò", "a": "please sit down", "d": ["please come in", "please speak"] },
    { "c": "请问", "r": "qǐngwèn", "a": "excuse me, may I ask", "d": ["sorry to be late", "please repeat"], "ex": "请问，你是李老师吗？", "exT": "Excuse me, are you Teacher Li?" },
    { "c": "喂", "r": "wèi", "a": "hello (on the phone)", "d": ["goodbye (on the phone)", "sorry (on the phone)"] },
    { "c": "你叫什么名字？", "r": "Nǐ jiào shénme míngzi?", "a": "What's your name?", "d": ["Where are you from?", "How old are you?"] },
