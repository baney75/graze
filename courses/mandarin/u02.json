    { "c": "我很好，你___？", "r": "Wǒ hěn hǎo, nǐ ___?", "a": "呢", "d": ["吗", "是"] },
    { "c": "我___好。(I am well.)", "r": "Wǒ ___ hǎo.", "a": "很", "d": ["是", "有"], "ex": "我很好。", "exT": "I'm well." },
    { "c": "我___王明。(My name is...)", "r": "Wǒ ___ Wáng Míng.", "a": "叫", "d": ["有", "在"] }
  ]
