    { "c": "我去___长城。(have been)", "r": "Wǒ qù ___ Chángchéng.", "a": "过", "d": ["着", "在"] },
    { "c": "他___走了。(already)", "r": "Tā ___ zǒu le.", "a": "已经", "d": ["正在", "还没"] },
