    { "c": "有点儿", "r": "yǒudiǎnr", "a": "a bit, slightly (before an adjective)", "d": ["very much", "not at all"] },
    { "c": "我头疼。", "r": "Wǒ tóu téng.", "a": "I have a headache.", "d": ["My head is hot.", "My hand hurts."] },
