    { "c": "你有哥哥___？", "r": "Nǐ yǒu gēge ___?", "a": "吗", "d": ["的", "也"] },
    { "c": "这是我妈妈___书。", "r": "Zhè shì wǒ māma ___ shū.", "a": "的", "d": ["有", "是"] }
  ]
