{
  "title": "Family and 有",
  "note": "有 (yǒu) means \"to have\" or \"there is\". Its only negative is 没有 (méiyǒu), never 不有. Family members count with 口 or 个: 我家有四口人. With close relations 的 is usually dropped: 我妈妈 \"my mom\", 我家 \"my family\".",
  "src": { "t": "Chinese Grammar Wiki: expressing possession with 有", "u": "https://resources.allsetlearning.com/chinese/grammar/ASGOOCVO" },
  "items": [
    { "c": "家", "r": "jiā", "a": "home; family", "d": ["room; house", "school; class"], "ex": "我家在北京。", "exT": "My home is in Beijing." },
    { "c": "爸爸", "r": "bàba", "a": "dad", "d": ["mom", "grandpa"], "ex": "我爸爸是医生。", "exT": "My dad is a doctor." },
    { "c": "妈妈", "r": "māma", "a": "mother, mom", "d": ["grandma", "older sister"] },
    { "c": "哥哥", "r": "gēge", "a": "older brother", "d": ["younger brother", "older sister"] },
    { "c": "姐姐", "r": "jiějie", "a": "older sister", "d": ["younger sister", "older brother"] },
    { "c": "弟弟", "r": "dìdi", "a": "younger brother", "d": ["older brother", "younger sister"] },
    { "c": "妹妹", "r": "mèimei", "a": "younger sister", "d": ["older sister", "younger brother"] },
    { "c": "兄弟姐妹", "r": "xiōngdì jiěmèi", "a": "brothers and sisters, siblings", "d": ["parents and children", "grandparents"] },
    { "c": "儿子", "r": "érzi", "a": "son", "d": ["daughter", "husband"], "ex": "他们有一个儿子。", "exT": "They have a son." },
    { "c": "女儿", "r": "nǚ'ér", "a": "daughter", "d": ["son", "wife"] },
    { "c": "孩子", "r": "háizi", "a": "child", "d": ["parent", "student"] },
    { "c": "丈夫", "r": "zhàngfu", "a": "husband", "d": ["wife", "son"] },
    { "c": "妻子", "r": "qīzi", "a": "wife", "d": ["husband", "daughter"] },
    { "c": "爷爷", "r": "yéye", "a": "grandpa (father's father)", "d": ["grandma (father's mother)", "uncle (father's brother)"] },
    { "c": "奶奶", "r": "nǎinai", "a": "grandma (father's mother)", "d": ["grandpa (father's father)", "aunt (mother's sister)"] },
    { "c": "狗", "r": "gǒu", "a": "dog", "d": ["cat", "fish"], "ex": "我家有一只狗。", "exT": "My family has a dog." },
    { "c": "猫", "r": "māo", "a": "cat", "d": ["dog", "horse"] },
    { "c": "口", "r": "kǒu", "a": "measure word for family members", "d": ["measure word for animals", "measure word for books"] },
    { "c": "有", "r": "yǒu", "a": "to have; there is", "d": ["to be (is, am)", "to be at (a place)"] },
    { "c": "没有", "r": "méiyǒu", "a": "to not have; there isn't", "d": ["to not be", "to not want"], "ex": "我没有弟弟。", "exT": "I don't have a younger brother." },
    { "c": "和", "r": "hé", "a": "and (between nouns)", "d": ["also (before verbs)", "or (in questions)"], "ex": "爸爸和妈妈", "exT": "Dad and Mom" },
    { "c": "爱", "r": "ài", "a": "to love", "d": ["to know", "to marry"], "ex": "我爱我的家。", "exT": "I love my family." },
    { "c": "你家有几口人？", "r": "Nǐ jiā yǒu jǐ kǒu rén?", "a": "How many people are in your family?", "d": ["Where is your home?", "How many rooms does your home have?"] },
    { "c": "我家有四口人。", "r": "Wǒ jiā yǒu sì kǒu rén.", "a": "There are four people in my family.", "d": ["My home has four rooms.", "Four people visited my home."] },
    { "c": "我没有姐姐。", "r": "Wǒ méiyǒu jiějie.", "a": "I don't have an older sister.", "d": ["My older sister isn't here.", "I'm not an older sister."] },
    { "c": "我___两个哥哥。", "r": "Wǒ ___ liǎng gè gēge.", "a": "有", "d": ["是", "在"], "ex": "我有两个哥哥。", "exT": "I have two older brothers." },
    { "c": "我___有妹妹。(negative)", "r": "Wǒ ___ yǒu mèimei.", "a": "没", "d": ["不", "别"] },
    { "c": "我家有五___人。", "r": "Wǒ jiā yǒu wǔ ___ rén.", "a": "口", "d": ["本", "只"] },
