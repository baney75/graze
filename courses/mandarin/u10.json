{
  "title": "Home and where things are",
  "note": "Thing + 在 + place says where something is: 书在桌子上. Place + 有 + thing says what is there: 桌子上有一本书. Location words follow the noun: 桌子上 \"on the table\", 房间里 \"in the room\", 床下面 \"under the bed\".",
  "src": { "t": "Chinese Grammar Wiki: expressing existence in a place with 在", "u": "https://resources.allsetlearning.com/chinese/grammar/ASGLRWT8" },
  "items": [
    { "c": "房间", "r": "fángjiān", "a": "room", "d": ["house", "floor"], "ex": "我的房间不大。", "exT": "My room isn't big." },
    { "c": "门", "r": "mén", "a": "door", "d": ["window", "wall"] },
    { "c": "窗户", "r": "chuānghu", "a": "window", "d": ["door", "curtain"] },
    { "c": "桌子", "r": "zhuōzi", "a": "table, desk", "d": ["chair", "bed"] },
    { "c": "椅子", "r": "yǐzi", "a": "chair", "d": ["table", "sofa"] },
    { "c": "床", "r": "chuáng", "a": "bed", "d": ["chair", "door"] },
    { "c": "电视", "r": "diànshì", "a": "television", "d": ["computer", "telephone"] },
    { "c": "电脑", "r": "diànnǎo", "a": "computer", "d": ["television", "camera"] },
    { "c": "手机", "r": "shǒujī", "a": "cell phone", "d": ["watch", "computer"], "ex": "我的手机在哪儿？", "exT": "Where's my phone?" },
    { "c": "书", "r": "shū", "a": "book", "d": ["newspaper", "pen"] },
    { "c": "杯子", "r": "bēizi", "a": "cup, glass", "d": ["bowl", "plate"] },
    { "c": "东西", "r": "dōngxi", "a": "thing, stuff", "d": ["gift, present", "place"], "ex": "你买什么东西？", "exT": "What are you buying?" },
    { "c": "厨房", "r": "chúfáng", "a": "kitchen", "d": ["bedroom", "restroom"] },
    { "c": "洗手间", "r": "xǐshǒujiān", "a": "restroom", "d": ["kitchen", "laundry room"], "ex": "请问，洗手间在哪儿？", "exT": "Excuse me, where is the restroom?" },
    { "c": "在", "r": "zài", "a": "to be at, be in (a place)", "d": ["to have", "to go to"] },
    { "c": "这儿", "r": "zhèr", "a": "here", "d": ["there", "where"] },
    { "c": "那儿", "r": "nàr", "a": "there", "d": ["here", "where"] },
    { "c": "哪儿", "r": "nǎr", "a": "where", "d": ["there", "which"] },
    { "c": "桌子上", "r": "zhuōzi shang", "a": "on the table", "d": ["under the table", "next to the table"] },
    { "c": "房间里", "r": "fángjiān li", "a": "in the room", "d": ["outside the room", "behind the room"] },
    { "c": "前面", "r": "qiánmiàn", "a": "in front", "d": ["behind", "inside"] },
    { "c": "后面", "r": "hòumiàn", "a": "behind, at the back", "d": ["in front", "beside"] },
    { "c": "旁边", "r": "pángbiān", "a": "beside, next to", "d": ["opposite, across from", "between"], "ex": "椅子在桌子旁边。", "exT": "The chair is next to the table." },
    { "c": "开", "r": "kāi", "a": "to open; to turn on", "d": ["to close; to turn off", "to wash; to clean"] },
    { "c": "关", "r": "guān", "a": "to close; to turn off", "d": ["to open; to turn on", "to lock; to stop"] },
    { "c": "洗", "r": "xǐ", "a": "to wash", "d": ["to cook", "to dry"] },
    { "c": "桌子上有一本书。", "r": "Zhuōzi shang yǒu yī běn shū.", "a": "There's a book on the table.", "d": ["The book is under the table.", "I have a book and a table."] },
    { "c": "猫在床下面。", "r": "Māo zài chuáng xiàmiàn.", "a": "The cat is under the bed.", "d": ["The cat is on the bed.", "There's a bed under the cat."] },
    { "c": "我的手机___桌子上。", "r": "Wǒ de shǒujī ___ zhuōzi shang.", "a": "在", "d": ["有", "是"], "ex": "我的手机在桌子上。", "exT": "My phone is on the table." },
    { "c": "桌子上___一本书。", "r": "Zhuōzi shang ___ yī běn shū.", "a": "有", "d": ["在", "的"] },
    { "c": "你的电脑在___？", "r": "Nǐ de diànnǎo zài ___?", "a": "哪儿", "d": ["什么", "谁"] },
    { "c": "猫在床___。(under)", "r": "Māo zài chuáng ___.", "a": "下面", "d": ["上面", "里面"] },
    { "c": "请___门。(open)", "r": "Qǐng ___ mén.", "a": "开", "d": ["关", "洗"] }
  ]
}
