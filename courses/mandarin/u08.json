{
  "title": "Colors and describing things",
  "note": "Adjectives act as verbs, so do not add 是: 他很高 \"He is tall.\" In plain statements 很 is a near-default link and often just means \"is\". Use 太…了 for \"too\": 太贵了. Put 的 between a longer description and its noun: 很漂亮的衣服.",
  "src": { "t": "Chinese Grammar Wiki: simple noun + adjective sentences", "u": "https://resources.allsetlearning.com/chinese/grammar/ASG17BLH" },
  "items": [
    { "c": "大", "r": "dà", "a": "big", "d": ["small", "many"], "ex": "你的房间很大。", "exT": "Your room is big." },
    { "c": "小", "r": "xiǎo", "a": "small", "d": ["big", "few"] },
    { "c": "多", "r": "duō", "a": "many, much", "d": ["few, little", "big, large"], "ex": "这里人很多。", "exT": "There are lots of people here." },
    { "c": "少", "r": "shǎo", "a": "few, little", "d": ["many, much", "small, short"] },
    { "c": "好", "r": "hǎo", "a": "good", "d": ["bad", "busy"] },
    { "c": "新", "r": "xīn", "a": "new", "d": ["old (of things)", "clean"] },
    { "c": "旧", "r": "jiù", "a": "old, used (of things)", "d": ["new", "old (of people)"] },
    { "c": "老", "r": "lǎo", "a": "old (of people)", "d": ["young", "tired"] },
    { "c": "长", "r": "cháng", "a": "long", "d": ["short (in length)", "tall"] },
    { "c": "短", "r": "duǎn", "a": "short (in length)", "d": ["short (in height)", "long"] },
    { "c": "高", "r": "gāo", "a": "tall, high", "d": ["short (in height)", "long"] },
    { "c": "矮", "r": "ǎi", "a": "short (in height)", "d": ["tall, high", "short (in length)"] },
    { "c": "漂亮", "r": "piàoliang", "a": "pretty, beautiful", "d": ["clean, tidy", "expensive"], "ex": "你的衣服真漂亮！", "exT": "Your clothes are really pretty!" },
    { "c": "好看", "r": "hǎokàn", "a": "good-looking, nice to look at", "d": ["easy to see", "tasty"] },
    { "c": "贵", "r": "guì", "a": "expensive", "d": ["cheap", "heavy"] },
    { "c": "便宜", "r": "piányi", "a": "cheap", "d": ["expensive", "convenient"] },
    { "c": "快", "r": "kuài", "a": "fast", "d": ["slow", "early"] },
    { "c": "慢", "r": "màn", "a": "slow", "d": ["fast", "late"] },
    { "c": "难", "r": "nán", "a": "difficult", "d": ["easy", "interesting"], "ex": "汉字不太难。", "exT": "Chinese characters aren't too hard." },
    { "c": "容易", "r": "róngyì", "a": "easy", "d": ["difficult", "important"] },
    { "c": "颜色", "r": "yánsè", "a": "color", "d": ["size", "shape"] },
    { "c": "红", "r": "hóng", "a": "red", "d": ["yellow", "black"], "ex": "我喜欢红色。", "exT": "I like red." },
    { "c": "白", "r": "bái", "a": "white", "d": ["black", "blue"] },
    { "c": "黑", "r": "hēi", "a": "black", "d": ["white", "green"] },
    { "c": "蓝", "r": "lán", "a": "blue", "d": ["green", "red"] },
    { "c": "绿", "r": "lǜ", "a": "green", "d": ["blue", "yellow"] },
    { "c": "黄", "r": "huáng", "a": "yellow", "d": ["red", "white"] },
    { "c": "非常", "r": "fēicháng", "a": "extremely", "d": ["not very", "a little"], "ex": "今天非常热。", "exT": "It's extremely hot today." },
    { "c": "真", "r": "zhēn", "a": "really, truly", "d": ["almost", "never"] },
    { "c": "最", "r": "zuì", "a": "most (the -est)", "d": ["more (-er)", "too"], "ex": "他是我们班最高的。", "exT": "He's the tallest in our class." },
    { "c": "你的手机是什么颜色的？", "r": "Nǐ de shǒujī shì shénme yánsè de?", "a": "What color is your phone?", "d": ["How much is your phone?", "Where is your phone?"] },
    { "c": "他___高。(He is tall.)", "r": "Tā ___ gāo.", "a": "很", "d": ["是", "有"] },
    { "c": "这本书___贵了！(too)", "r": "Zhè běn shū ___ guì le!", "a": "太", "d": ["非常", "都"], "ex": "这本书太贵了！", "exT": "This book is too expensive!" },
    { "c": "一件很漂亮___衣服", "r": "yī jiàn hěn piàoliang ___ yīfu", "a": "的", "d": ["了", "是"] },
    { "c": "这个苹果___大。(not very)", "r": "Zhège píngguǒ ___ dà.", "a": "不太", "d": ["没太", "太没"] }
  ]
}
