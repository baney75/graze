{
  "title": "Question words, connectors and frequency",
  "note": "Question words stay where the answer would go: 你去哪儿？ → 我去北京. No word-order change and no 吗. 还是 means \"or\" in questions; 或者 means \"or\" in statements. 因为…所以… and 虽然…但是… are used as pairs.",
  "src": { "t": "Chinese Grammar Wiki: placement of question words", "u": "https://resources.allsetlearning.com/chinese/grammar/ASGJQPSC" },
  "items": [
    { "c": "什么", "r": "shénme", "a": "what", "d": ["who", "how"], "ex": "你在看什么？", "exT": "What are you reading?" },
    { "c": "为什么", "r": "wèishénme", "a": "why", "d": ["what kind of", "how many"] },
    { "c": "怎么", "r": "zěnme", "a": "how", "d": ["why not", "where"], "ex": "这个字怎么写？", "exT": "How do you write this character?" },
    { "c": "怎么样", "r": "zěnmeyàng", "a": "how is it; how about", "d": ["how many", "what for"], "ex": "我们去公园，怎么样？", "exT": "Let's go to the park, how about it?" },
    { "c": "哪", "r": "nǎ", "a": "which", "d": ["that", "where"] },
    { "c": "哪个", "r": "nǎge", "a": "which one", "d": ["that one", "this one"] },
    { "c": "多长时间", "r": "duō cháng shíjiān", "a": "how long (a length of time)", "d": ["what time (of day)", "how often"] },
    { "c": "因为", "r": "yīnwèi", "a": "because", "d": ["so, therefore", "although"] },
    { "c": "所以", "r": "suǒyǐ", "a": "so, therefore", "d": ["because", "but"] },
    { "c": "但是", "r": "dànshì", "a": "but", "d": ["so", "or"] },
    { "c": "虽然", "r": "suīrán", "a": "although", "d": ["because", "if"] },
    { "c": "还是", "r": "háishi", "a": "or (in questions); still", "d": ["and (between nouns)", "or (in statements only)"] },
    { "c": "或者", "r": "huòzhě", "a": "or (in statements)", "d": ["or (in questions)", "and also"] },
    { "c": "然后", "r": "ránhòu", "a": "then, afterward", "d": ["before that", "suddenly"], "ex": "我先吃饭，然后去学校。", "exT": "I'll eat first, then go to school." },
    { "c": "如果", "r": "rúguǒ", "a": "if", "d": ["although", "unless"] },
    { "c": "常常", "r": "chángcháng", "a": "often", "d": ["never", "rarely"], "ex": "我常常去图书馆。", "exT": "I often go to the library." },
    { "c": "每天", "r": "měitiān", "a": "every day", "d": ["every week", "some days"] },
    { "c": "有时候", "r": "yǒushíhou", "a": "sometimes", "d": ["always", "never"] },
    { "c": "总是", "r": "zǒngshì", "a": "always", "d": ["sometimes", "often not"] },
    { "c": "从来不", "r": "cónglái bù", "a": "never (as a habit)", "d": ["always (as a habit)", "not anymore"], "ex": "他从来不喝咖啡。", "exT": "He never drinks coffee." },
    { "c": "再", "r": "zài", "a": "again (in the future)", "d": ["again (already happened)", "still"], "ex": "请再说一遍。", "exT": "Please say it again." },
    { "c": "还", "r": "hái", "a": "still; also, in addition", "d": ["again; once more", "already; no longer"] },
    { "c": "也", "r": "yě", "a": "also, too", "d": ["all, both", "only"] },
    { "c": "都", "r": "dōu", "a": "all, both", "d": ["also, too", "every day"] },
    { "c": "就", "r": "jiù", "a": "right away; then (as a result)", "d": ["only just; barely", "still; yet"] },
    { "c": "他今天没来，___他生病了。", "r": "Tā jīntiān méi lái, ___ tā shēngbìng le.", "a": "因为", "d": ["所以", "但是"] },
    { "c": "我很累，___我想休息。", "r": "Wǒ hěn lèi, ___ wǒ xiǎng xiūxi.", "a": "所以", "d": ["因为", "虽然"], "ex": "我很累，所以我想休息。", "exT": "I'm tired, so I want to rest." },
    { "c": "___很贵，但是我很喜欢。", "r": "___ hěn guì, dànshì wǒ hěn xǐhuan.", "a": "虽然", "d": ["因为", "所以"] },
    { "c": "星期六___星期天都可以。", "r": "Xīngqīliù ___ xīngqītiān dōu kěyǐ.", "a": "或者", "d": ["还是", "但是"] },
    { "c": "你___不喜欢他？(why)", "r": "Nǐ ___ bù xǐhuan tā?", "a": "为什么", "d": ["什么", "哪儿"] },
    { "c": "这个汉字___写？(how)", "r": "Zhège Hànzì ___ xiě?", "a": "怎么", "d": ["什么", "怎么样"] },
    { "c": "你___去北京？(when)", "r": "Nǐ ___ qù Běijīng?", "a": "什么时候", "d": ["什么", "几"] },
    { "c": "我明天___来。(again)", "r": "Wǒ míngtiān ___ lái.", "a": "再", "d": ["都", "最"] }
  ]
}
