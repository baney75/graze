    { "c": "你怎么去学校？", "r": "Nǐ zěnme qù xuéxiào?", "a": "How do you get to school?", "d": ["When do you go to school?", "Why do you go to school?"] },
    { "c": "我坐飞机去上海。", "r": "Wǒ zuò fēijī qù Shànghǎi.", "a": "I'm flying to Shanghai.", "d": ["I'm taking the train to Shanghai.", "I'm flying from Shanghai."] },
    { "c": "我骑自行车上班。", "r": "Wǒ qí zìxíngchē shàngbān.", "a": "I ride a bike to work.", "d": ["I take the bus to work.", "I fix bikes at work."] },
    { "c": "我___地铁去公司。", "r": "Wǒ ___ dìtiě qù gōngsī.", "a": "坐", "d": ["骑", "开"], "ex": "我坐地铁去公司。", "exT": "I take the subway to the office." },
    { "c": "他___自行车去学校。", "r": "Tā ___ zìxíngchē qù xuéxiào.", "a": "骑", "d": ["坐", "开"] },
