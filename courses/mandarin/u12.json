    { "c": "地铁", "r": "dìtiě", "a": "subway", "d": ["train", "bridge"] },
    { "c": "自行车", "r": "zìxíngchē", "a": "bicycle", "d": ["motorcycle", "car"] },
    { "c": "车", "r": "chē", "a": "car; vehicle", "d": ["road; street", "ticket; pass"] },
    { "c": "站", "r": "zhàn", "a": "station, stop", "d": ["road", "ticket"] },
    { "c": "开车", "r": "kāichē", "a": "to drive (a car)", "d": ["to ride a bike", "to take a taxi"], "ex": "我爸爸开车去上班。", "exT": "My dad drives to work." },
    { "c": "坐", "r": "zuò", "a": "to sit; to take (a vehicle)", "d": ["to ride (a bike); to straddle", "to drive; to open"] },
    { "c": "骑", "r": "qí", "a": "to ride (a bike, a horse)", "d": ["to drive (a car)", "to take (a bus)"] },
    { "c": "上车", "r": "shàngchē", "a": "to get on (a vehicle)", "d": ["to get off (a vehicle)", "to buy a car"] },
    { "c": "下车", "r": "xiàchē", "a": "to get off (a vehicle)", "d": ["to get on (a vehicle)", "to park a car"] },
    { "c": "票", "r": "piào", "a": "ticket", "d": ["passport", "map"] },
    { "c": "张", "r": "zhāng", "a": "measure word for flat things (tickets, paper)", "d": ["measure word for vehicles", "measure word for animals"], "ex": "我要两张票。", "exT": "I'd like two tickets." },
    { "c": "旅游", "r": "lǚyóu", "a": "to travel (for fun); tourism", "d": ["to move house", "to go to work"] },
    { "c": "护照", "r": "hùzhào", "a": "passport", "d": ["ticket", "visa"] },
    { "c": "行李", "r": "xíngli", "a": "luggage", "d": ["passport", "map"] },
    { "c": "出发", "r": "chūfā", "a": "to set off, depart", "d": ["to arrive", "to return"], "ex": "我们八点出发。", "exT": "We set off at eight." },
