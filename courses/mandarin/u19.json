{
  "title": "Plans, wants and abilities",
  "note": "想 = would like to; 要 = want to, going to; 会 = know how to, or likely will; 能 = able to (circumstances allow); 可以 = may, allowed to. All go right before the verb. 快要…了 means \"about to\": 快要下雨了. 别 or 不要 + verb means \"don't\".",
  "src": { "t": "Chinese Grammar Wiki: comparing 要 and 想", "u": "https://resources.allsetlearning.com/chinese/grammar/ASGD88UO" },
  "items": [
    { "c": "想", "r": "xiǎng", "a": "would like to; to think; to miss", "d": ["must; to need", "can; to be able"], "ex": "我很想你。", "exT": "I miss you a lot." },
    { "c": "要", "r": "yào", "a": "to want; to be going to; to need", "d": ["to be able to", "to be allowed to"] },
    { "c": "能", "r": "néng", "a": "can, be able to", "d": ["would like to", "should"], "ex": "你能帮我吗？", "exT": "Can you help me?" },
    { "c": "打算", "r": "dǎsuàn", "a": "to plan, intend", "d": ["to remember", "to agree"] },
    { "c": "希望", "r": "xīwàng", "a": "to hope; hope", "d": ["to worry; worry", "to wait; delay"], "ex": "我希望明天天气好。", "exT": "I hope the weather is good tomorrow." },
    { "c": "应该", "r": "yīnggāi", "a": "should, ought to", "d": ["might, may", "would like to"] },
    { "c": "得", "r": "děi", "a": "must, have to", "d": ["may, can", "will probably"] },
    { "c": "一定", "r": "yīdìng", "a": "definitely, certainly", "d": ["maybe, possibly", "never"] },
    { "c": "可能", "r": "kěnéng", "a": "maybe, possibly", "d": ["definitely", "never"] },
    { "c": "别", "r": "bié", "a": "don't (do something)", "d": ["didn't (do something)", "won't be able to"] },
    { "c": "帮", "r": "bāng", "a": "to help", "d": ["to ask", "to send"] },
    { "c": "后天", "r": "hòutiān", "a": "the day after tomorrow", "d": ["the day before yesterday", "next week"] },
    { "c": "下个星期", "r": "xià ge xīngqī", "a": "next week", "d": ["last week", "this weekend"] },
    { "c": "下个月", "r": "xià ge yuè", "a": "next month", "d": ["last month", "this month"] },
    { "c": "将来", "r": "jiānglái", "a": "the future; in the future", "d": ["the past; in the past", "nowadays; recently"] },
    { "c": "放假", "r": "fàngjià", "a": "to have a holiday, be off", "d": ["to work overtime", "to start school"], "ex": "我们下个月放假。", "exT": "We're off next month." },
    { "c": "我想去中国学习汉语。", "r": "Wǒ xiǎng qù Zhōngguó xuéxí Hànyǔ.", "a": "I'd like to go to China to study Chinese.", "d": ["I studied Chinese in China.", "I think Chinese is easy to study."] },
    { "c": "你周末打算做什么？", "r": "Nǐ zhōumò dǎsuàn zuò shénme?", "a": "What are you planning to do this weekend?", "d": ["What did you do last weekend?", "Are you free this weekend?"] },
    { "c": "我明天不能来。", "r": "Wǒ míngtiān bù néng lái.", "a": "I can't come tomorrow.", "d": ["I don't want to come tomorrow.", "I didn't come yesterday."] },
    { "c": "我可以进来吗？", "r": "Wǒ kěyǐ jìnlái ma?", "a": "May I come in?", "d": ["Can you come in?", "Should I go out?"] },
    { "c": "明天会下雨。", "r": "Míngtiān huì xiàyǔ.", "a": "It will probably rain tomorrow.", "d": ["It rained yesterday.", "It's raining now."] },
    { "c": "快要下雨了。", "r": "Kuàiyào xiàyǔ le.", "a": "It's about to rain.", "d": ["It just stopped raining.", "It rains a lot here."] },
    { "c": "别说话！", "r": "Bié shuōhuà!", "a": "Don't talk!", "d": ["Speak louder!", "Didn't you speak?"] },
    { "c": "我明天有课，不___去。(can't)", "r": "Wǒ míngtiān yǒu kè, bù ___ qù.", "a": "能", "d": ["会", "是"], "ex": "我明天有课，不能去。", "exT": "I have class tomorrow, so I can't go." },
    { "c": "明天___下雨。(will probably)", "r": "Míngtiān ___ xiàyǔ.", "a": "会", "d": ["能", "想"] },
    { "c": "我___用你的电脑吗？(may)", "r": "Wǒ ___ yòng nǐ de diànnǎo ma?", "a": "可以", "d": ["会", "是"] },
    { "c": "火车快___开了。(about to)", "r": "Huǒchē kuài ___ kāi le.", "a": "要", "d": ["会", "想"] },
    { "c": "___说话！(don't)", "r": "___ shuōhuà!", "a": "别", "d": ["没", "也"] },
    { "c": "你___多休息。(should)", "r": "Nǐ ___ duō xiūxi.", "a": "应该", "d": ["可能", "会"] },
    { "c": "我___去中国。(would like to)", "r": "Wǒ ___ qù Zhōngguó.", "a": "想", "d": ["会", "能"] }
  ]
}
