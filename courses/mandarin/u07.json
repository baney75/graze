{
  "title": "Days, dates and telling time",
  "note": "Time words come before the verb, either right after the subject or at the very start: 我明天去北京 or 明天我去北京, never 我去北京明天. Dates run from big to small: 2026年10月9号. Weekdays are 星期 + number, except Sunday, 星期天.",
  "src": { "t": "Chinese Grammar Wiki: time words and word order", "u": "https://resources.allsetlearning.com/chinese/grammar/ASG5RWKO" },
  "items": [
    { "c": "今天", "r": "jīntiān", "a": "today", "d": ["tomorrow", "yesterday"] },
    { "c": "明天", "r": "míngtiān", "a": "tomorrow", "d": ["today", "yesterday"], "ex": "明天见！", "exT": "See you tomorrow!" },
    { "c": "昨天", "r": "zuótiān", "a": "yesterday", "d": ["tomorrow", "the day after tomorrow"] },
    { "c": "星期", "r": "xīngqī", "a": "week", "d": ["month", "weekend"] },
    { "c": "星期一", "r": "xīngqīyī", "a": "Monday", "d": ["Sunday", "January"] },
    { "c": "星期三", "r": "xīngqīsān", "a": "Wednesday", "d": ["Tuesday", "Thursday"] },
    { "c": "星期五", "r": "xīngqīwǔ", "a": "Friday", "d": ["Thursday", "Saturday"] },
    { "c": "星期六", "r": "xīngqīliù", "a": "Saturday", "d": ["Sunday", "Friday"] },
    { "c": "星期天", "r": "xīngqītiān", "a": "Sunday", "d": ["Monday", "Saturday"], "ex": "星期天我在家。", "exT": "I'm at home on Sunday." },
    { "c": "周末", "r": "zhōumò", "a": "weekend", "d": ["weekday", "holiday"] },
    { "c": "月", "r": "yuè", "a": "month; moon", "d": ["year; age", "day; sun"] },
    { "c": "一月", "r": "yīyuè", "a": "January", "d": ["one month", "Monday"] },
    { "c": "十二月", "r": "shí'èryuè", "a": "December", "d": ["twelve months", "October"] },
    { "c": "号", "r": "hào", "a": "day of the month (in dates); number", "d": ["day of the week", "hour"], "ex": "我的生日是五月三号。", "exT": "My birthday is May 3." },
    { "c": "年", "r": "nián", "a": "year", "d": ["month", "age"] },
    { "c": "今年", "r": "jīnnián", "a": "this year", "d": ["last year", "next year"] },
    { "c": "明年", "r": "míngnián", "a": "next year", "d": ["this year", "last year"] },
    { "c": "生日", "r": "shēngrì", "a": "birthday", "d": ["holiday", "weekend"], "ex": "生日快乐！", "exT": "Happy birthday!" },
    { "c": "现在", "r": "xiànzài", "a": "now", "d": ["later", "just now"] },
    { "c": "点", "r": "diǎn", "a": "o'clock", "d": ["minute", "half past"] },
    { "c": "半", "r": "bàn", "a": "half", "d": ["quarter", "whole"] },
    { "c": "小时", "r": "xiǎoshí", "a": "hour (length of time)", "d": ["minute (length of time)", "o'clock"], "ex": "我每天学习两个小时。", "exT": "I study for two hours every day." },
    { "c": "分钟", "r": "fēnzhōng", "a": "minute (length of time)", "d": ["hour (length of time)", "second"] },
    { "c": "早上", "r": "zǎoshang", "a": "early morning", "d": ["evening", "noon"] },
    { "c": "上午", "r": "shàngwǔ", "a": "morning (before noon)", "d": ["afternoon", "night"] },
    { "c": "中午", "r": "zhōngwǔ", "a": "noon", "d": ["midnight", "afternoon"] },
    { "c": "下午", "r": "xiàwǔ", "a": "afternoon", "d": ["morning (before noon)", "evening"] },
    { "c": "晚上", "r": "wǎnshang", "a": "evening, night", "d": ["early morning", "noon"] },
    { "c": "什么时候", "r": "shénme shíhou", "a": "when", "d": ["how long", "what time is it"], "ex": "你什么时候回家？", "exT": "When are you going home?" },
    { "c": "现在几点？", "r": "Xiànzài jǐ diǎn?", "a": "What time is it now?", "d": ["How long does it take?", "What day is it today?"] },
    { "c": "三点半", "r": "sān diǎn bàn", "a": "3:30", "d": ["3:15", "half of three"] },
    { "c": "今天几月几号？", "r": "Jīntiān jǐ yuè jǐ hào?", "a": "What's the date today?", "d": ["What day of the week is it?", "What time is it?"] },
    { "c": "今天星期几？", "r": "Jīntiān xīngqī jǐ?", "a": "What day of the week is it today?", "d": ["What's the date today?", "How many weeks are left?"] },
    { "c": "我去学校八点。", "r": "Wǒ qù xuéxiào bā diǎn.", "a": "Wrong: the time must come before the verb", "d": ["Correct as written", "Wrong: the time must come first in the sentence"], "ex": "我八点去学校。", "exT": "I go to school at eight." },
    { "c": "现在___点？", "r": "Xiànzài ___ diǎn?", "a": "几", "d": ["多少", "什么"] },
    { "c": "两点___ (2:30)", "r": "liǎng diǎn ___", "a": "半", "d": ["分", "号"] }
  ]
}
