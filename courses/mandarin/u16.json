{
  "title": "Weather, seasons and comparisons",
  "note": "A 比 B + adjective means \"A is more … than B\": 今天比昨天冷. Never add 很 or 非常 in a 比 sentence; use 更 for \"even more\". A 没有 B + adjective means \"A is not as … as B\". A 跟 B 一样 + adjective means \"A is as … as B\".",
  "src": { "t": "Chinese Grammar Wiki: basic comparisons with 比", "u": "https://resources.allsetlearning.com/chinese/grammar/ASG8SI2K" },
  "items": [
    { "c": "天气", "r": "tiānqì", "a": "weather", "d": ["season", "sky"], "ex": "今天天气很好。", "exT": "The weather is nice today." },
    { "c": "冷", "r": "lěng", "a": "cold", "d": ["hot", "cool"] },
    { "c": "热", "r": "rè", "a": "hot", "d": ["cold", "warm"], "ex": "夏天很热。", "exT": "Summer is hot." },
    { "c": "暖和", "r": "nuǎnhuo", "a": "warm, pleasantly mild", "d": ["cool, refreshing", "hot, scorching"] },
    { "c": "凉快", "r": "liángkuai", "a": "pleasantly cool", "d": ["pleasantly warm", "freezing cold"] },
    { "c": "雨", "r": "yǔ", "a": "rain", "d": ["snow", "wind"] },
    { "c": "雪", "r": "xuě", "a": "snow", "d": ["rain", "ice"] },
    { "c": "风", "r": "fēng", "a": "wind", "d": ["cloud", "rain"] },
    { "c": "下雨", "r": "xiàyǔ", "a": "to rain", "d": ["to snow", "to be windy"] },
    { "c": "下雪", "r": "xiàxuě", "a": "to snow", "d": ["to rain", "to be cloudy"] },
    { "c": "晴", "r": "qíng", "a": "sunny, clear", "d": ["overcast", "rainy"] },
    { "c": "阴", "r": "yīn", "a": "overcast, cloudy", "d": ["sunny, clear", "snowy"] },
    { "c": "太阳", "r": "tàiyáng", "a": "sun", "d": ["moon", "star"] },
    { "c": "春天", "r": "chūntiān", "a": "spring", "d": ["summer", "autumn"] },
    { "c": "夏天", "r": "xiàtiān", "a": "summer", "d": ["spring", "winter"] },
    { "c": "秋天", "r": "qiūtiān", "a": "autumn, fall", "d": ["summer", "winter"] },
    { "c": "冬天", "r": "dōngtiān", "a": "winter", "d": ["autumn, fall", "spring"], "ex": "北京的冬天很冷。", "exT": "Winter in Beijing is cold." },
    { "c": "度", "r": "dù", "a": "degree (of temperature)", "d": ["percent", "meter"] },
    { "c": "山", "r": "shān", "a": "mountain", "d": ["river", "sea"] },
    { "c": "河", "r": "hé", "a": "river", "d": ["mountain", "lake"] },
    { "c": "树", "r": "shù", "a": "tree", "d": ["flower", "grass"] },
    { "c": "花", "r": "huā", "a": "flower", "d": ["tree", "leaf"] },
    { "c": "比", "r": "bǐ", "a": "than (in comparisons)", "d": ["as (in 'as tall as')", "very"] },
    { "c": "更", "r": "gèng", "a": "even more", "d": ["most", "less"] },
    { "c": "一样", "r": "yīyàng", "a": "the same", "d": ["different", "similar but not equal"] },
    { "c": "今天比昨天冷。", "r": "Jīntiān bǐ zuótiān lěng.", "a": "Today is colder than yesterday.", "d": ["Yesterday was colder than today.", "Today is as cold as yesterday."] },
    { "c": "北京没有上海热。", "r": "Běijīng méiyǒu Shànghǎi rè.", "a": "Beijing isn't as hot as Shanghai.", "d": ["Beijing is hotter than Shanghai.", "Shanghai isn't as hot as Beijing."] },
    { "c": "下雨了！", "r": "Xiàyǔ le!", "a": "It's started raining!", "d": ["It stopped raining!", "It will rain tomorrow!"] },
    { "c": "今天多少度？", "r": "Jīntiān duōshao dù?", "a": "What's the temperature today?", "d": ["What's the weather like today?", "What's the date today?"] },
    { "c": "今天___昨天热。", "r": "Jīntiān ___ zuótiān rè.", "a": "比", "d": ["跟", "和"], "ex": "今天比昨天热。", "exT": "Today is hotter than yesterday." },
    { "c": "他比我___。(taller)", "r": "Tā bǐ wǒ ___.", "a": "高", "d": ["很高", "非常高"] },
    { "c": "今天比昨天___热。(even)", "r": "Jīntiān bǐ zuótiān ___ rè.", "a": "更", "d": ["很", "太"] },
    { "c": "北京___上海热。(not as)", "r": "Běijīng ___ Shànghǎi rè.", "a": "没有", "d": ["不是", "不有"] },
    { "c": "我跟你___高。(same)", "r": "Wǒ gēn nǐ ___ gāo.", "a": "一样", "d": ["比", "很"] },
    { "c": "冬天来___。(has arrived)", "r": "Dōngtiān lái ___.", "a": "了", "d": ["的", "吗"] }
  ]
}
