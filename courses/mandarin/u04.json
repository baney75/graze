{
  "title": "Numbers, age and measure words",
  "note": "Between a number (or 这/那) and a noun, Mandarin needs a measure word: 一个人, 三本书, 两杯茶. 个 is the all-purpose one. Before a measure word, \"two\" is 两 (liǎng), not 二: 两个人. Age uses 岁 with no verb needed: 我二十岁.",
  "src": { "t": "Chinese Grammar Wiki: measure words for counting", "u": "https://resources.allsetlearning.com/chinese/grammar/ASG64BTE" },
  "items": [
    { "c": "零", "r": "líng", "a": "zero", "d": ["ten", "one"] },
    { "c": "二", "r": "èr", "a": "two", "d": ["three", "eight"] },
    { "c": "三", "r": "sān", "a": "three", "d": ["two", "four"] },
    { "c": "四", "r": "sì", "a": "four", "d": ["ten", "six"] },
    { "c": "五", "r": "wǔ", "a": "five", "d": ["six", "nine"] },
    { "c": "六", "r": "liù", "a": "six", "d": ["seven", "four"] },
    { "c": "七", "r": "qī", "a": "seven", "d": ["one", "eight"] },
    { "c": "八", "r": "bā", "a": "eight", "d": ["six", "nine"] },
    { "c": "九", "r": "jiǔ", "a": "nine", "d": ["seven", "five"] },
    { "c": "十", "r": "shí", "a": "ten", "d": ["four", "one hundred"] },
    { "c": "十五", "r": "shíwǔ", "a": "fifteen", "d": ["fifty", "five hundred"] },
    { "c": "二十", "r": "èrshí", "a": "twenty", "d": ["twelve", "two hundred"], "ex": "二十 = 2 × 10; 十二 = 10 + 2", "exT": "twenty is two tens; twelve is ten plus two" },
    { "c": "九十九", "r": "jiǔshíjiǔ", "a": "ninety-nine", "d": ["nine hundred nine", "nineteen"] },
    { "c": "一百", "r": "yībǎi", "a": "one hundred", "d": ["one thousand", "ten"] },
    { "c": "一千", "r": "yīqiān", "a": "one thousand", "d": ["one hundred", "ten thousand"] },
    { "c": "两", "r": "liǎng", "a": "two (before a measure word)", "d": ["second (in order)", "a pair (of shoes)"], "ex": "我有两个哥哥。", "exT": "I have two older brothers." },
    { "c": "第一", "r": "dìyī", "a": "first", "d": ["once", "number one hundred"] },
    { "c": "几", "r": "jǐ", "a": "how many (usually under ten)", "d": ["how much money", "which one"], "ex": "你有几个孩子？", "exT": "How many children do you have?" },
    { "c": "多少", "r": "duōshao", "a": "how many, how much", "d": ["very many", "a little"], "ex": "你们学校有多少学生？", "exT": "How many students does your school have?" },
    { "c": "岁", "r": "suì", "a": "years old", "d": ["year (on a calendar)", "birthday"] },
    { "c": "我二十岁。", "r": "Wǒ èrshí suì.", "a": "I'm twenty years old.", "d": ["I have twenty friends.", "I was born in 2000."] },
    { "c": "你多大？", "r": "Nǐ duō dà?", "a": "How old are you?", "d": ["How tall are you?", "How big is your home?"] },
    { "c": "个", "r": "gè", "a": "general measure word (people, many things)", "d": ["measure word for books", "measure word for cups of drink"], "ex": "一个人", "exT": "one person" },
    { "c": "本", "r": "běn", "a": "measure word for books", "d": ["measure word for animals", "measure word for clothes"], "ex": "三本书", "exT": "three books" },
    { "c": "杯", "r": "bēi", "a": "a cup or glass of (drinks)", "d": ["a bowl of (food)", "a bottle of (drinks)"], "ex": "一杯茶", "exT": "a cup of tea" },
    { "c": "只", "r": "zhī", "a": "measure word for many animals (cats, birds)", "d": ["measure word for flat things", "measure word for people"], "ex": "两只猫", "exT": "two cats" },
    { "c": "三个学生", "r": "sān gè xuésheng", "a": "three students", "d": ["the third student", "thirty students"] },
    { "c": "我有___个苹果。(2)", "r": "Wǒ yǒu ___ gè píngguǒ.", "a": "两", "d": ["二", "双"], "ex": "我有两个苹果。", "exT": "I have two apples." },
    { "c": "一___人", "r": "yī ___ rén", "a": "个", "d": ["本", "杯"] },
