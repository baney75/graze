{
  "title": "Question words, connectors and frequency",
  "note": "Czy at the start turns a statement into a yes/no question: Czy masz czas? Polish uses double negatives: nigdy nie, nic nie, nikt nie (Nigdy nie piję kawy = I never drink coffee). i joins things (kawa i herbata); a joins with a contrast (Ja piję kawę, a on herbatę); ale means but.",
  "src": {"t": "Oscar E. Swan, Polish-English Dictionary (University of Pittsburgh)", "u": "https://lektorek.org/polish/"},
  "items": [
    {"c": "zawsze", "a": "always", "d": ["never", "often"], "ex": "Zawsze piję kawę rano.", "exT": "I always drink coffee in the morning."},
    {"c": "nigdy", "a": "never", "d": ["always", "rarely"], "ex": "Nigdy nie jem mięsa.", "exT": "I never eat meat."},
    {"c": "często", "a": "often", "d": ["rarely", "always"]},
    {"c": "czasami", "a": "sometimes", "d": ["often", "never"]},
    {"c": "rzadko", "a": "rarely", "d": ["often", "usually"]},
    {"c": "zwykle", "a": "usually", "d": ["rarely", "never"]},
    {"c": "codziennie", "a": "every day", "d": ["every week", "once"]},
    {"c": "kto", "a": "who", "d": ["what", "which"]},
    {"c": "co", "a": "what", "d": ["who", "how"]},
    {"c": "kiedy", "a": "when", "d": ["where", "why"], "ex": "Kiedy masz urodziny?", "exT": "When is your birthday?"},
    {"c": "dlaczego", "a": "why", "d": ["when", "how"], "ex": "Dlaczego nie jesz?", "exT": "Why aren't you eating?"},
    {"c": "jak", "a": "how", "d": ["what", "why"]},
    {"c": "który", "a": "which", "d": ["who", "whose"]},
    {"c": "skąd", "a": "from where", "d": ["where to", "since when"]},
    {"c": "dokąd", "a": "where to", "d": ["from where", "how far"], "ex": "Dokąd idziesz?", "exT": "Where are you going?"},
    {"c": "czy", "a": "question word for yes/no questions; whether", "d": ["question word meaning why", "question word meaning which"]},
    {"c": "i", "a": "and (adding)", "d": ["or", "but"]},
    {"c": "a", "a": "and, whereas (contrast)", "d": ["or", "because"]},
    {"c": "ale", "a": "but", "d": ["and", "so"]},
    {"c": "albo", "a": "or", "d": ["and", "but"]},
    {"c": "bo", "a": "because", "d": ["so", "but"], "ex": "Nie idę, bo jestem chory.", "exT": "I'm not going because I'm sick."},
    {"c": "więc", "a": "so, therefore", "d": ["because", "but"]},
    {"c": "że", "a": "that (as in: I know that…)", "d": ["which", "if"]},
    {"c": "też", "a": "also, too", "d": ["only", "still"]},
    {"c": "tylko", "a": "only", "d": ["also", "already"]},
    {"c": "już", "a": "already", "d": ["still", "only"]},
    {"c": "jeszcze", "a": "still; yet", "d": ["already", "never"]},
    {"c": "nic", "a": "nothing", "d": ["nobody", "never"]},
    {"c": "nikt", "a": "nobody", "d": ["nothing", "everyone"]},
    {"c": "Nigdy ___ piję wina.", "a": "nie", "d": ["tak", "nic"], "ex": "Nigdy nie piję wina.", "exT": "I never drink wine."},
    {"c": "Ona ___ nie je. (nothing)", "a": "nic", "d": ["nikt", "nigdy"], "ex": "Ona nic nie je.", "exT": "She isn't eating anything."},
    {"c": "___ masz czas? (yes/no question)", "a": "Czy", "d": ["Co", "Kto"], "ex": "Czy masz czas?", "exT": "Do you have time?"},
    {"c": "On jest wysoki, ___ ona jest niska.", "a": "a", "d": ["bo", "więc"], "ex": "On jest wysoki, a ona jest niska.", "exT": "He is tall, and she is short."}
  ]
}
