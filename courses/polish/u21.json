{
  "title": "Essential conversation sentences",
  "note": "When you call or address someone directly, use the vocative case: mama → mamo!, tata → tato!, Anna → Anno!, Marek → Marku!, pan → panie (Panie Marku). Pani does not change. Polite requests use Czy może pan / pani …? (Could you …?) or Proszę + infinitive (Proszę usiąść = Please sit down).",
  "src": {"t": "Polish grammar: vocative case, Wikipedia", "u": "https://en.wikipedia.org/wiki/Polish_grammar"},
  "items": [
    {"c": "___, gdzie jesteś? (mama)", "a": "Mamo", "d": ["Mama", "Mamę"], "ex": "Mamo, gdzie jesteś?", "exT": "Mom, where are you?"},
    {"c": "Dzień dobry, panie ___! (Marek)", "a": "Marku", "d": ["Marek", "Marka"], "ex": "Dzień dobry, panie Marku!", "exT": "Good morning, Mr. Marek!"},
    {"c": "___, chodź tutaj! (tata)", "a": "Tato", "d": ["Tata", "Tatę"], "ex": "Tato, chodź tutaj!", "exT": "Dad, come here!"},
    {"c": "Dziękuję, ___ Anno! (pani)", "a": "pani", "d": ["panią", "panie"], "ex": "Dziękuję, pani Anno!", "exT": "Thank you, Ms. Anna!"},
    {"c": "Mówię trochę po polsku.", "a": "I speak a little Polish.", "d": ["I don't speak Polish.", "I'm learning Polish."]},
    {"c": "Proszę mówić wolniej.", "a": "Please speak more slowly.", "d": ["Please speak louder.", "Please say it again."]},
    {"c": "Czy może pan powtórzyć?", "a": "Could you repeat that, sir?", "d": ["Could you help me, sir?", "Could you write it down, sir?"]},
    {"c": "Jak to się mówi po polsku?", "a": "How do you say that in Polish?", "d": ["Do you speak Polish?", "How do you spell that in Polish?"]},
    {"c": "Co to znaczy?", "a": "What does that mean?", "d": ["What is that?", "What happened?"], "ex": "Przepraszam, co to znaczy „szkoda”?", "exT": "Excuse me, what does \"szkoda\" mean?"},
    {"c": "Nie wiem.", "a": "I don't know.", "d": ["I don't understand.", "I don't want to."]},
    {"c": "Mam pytanie.", "a": "I have a question.", "d": ["I have a problem.", "I have an idea."]},
    {"c": "Nie ma problemu.", "a": "No problem.", "d": ["There's a problem.", "No idea."]},
    {"c": "Oczywiście!", "a": "Of course!", "d": ["Maybe!", "Never!"]},
    {"c": "Może.", "a": "Maybe.", "d": ["Of course.", "Never."]},
    {"c": "Naprawdę?", "a": "Really?", "d": ["Already?", "Again?"]},
    {"c": "Jasne!", "a": "Sure!", "d": ["Too bad!", "Careful!"]},
    {"c": "Wszystko w porządku?", "a": "Is everything OK?", "d": ["Is everything ready?", "Is that all?"]},
    {"c": "Nie szkodzi.", "a": "That's OK, no harm done.", "d": ["What a pity.", "It's not allowed."], "ex": "Przepraszam! – Nie szkodzi.", "exT": "Sorry! – That's OK."},
    {"c": "Zaraz wracam.", "a": "I'll be right back.", "d": ["I'm going home now.", "I came back yesterday."]},
    {"c": "Do jutra!", "a": "See you tomorrow!", "d": ["Until today!", "See you next week!"]},
    {"c": "Proszę usiąść.", "a": "Please sit down.", "d": ["Please come in.", "Please wait."]},
    {"c": "Proszę wejść.", "a": "Please come in.", "d": ["Please sit down.", "Please go out."]},
    {"c": "Pomocy!", "a": "Help!", "d": ["Hurry up!", "Stop!"]},
    {"c": "Zgubiłem się.", "a": "I'm lost. (man speaking)", "d": ["I lost my key. (man speaking)", "I'm late. (man speaking)"]},
    {"c": "Powodzenia!", "a": "Good luck!", "d": ["Congratulations!", "Bon voyage!"]},
    {"c": "Gratulacje!", "a": "Congratulations!", "d": ["Good luck!", "Thank you!"]},
    {"c": "Wszystkiego najlepszego!", "a": "All the best! (birthdays, holidays)", "d": ["Good luck on the exam!", "Get well soon!"]},
    {"c": "Czekam na ciebie.", "a": "I'm waiting for you.", "d": ["I'm looking for you.", "I'm thinking about you."]}
  ],
  "read": {"title": "W kawiarni", "text": ["Tom jest Amerykaninem i uczy się polskiego. Dzisiaj jest w kawiarni w Krakowie. Kelnerka pyta: Dzień dobry! Co dla pana?", "Tom mówi: Dzień dobry. Poproszę kawę z mlekiem i… przepraszam, jak to się mówi po polsku? Ciasto z jabłkami? Kelnerka: Szarlotka! Tom: Tak, szarlotkę, proszę.", "Kelnerka mówi bardzo szybko. Tom mówi: Przepraszam, mówię tylko trochę po polsku. Proszę mówić wolniej. Kelnerka mówi wolniej: Dwadzieścia osiem złotych. Czy płaci pan kartą? Tom: Tak, kartą. Dziękuję! Kelnerka: Nie ma za co. Smacznego!"], "q": [{"q": "What does Tom order?", "o": ["Tea and a sandwich", "Coffee with milk and apple cake", "Juice and soup"], "k": 1}, {"q": "What does Tom ask the waitress to do?", "o": ["Speak more slowly", "Bring the bill", "Repeat the price in English"], "k": 0}, {"q": "How does Tom pay?", "o": ["In cash", "By card", "He doesn't pay"], "k": 1}]}
}
