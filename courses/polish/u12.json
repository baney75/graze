{
  "title": "Body and health",
  "note": "Pain uses boleć with the body part as the subject: Boli mnie głowa (my head hurts, literally \"the head hurts me\"). With a plural body part use bolą: Bolą mnie nogi. mnie is the accusative of ja. To say how you feel, use czuć się: Czuję się dobrze.",
  "src": {"t": "Oscar E. Swan, Polish-English Dictionary (University of Pittsburgh)", "u": "https://lektorek.org/polish/"},
  "items": [
    {"c": "głowa (f)", "a": "head", "d": ["neck", "face"], "say": "głowa"},
    {"c": "ręka (f)", "a": "hand; arm", "d": ["leg; foot", "finger"], "ex": "Daj mi rękę.", "exT": "Give me your hand.", "say": "ręka"},
    {"c": "noga (f)", "a": "leg; foot", "d": ["hand; arm", "knee"], "say": "noga"},
    {"c": "oko (n)", "a": "eye", "d": ["ear", "nose"], "ex": "Ona ma niebieskie oczy.", "exT": "She has blue eyes.", "say": "oko"},
    {"c": "ucho (n)", "a": "ear", "d": ["eye", "cheek"], "say": "ucho"},
    {"c": "nos (m)", "a": "nose", "d": ["mouth", "chin"], "say": "nos"},
    {"c": "usta (pl)", "a": "mouth, lips", "d": ["teeth", "throat"], "say": "usta"},
    {"c": "ząb (m)", "a": "tooth", "d": ["tongue", "bone"], "say": "ząb"},
    {"c": "brzuch (m)", "a": "belly, stomach", "d": ["back", "chest"], "say": "brzuch"},
    {"c": "plecy (pl)", "a": "back (of the body)", "d": ["shoulders", "belly"], "say": "plecy"},
    {"c": "serce (n)", "a": "heart", "d": ["lungs", "stomach"], "say": "serce"},
    {"c": "włosy (pl)", "a": "hair", "d": ["skin", "eyebrows"], "say": "włosy"},
    {"c": "twarz (f)", "a": "face", "d": ["head", "neck"], "say": "twarz"},
    {"c": "gardło (n)", "a": "throat", "d": ["neck", "mouth"], "say": "gardło"},
    {"c": "palec (m)", "a": "finger; toe", "d": ["hand", "nail"], "say": "palec"},
    {"c": "lekarz (m)", "a": "doctor", "d": ["nurse", "pharmacist"], "ex": "Muszę iść do lekarza.", "exT": "I have to go to the doctor.", "say": "lekarz"},
    {"c": "zdrowy", "a": "healthy", "d": ["sick", "tired"]},
    {"c": "chory", "a": "sick, ill", "d": ["healthy", "hungry"], "ex": "Mój syn jest chory.", "exT": "My son is sick."},
    {"c": "lekarstwo (n)", "a": "medicine (a remedy)", "d": ["prescription", "doctor's office"], "say": "lekarstwo"},
    {"c": "zdrowie (n)", "a": "health", "d": ["illness", "body"], "say": "zdrowie"},
    {"c": "Boli mnie ___. (głowa)", "a": "głowa", "d": ["głowę", "głowy"], "ex": "Boli mnie głowa.", "exT": "I have a headache."},
    {"c": "___ mnie nogi. (boleć)", "a": "Bolą", "d": ["Boli", "Bolę"], "ex": "Bolą mnie nogi.", "exT": "My legs hurt."},
    {"c": "Co cię boli?", "a": "What hurts? (to a friend)", "d": ["Who are you?", "What are you doing?"]},
    {"c": "Jak się ___? (czuć, ty)", "a": "czujesz", "d": ["czuję", "czuje"], "ex": "Jak się czujesz?", "exT": "How do you feel?"},
    {"c": "Czuję się dobrze.", "a": "I feel fine.", "d": ["I feel sick.", "I look good."]},
    {"c": "Jestem chory.", "a": "I'm sick. (man speaking)", "d": ["I'm tired. (man speaking)", "I'm healthy. (man speaking)"]},
    {"c": "Mam katar.", "a": "I have a runny nose.", "d": ["I have a sore throat.", "I have a fever."]},
    {"c": "Muszę iść do apteki.", "a": "I have to go to the pharmacy.", "d": ["I work at a pharmacy.", "The pharmacy is closed."]}
