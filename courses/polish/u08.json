{
  "title": "Everyday verbs in the present tense",
  "note": "Three main present-tense patterns: -am, -asz, -a … -ają (czytać: czytam, czytasz, czyta, czytamy, czytacie, czytają); -ę, -esz, -e … -ą (pisać: piszę, piszesz, pisze … piszą; pracować: pracuję); -ę, -isz/-ysz, -i/-y … -ą (mówić: mówię, mówisz, mówi … mówią). Learn mieć (mam, masz) and wiedzieć (wiem, wiesz) separately.",
  "src": {"t": "Oscar E. Swan, Polish-English Dictionary: verb tables (University of Pittsburgh)", "u": "https://lektorek.org/polish/"},
  "items": [
    {"c": "mieć", "a": "to have", "d": ["to be", "to give"], "ex": "Mam pytanie.", "exT": "I have a question."},
    {"c": "widzieć", "a": "to see", "d": ["to watch", "to know"], "ex": "Widzisz ten dom?", "exT": "Do you see that house?"},
    {"c": "mówić", "a": "to speak", "d": ["to listen", "to write"], "ex": "Mówię trochę po polsku.", "exT": "I speak a little Polish."},
    {"c": "czytać", "a": "to read", "d": ["to write", "to count"]},
    {"c": "pisać", "a": "to write", "d": ["to read", "to draw"]},
    {"c": "spać", "a": "to sleep", "d": ["to rest", "to dream"]},
    {"c": "kochać", "a": "to love", "d": ["to like", "to kiss"]},
    {"c": "wiedzieć", "a": "to know (a fact)", "d": ["to know (a person)", "to see"], "ex": "Nie wiem, gdzie on jest.", "exT": "I don't know where he is."},
    {"c": "znać", "a": "to know (a person or place)", "d": ["to know (a fact)", "to meet"], "ex": "Znasz Marka?", "exT": "Do you know Marek?"},
    {"c": "uczyć się", "a": "to learn, to study", "d": ["to teach", "to read"], "ex": "Uczę się polskiego.", "exT": "I'm learning Polish."},
    {"c": "iść", "a": "to go (on foot)", "d": ["to go (by vehicle)", "to run"]},
    {"c": "robić", "a": "to do, to make", "d": ["to work", "to take"], "ex": "Co robisz?", "exT": "What are you doing?"},
    {"c": "pracować", "a": "to work", "d": ["to rest", "to do"]},
    {"c": "mieszkać", "a": "to live (reside)", "d": ["to stay (overnight)", "to sleep"], "ex": "Mieszkam w Gdańsku.", "exT": "I live in Gdańsk."},
    {"c": "rozumieć", "a": "to understand", "d": ["to remember", "to know (a person)"]},
    {"c": "słuchać", "a": "to listen", "d": ["to hear", "to speak"]},
    {"c": "oglądać", "a": "to watch", "d": ["to see", "to look for"]},
    {"c": "lubić", "a": "to like", "d": ["to love", "to want"], "ex": "Lubię kawę.", "exT": "I like coffee."},
    {"c": "gotować", "a": "to cook", "d": ["to eat", "to bake"]},
    {"c": "czekać", "a": "to wait", "d": ["to look for", "to sit"]},
    {"c": "szukać", "a": "to look for", "d": ["to find", "to wait"]},
    {"c": "myśleć", "a": "to think", "d": ["to know (a fact)", "to remember"]},
    {"c": "Ja ___ książkę. (czytać)", "a": "czytam", "d": ["czytasz", "czyta"], "ex": "Ja czytam książkę.", "exT": "I'm reading a book."},
    {"c": "Ty ___ list. (pisać)", "a": "piszesz", "d": ["piszę", "pisze"], "ex": "Ty piszesz list.", "exT": "You're writing a letter."},
    {"c": "Oni ___ po polsku. (mówić)", "a": "mówią", "d": ["mówię", "mówi"], "ex": "Oni mówią po polsku.", "exT": "They speak Polish."},
    {"c": "My ___ w Warszawie. (mieszkać)", "a": "mieszkamy", "d": ["mieszkam", "mieszkacie"], "ex": "My mieszkamy w Warszawie.", "exT": "We live in Warsaw."},
    {"c": "Ona ___ w banku. (pracować)", "a": "pracuje", "d": ["pracuję", "pracujesz"], "ex": "Ona pracuje w banku.", "exT": "She works in a bank."},
    {"c": "Ja nie ___. (wiedzieć)", "a": "wiem", "d": ["wiesz", "wie"], "ex": "Ja nie wiem.", "exT": "I don't know."},
    {"c": "Wy ___ film? (oglądać)", "a": "oglądacie", "d": ["oglądamy", "oglądają"], "ex": "Wy oglądacie film?", "exT": "Are you (all) watching a film?"},
    {"c": "Ty ___ psa? (mieć)", "a": "masz", "d": ["mam", "ma"], "ex": "Ty masz psa?", "exT": "Do you have a dog?"},
    {"c": "Ja ___ muzyki. (słuchać)", "a": "słucham", "d": ["słucha", "słuchasz"], "ex": "Ja słucham muzyki.", "exT": "I'm listening to music."}
  ]
}
