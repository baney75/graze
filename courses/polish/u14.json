{
  "title": "Work and school",
  "note": "After być, a noun saying what someone is takes the instrumental: Jestem lekarzem, On jest nauczycielem (masculine -em), Ona jest studentką (feminine -ą). The instrumental also follows z meaning \"with\": kawa z mlekiem, idę z siostrą. Ask about jobs with Kim jesteś z zawodu?",
  "src": {"t": "Polish grammar: instrumental case, Wikipedia", "u": "https://en.wikipedia.org/wiki/Polish_grammar"},
  "items": [
    {"c": "szkoła", "a": "school", "d": ["university", "class"], "ex": "Dzieci są w szkole.", "exT": "The children are at school."},
    {"c": "praca", "a": "work, job", "d": ["office", "school"], "ex": "Idę do pracy.", "exT": "I'm going to work."},
    {"c": "książka", "a": "book", "d": ["notebook", "newspaper"]},
    {"c": "nauczyciel (m)", "a": "teacher", "d": ["student", "principal"], "say": "nauczyciel"},
    {"c": "uczeń (m)", "a": "pupil, schoolboy", "d": ["teacher", "university student"], "say": "uczeń", "ex": "On jest dobrym uczniem.", "exT": "He is a good pupil."},
    {"c": "student (m)", "a": "(university) student", "d": ["pupil, schoolboy", "professor"], "say": "student"},
    {"c": "inżynier (m)", "a": "engineer", "d": ["lawyer", "mechanic"], "say": "inżynier"},
    {"c": "pielęgniarka (f)", "a": "nurse", "d": ["doctor", "pharmacist"], "say": "pielęgniarka"},
    {"c": "kierowca (m)", "a": "driver", "d": ["mechanic", "pilot"], "say": "kierowca"},
    {"c": "sprzedawca (m)", "a": "salesperson, shop assistant", "d": ["customer", "manager"], "say": "sprzedawca"},
    {"c": "szef (m)", "a": "boss", "d": ["colleague", "client"], "say": "szef"},
    {"c": "kolega (m)", "a": "colleague; buddy", "d": ["boss", "neighbor"], "ex": "To mój kolega z pracy.", "exT": "This is my colleague from work.", "say": "kolega"},
    {"c": "biuro (n)", "a": "office", "d": ["factory", "shop"], "say": "biuro"},
    {"c": "firma (f)", "a": "company, firm", "d": ["factory", "office"], "say": "firma"},
    {"c": "uniwersytet (m)", "a": "university", "d": ["school", "library"], "say": "uniwersytet"},
    {"c": "lekcja (f)", "a": "lesson", "d": ["exam", "homework"], "say": "lekcja"},
    {"c": "egzamin (m)", "a": "exam", "d": ["lesson", "grade"], "say": "egzamin"},
    {"c": "zeszyt (m)", "a": "notebook (for school)", "d": ["textbook", "folder"], "say": "zeszyt"},
    {"c": "długopis (m)", "a": "pen", "d": ["pencil", "marker"], "say": "długopis"},
    {"c": "ołówek (m)", "a": "pencil", "d": ["pen", "eraser"], "say": "ołówek"},
    {"c": "studiować", "a": "to study (at university)", "d": ["to teach", "to read"], "ex": "Studiuję medycynę.", "exT": "I study medicine."},
    {"c": "Kim jesteś z zawodu?", "a": "What do you do for a living?", "d": ["Where do you work?", "Who is your boss?"]},
    {"c": "Jestem ___. (nauczyciel)", "a": "nauczycielem", "d": ["nauczyciel", "nauczyciela"], "ex": "Jestem nauczycielem.", "exT": "I'm a teacher."},
    {"c": "Ona jest ___. (studentka)", "a": "studentką", "d": ["studentka", "studentkę"], "ex": "Ona jest studentką.", "exT": "She's a student."},
    {"c": "Mój brat jest ___. (inżynier)", "a": "inżynierem", "d": ["inżynier", "inżyniera"], "ex": "Mój brat jest inżynierem.", "exT": "My brother is an engineer."},
    {"c": "Kawa z ___, proszę. (mleko)", "a": "mlekiem", "d": ["mleka", "mleko"], "ex": "Kawa z mlekiem, proszę.", "exT": "Coffee with milk, please."},
    {"c": "Idę do kina z ___. (siostra)", "a": "siostrą", "d": ["siostrę", "siostry"], "ex": "Idę do kina z siostrą.", "exT": "I'm going to the cinema with my sister."},
    {"c": "Pracuję z ___. (kolega)", "a": "kolegą", "d": ["kolega", "kolegę"], "ex": "Pracuję z kolegą.", "exT": "I work with a colleague."},
    {"c": "Jestem ___. (lekarz)", "a": "lekarzem", "d": ["lekarz", "lekarza"], "ex": "Jestem lekarzem.", "exT": "I'm a doctor."}
