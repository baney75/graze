{
  "title": "Travel and transport",
  "note": "iść = go on foot (idę, idziesz, idzie … idą); jechać = go by vehicle (jadę, jedziesz, jedzie … jadą). The means of transport is in the instrumental case: masculine and neuter nouns take -em (autobusem, pociągiem, samochodem), feminine take -ą (taksówką). Flying is lecieć: lecę samolotem.",
  "src": {"t": "Polish grammar: instrumental case, Wikipedia", "u": "https://en.wikipedia.org/wiki/Polish_grammar"},
  "items": [
    {"c": "jechać", "a": "to go (by vehicle), to ride", "d": ["to go (on foot)", "to fly"], "ex": "Jutro jadę do Warszawy.", "exT": "Tomorrow I'm going to Warsaw."},
    {"c": "lecieć", "a": "to fly", "d": ["to drive", "to sail"]},
    {"c": "samochód (m)", "a": "car", "d": ["bus", "truck"], "say": "samochód"},
    {"c": "autobus (m)", "a": "bus", "d": ["tram", "train"], "say": "autobus"},
    {"c": "pociąg (m)", "a": "train", "d": ["tram", "airplane"], "say": "pociąg"},
    {"c": "tramwaj (m)", "a": "tram, streetcar", "d": ["train", "subway"], "say": "tramwaj"},
    {"c": "samolot (m)", "a": "airplane", "d": ["airport", "helicopter"], "say": "samolot"},
    {"c": "rower (m)", "a": "bicycle", "d": ["motorcycle", "scooter"], "say": "rower"},
    {"c": "taksówka (f)", "a": "taxi", "d": ["bus", "car"], "say": "taksówka"},
    {"c": "bilet (m)", "a": "ticket", "d": ["passport", "receipt"], "say": "bilet", "ex": "Mam bilet na pociąg.", "exT": "I have a train ticket."},
    {"c": "lotnisko (n)", "a": "airport", "d": ["train station", "airplane"], "say": "lotnisko"},
    {"c": "przystanek (m)", "a": "(bus or tram) stop", "d": ["platform", "station building"], "say": "przystanek"},
    {"c": "peron (m)", "a": "(train) platform", "d": ["bus stop", "ticket office"], "say": "peron"},
    {"c": "podróż (f)", "a": "journey, trip", "d": ["ticket", "vacation"], "say": "podróż"},
    {"c": "walizka (f)", "a": "suitcase", "d": ["backpack", "handbag"], "say": "walizka"},
    {"c": "paszport (m)", "a": "passport", "d": ["ticket", "ID card"], "say": "paszport"},
    {"c": "wakacje (pl)", "a": "vacation, summer holidays", "d": ["weekend", "business trip"], "ex": "Na wakacje jedziemy nad morze.", "exT": "For vacation we're going to the seaside.", "say": "wakacje"},
    {"c": "pieszo", "a": "on foot", "d": ["by car", "by bike"], "ex": "Idę do pracy pieszo.", "exT": "I walk to work."},
    {"c": "Jadę do pracy ___. (autobus)", "a": "autobusem", "d": ["autobus", "autobusie"], "ex": "Jadę do pracy autobusem.", "exT": "I go to work by bus."},
    {"c": "Jedziemy ___. (taksówka)", "a": "taksówką", "d": ["taksówkę", "taksówka"], "ex": "Jedziemy taksówką.", "exT": "We're going by taxi."},
    {"c": "On jedzie ___. (pociąg)", "a": "pociągiem", "d": ["pociąg", "pociągu"], "ex": "On jedzie pociągiem do Gdańska.", "exT": "He's going to Gdańsk by train."},
    {"c": "Ja ___ do Krakowa samochodem. (jechać)", "a": "jadę", "d": ["idę", "jedzie"], "ex": "Ja jadę do Krakowa samochodem.", "exT": "I'm driving to Kraków."},
    {"c": "Oni ___ rowerem. (jechać)", "a": "jadą", "d": ["idą", "jedziecie"], "ex": "Oni jadą rowerem.", "exT": "They're riding bikes."},
    {"c": "Ona ___ do sklepu pieszo. (iść)", "a": "idzie", "d": ["jedzie", "idę"], "ex": "Ona idzie do sklepu pieszo.", "exT": "She's walking to the shop."},
    {"c": "My ___ do kina. (iść)", "a": "idziemy", "d": ["idą", "idziesz"], "ex": "My idziemy do kina.", "exT": "We're going to the cinema."},
    {"c": "Jeden bilet do Gdańska, proszę.", "a": "One ticket to Gdańsk, please.", "d": ["One ticket from Gdańsk, please.", "Is this the train to Gdańsk?"]},
    {"c": "O której odjeżdża pociąg?", "a": "What time does the train leave?", "d": ["What time does the train arrive?", "Which platform is the train on?"]},
    {"c": "Gdzie jest przystanek?", "a": "Where is the stop?", "d": ["Where is the ticket office?", "Is this my stop?"]},
    {"c": "Szczęśliwej podróży!", "a": "Have a good trip!", "d": ["Welcome back!", "Enjoy your meal!"]}
  ]
}
