    {"c": "Ona ___ książkę. (czytać, past)", "a": "czytała", "d": ["czytał", "czytałam"], "ex": "Ona czytała książkę cały wieczór.", "exT": "She read a book all evening."},
    {"c": "Oni ___ obiad. (jeść, past)", "a": "jedli", "d": ["jadły", "jadł"], "ex": "Oni jedli obiad.", "exT": "They ate the main meal."},
