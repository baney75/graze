{
  "title": "The past tense",
  "note": "Past tense: drop -ć from the infinitive, add -ł, then gender and person endings: byłem (I was, man), byłam (woman), byłeś/byłaś (you), był/była/było (he/she/it), byliśmy/byłyśmy (we), byliście/byłyście, byli/były (they). Use -li only for groups including men. Some stems change: jeść → jadłem, iść → szedłem/szłam.",
  "src": {"t": "Polish grammar: past tense, Wikipedia", "u": "https://en.wikipedia.org/wiki/Polish_grammar"},
  "items": [
    {"c": "byłem", "a": "I was (man speaking)", "d": ["I was (woman speaking)", "he was"], "ex": "Wczoraj byłem w kinie.", "exT": "Yesterday I was at the cinema."},
    {"c": "byłam", "a": "I was (woman speaking)", "d": ["I was (man speaking)", "she was"]},
    {"c": "byłeś", "a": "you were (to a man)", "d": ["you were (to a woman)", "I was (man speaking)"]},
    {"c": "był", "a": "he was", "d": ["she was", "it was"]},
    {"c": "była", "a": "she was", "d": ["he was", "they were"]},
    {"c": "było", "a": "it was", "d": ["he was", "they were"], "ex": "Było bardzo zimno.", "exT": "It was very cold."},
    {"c": "byli", "a": "they were (a group with men)", "d": ["they were (only women or things)", "we were"]},
    {"c": "były", "a": "they were (only women or things)", "d": ["they were (a group with men)", "it was"]},
    {"c": "byliśmy", "a": "we were (a group with men)", "d": ["you were (plural)", "they were"]},
    {"c": "przedwczoraj", "a": "the day before yesterday", "d": ["the day after tomorrow", "last week"]},
    {"c": "tydzień temu", "a": "a week ago", "d": ["in a week", "last weekend"]},
    {"c": "w zeszłym roku", "a": "last year", "d": ["next year", "this year"]},
    {"c": "Gdzie byłaś?", "a": "Where were you? (to a woman)", "d": ["Where are you going? (to a woman)", "Where do you live? (to a woman)"]},
    {"c": "Co robiłeś wczoraj?", "a": "What did you do yesterday? (to a man)", "d": ["What will you do tomorrow? (to a man)", "What are you doing today? (to a man)"]},
    {"c": "Byłem w pracy.", "a": "I was at work. (man speaking)", "d": ["I'm going to work. (man speaking)", "I will be at work. (man speaking)"]},
