{
  "title": "Family",
  "note": "Possessives agree with the thing owned, not the owner: mi hermano, mis hermanos; su casa can mean his, her, their or your (usted) house. Nuestro also agrees in gender: nuestra madre. A masculine plural covers mixed groups: los padres are parents, los hermanos are brothers and sisters.",
  "src": {"t": "Spanish 1A: Beginning Spanish (LibreTexts)", "u": "https://human.libretexts.org/Courses/Chabot_College/Spanish_1A%3A_Beginning_Spanish_(2026)"},
  "items": [
    {"c": "la familia", "a": "the family", "d": ["the house", "the parents"], "ex": "Mi familia es grande.", "exT": "My family is big."},
    {"c": "el padre", "a": "the father", "d": ["the uncle", "the brother"], "ex": "Mi padre se llama José.", "exT": "My father's name is José."},
    {"c": "la madre", "a": "the mother", "d": ["the aunt", "the sister"], "ex": "Mi madre es profesora.", "exT": "My mother is a teacher."},
    {"c": "los padres", "a": "the parents", "d": ["the grandparents", "the relatives"], "ex": "Mis padres son de Cuba.", "exT": "My parents are from Cuba."},
    {"c": "el hermano", "a": "the brother", "d": ["the cousin (male)", "the uncle"]},
    {"c": "la hermana", "a": "the sister", "d": ["the cousin (female)", "the aunt"], "ex": "Mi hermana tiene diez años.", "exT": "My sister is ten."},
    {"c": "los hermanos", "a": "brothers and sisters, siblings", "d": ["cousins", "parents"]},
    {"c": "el hijo", "a": "the son", "d": ["the grandson", "the nephew"]},
    {"c": "la hija", "a": "the daughter", "d": ["the granddaughter", "the niece"]},
    {"c": "el abuelo", "a": "the grandfather", "d": ["the uncle", "the grandson"]},
    {"c": "la abuela", "a": "the grandmother", "d": ["the aunt", "the granddaughter"], "ex": "Mi abuela vive con nosotros.", "exT": "My grandmother lives with us."},
    {"c": "el tío", "a": "the uncle", "d": ["the nephew", "the grandfather"], "ex": "Mi tío vive en Miami.", "exT": "My uncle lives in Miami."},
    {"c": "la tía", "a": "the aunt", "d": ["the niece", "the grandmother"]},
    {"c": "el primo", "a": "the cousin (male)", "d": ["the nephew", "the brother"], "ex": "Mi primo tiene doce años.", "exT": "My cousin is twelve."},
    {"c": "la prima", "a": "the cousin (female)", "d": ["the niece", "the sister"]},
    {"c": "el sobrino", "a": "the nephew", "d": ["the cousin (male)", "the grandson"]},
    {"c": "la sobrina", "a": "the niece", "d": ["the cousin (female)", "the granddaughter"]},
    {"c": "el nieto", "a": "the grandson", "d": ["the nephew", "the son"]},
    {"c": "el esposo", "a": "the husband", "d": ["the boyfriend", "the brother"], "ex": "Su esposo es de Cuba.", "exT": "Her husband is from Cuba."},
    {"c": "la esposa", "a": "the wife", "d": ["the girlfriend", "the sister"]},
    {"c": "el novio", "a": "the boyfriend", "d": ["the husband", "the cousin (male)"]},
    {"c": "la novia", "a": "the girlfriend", "d": ["the wife", "the cousin (female)"]},
    {"c": "el bebé", "a": "the baby", "d": ["the boy", "the father"]},
    {"c": "mayor", "a": "older", "d": ["younger", "taller"], "ex": "Mi hermano mayor tiene treinta años.", "exT": "My older brother is thirty."},
    {"c": "menor", "a": "younger", "d": ["older", "twin"]},
    {"c": "casado", "a": "married", "d": ["single", "divorced"], "ex": "Mi hermano está casado.", "exT": "My brother is married."},
    {"c": "soltero", "a": "single, unmarried", "d": ["married", "widowed"]},
    {"c": "el perro", "a": "the dog", "d": ["the cat", "the horse"], "ex": "Tenemos un perro grande.", "exT": "We have a big dog."},
    {"c": "el gato", "a": "the cat", "d": ["the dog", "the bird"]},
    {"c": "¿Tienes hermanos?", "a": "Do you have brothers or sisters?", "d": ["Are you my brother?", "Do you have children?"]},
    {"c": "___ hermanos son altos. (my)", "a": "Mis", "d": ["Mi", "Mí"], "ex": "Mis hermanos son altos.", "exT": "My brothers are tall."},
    {"c": "___ casa es grande. (our)", "a": "Nuestra", "d": ["Nuestro", "Nuestros"]},
    {"c": "¿Cómo se llama ___ madre? (your, informal)", "a": "tu", "d": ["tú", "tus"]},
    {"c": "Ana y ___ padres viven aquí. (her)", "a": "sus", "d": ["su", "tus"]}
  ]
}
