{
  "title": "Food and drink",
  "note": "Nouns ending in -o are usually masculine and those in -a usually feminine, but learn each noun with its article. Feminine nouns starting with a stressed a take el in the singular: el agua fría, las aguas. Some words vary by region: jugo (Latin America) is zumo in Spain. Order politely with Quisiera… (I'd like…).",
  "src": {"t": "Spanish 1A: Beginning Spanish (LibreTexts)", "u": "https://human.libretexts.org/Courses/Chabot_College/Spanish_1A%3A_Beginning_Spanish_(2026)"},
  "items": [
    {"c": "el agua", "a": "water", "d": ["milk", "juice"], "ex": "Quisiera un vaso de agua.", "exT": "I'd like a glass of water."},
    {"c": "el pan", "a": "bread", "d": ["cheese", "rice"], "ex": "Compro pan todos los días.", "exT": "I buy bread every day."},
    {"c": "la leche", "a": "milk", "d": ["water", "coffee"], "ex": "Quiero café con leche.", "exT": "I want coffee with milk."},
    {"c": "el café", "a": "coffee", "d": ["tea", "milk"]},
    {"c": "el té", "a": "tea", "d": ["coffee", "juice"]},
    {"c": "el jugo", "a": "juice", "d": ["milk", "soup"], "ex": "Un jugo de naranja, por favor.", "exT": "An orange juice, please."},
    {"c": "la carne", "a": "meat", "d": ["fish", "bread"]},
    {"c": "el pollo", "a": "chicken", "d": ["fish", "pork"]},
    {"c": "el pescado", "a": "fish (as food)", "d": ["chicken", "meat"], "ex": "No como pescado.", "exT": "I don't eat fish."},
    {"c": "el arroz", "a": "rice", "d": ["bread", "beans"], "ex": "Como arroz con pollo.", "exT": "I eat chicken with rice."},
    {"c": "el huevo", "a": "egg", "d": ["cheese", "apple"]},
    {"c": "el queso", "a": "cheese", "d": ["egg", "butter"]},
    {"c": "la fruta", "a": "fruit", "d": ["vegetable", "salad"]},
    {"c": "la manzana", "a": "apple", "d": ["orange", "banana"], "ex": "La manzana es roja.", "exT": "The apple is red."},
    {"c": "la naranja", "a": "orange (fruit)", "d": ["apple", "lemon"]},
    {"c": "la verdura", "a": "vegetable", "d": ["fruit", "meat"]},
    {"c": "la ensalada", "a": "salad", "d": ["soup", "sandwich"]},
    {"c": "la sopa", "a": "soup", "d": ["salad", "sauce"]},
    {"c": "el azúcar", "a": "sugar", "d": ["salt", "flour"]},
    {"c": "la sal", "a": "salt", "d": ["sugar", "pepper"]},
    {"c": "la cerveza", "a": "beer", "d": ["wine", "juice"]},
    {"c": "el vino", "a": "wine", "d": ["beer", "vinegar"]},
    {"c": "el desayuno", "a": "breakfast", "d": ["lunch", "dinner"], "ex": "El desayuno es a las ocho.", "exT": "Breakfast is at eight."},
    {"c": "el almuerzo", "a": "lunch", "d": ["breakfast", "dinner"]},
    {"c": "la cena", "a": "dinner, supper", "d": ["breakfast", "lunch"], "ex": "La cena es a las nueve.", "exT": "Dinner is at nine."},
    {"c": "comer", "a": "to eat", "d": ["to drink", "to cook"], "ex": "¿Qué quieres comer?", "exT": "What do you want to eat?"},
    {"c": "beber", "a": "to drink", "d": ["to eat", "to pour"]},
    {"c": "tener hambre", "a": "to be hungry", "d": ["to be thirsty", "to be full"], "ex": "Tengo mucha hambre.", "exT": "I'm very hungry."},
    {"c": "tener sed", "a": "to be thirsty", "d": ["to be hungry", "to be tired"], "ex": "¿Tienes sed?", "exT": "Are you thirsty?"},
    {"c": "La cuenta, por favor.", "a": "The check, please.", "d": ["The menu, please.", "A table, please."]},
    {"c": "Quisiera un café.", "a": "I'd like a coffee.", "d": ["I made a coffee.", "I'd like a tea."]},
    {"c": "Yo ___ pan. (comer)", "a": "como", "d": ["come", "comes"], "ex": "Yo como pan con queso.", "exT": "I eat bread with cheese."},
    {"c": "Nosotros ___ agua. (beber)", "a": "bebemos", "d": ["beben", "bebéis"]},
    {"c": "Quiero agua porque tengo ___.", "a": "sed", "d": ["hambre", "sueño"]},
    {"c": "___ agua está fría.", "a": "El", "d": ["La", "Los"]}
  ]
}
