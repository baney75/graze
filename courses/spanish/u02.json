    {"c": "ustedes", "a": "you all", "d": ["they", "we"], "ex": "¿Ustedes son estudiantes?", "exT": "Are you all students?"},
    {"c": "vosotros", "a": "you all (informal, Spain)", "d": ["we (informal, Spain)", "they (informal, Spain)"]},
    {"c": "el hombre", "a": "the man", "d": ["the woman", "the boy"]},
