{
  "title": "People, pronouns and ser (to be)",
  "note": "Ser means to be for identity, origin, profession and lasting traits: soy, eres, es, somos, sois, son. Subject pronouns are often dropped because the ending shows who: Soy de Chile. Vosotros (you all, informal) is used in Spain; Latin America uses ustedes for every you all. No article before a bare profession: Soy médico.",
  "src": {"t": "Spanish 1A (LibreTexts), 2.13 Ser y estar", "u": "https://human.libretexts.org/Courses/Chabot_College/Spanish/Spanish_1A%3A_Beginning_Spanish_(2026)/02%3A_Capitulo_2-_Eres_estudiante/2.13%3A_Gramatica-_Ser_y_estar"},
  "items": [
    {"c": "yo", "a": "I", "d": ["you", "he"], "ex": "Yo soy Carmen.", "exT": "I am Carmen."},
    {"c": "tú", "a": "you (informal)", "d": ["I", "we"], "ex": "¿Tú eres de aquí?", "exT": "Are you from here?"},
    {"c": "él", "a": "he", "d": ["she", "they"], "ex": "Él es mi amigo Luis.", "exT": "He is my friend Luis."},
    {"c": "ella", "a": "she", "d": ["he", "you (formal)"], "ex": "Ella es de Argentina.", "exT": "She is from Argentina."},
    {"c": "usted", "a": "you (formal)", "d": ["he", "you all"], "ex": "¿Usted es el señor López?", "exT": "Are you Mr. López?"},
    {"c": "nosotros", "a": "we", "d": ["they", "you all"], "ex": "Nosotros somos amigos.", "exT": "We are friends."},
    {"c": "ellos", "a": "they (men or a mixed group)", "d": ["we (men or a mixed group)", "you (informal)"]},
