{
  "title": "The past tense: the preterite",
  "note": "The preterite tells what happened at a specific time. -ar: -é, -aste, -ó, -amos, -asteis, -aron. -er/-ir: -í, -iste, -ió, -imos, -isteis, -ieron. Verbs in -car, -gar, -zar change spelling in the yo form: busqué, pagué, empecé. Ir and ser share forms: fui, fuiste, fue, fuimos, fueron. Others: tuve, estuve, hice, hizo.",
  "src": {"t": "Spanish 1A (LibreTexts), 5.8 El pretérito", "u": "https://human.libretexts.org/Courses/Chabot_College/Spanish/Spanish_1A%3A_Beginning_Spanish_(2026)/05%3A_Capitulo_5-_Adonde_fuiste_de_vacaciones/5.08%3A_El_preterito"},
  "items": [
    {"c": "hablé", "a": "I spoke", "d": ["he spoke", "I speak"], "ex": "Ayer hablé con mi madre.", "exT": "Yesterday I spoke with my mother."},
    {"c": "habló", "a": "he/she spoke", "d": ["I speak", "I spoke"]},
    {"c": "comí", "a": "I ate", "d": ["I eat", "he ate"], "ex": "Ayer comí en un restaurante.", "exT": "Yesterday I ate at a restaurant."},
    {"c": "viví", "a": "I lived", "d": ["I live", "you lived"]},
    {"c": "trabajaste", "a": "you worked", "d": ["you work", "they worked"]},
    {"c": "compraron", "a": "they bought", "d": ["we bought", "they buy"]},
    {"c": "escribimos", "a": "we wrote, we write", "d": ["they wrote", "you wrote"]},
    {"c": "fui", "a": "I went, I was", "d": ["he went", "I go"], "ex": "El verano pasado fui a México.", "exT": "Last summer I went to Mexico."},
    {"c": "fue", "a": "he/she went, he/she was", "d": ["I went", "it will be"], "ex": "La fiesta fue muy buena.", "exT": "The party was very good."},
    {"c": "fuimos", "a": "we went, we were", "d": ["they went", "we go"]},
    {"c": "tuve", "a": "I had", "d": ["I have", "he had"], "ex": "Tuve un día muy bueno.", "exT": "I had a very good day."},
    {"c": "estuve", "a": "I was (estar)", "d": ["I am (estar)", "he was (estar)"]},
    {"c": "hice", "a": "I did, I made", "d": ["he did", "I do"], "ex": "Anoche hice la cena.", "exT": "Last night I made dinner."},
    {"c": "hizo", "a": "he/she did, made", "d": ["I did", "he does"]},
    {"c": "vi", "a": "I saw", "d": ["I see", "I came"], "ex": "Anoche vi una película.", "exT": "Last night I saw a movie."},
    {"c": "di", "a": "I gave", "d": ["I said", "I give"]},
    {"c": "había", "a": "there was, there were", "d": ["there is", "there will be"], "ex": "Había mucha gente en la plaza.", "exT": "There were a lot of people in the square."},
    {"c": "anoche", "a": "last night", "d": ["tonight", "tomorrow night"], "ex": "Anoche llegué tarde a casa.", "exT": "Last night I got home late."},
    {"c": "anteayer", "a": "the day before yesterday", "d": ["the day after tomorrow", "yesterday"]},
    {"c": "la semana pasada", "a": "last week", "d": ["next week", "this week"], "ex": "La semana pasada fui a Lima.", "exT": "Last week I went to Lima."},
    {"c": "el año pasado", "a": "last year", "d": ["next year", "every year"]},
    {"c": "hace dos días", "a": "two days ago", "d": ["in two days", "every two days"]},
    {"c": "Ayer yo ___ con Ana. (hablar)", "a": "hablé", "d": ["habló", "hablo"]},
    {"c": "Anoche ellos ___ pizza. (comer)", "a": "comieron", "d": ["comimos", "comen"], "ex": "Anoche ellos comieron pizza.", "exT": "Last night they ate pizza."},
    {"c": "El sábado pasado yo ___ al cine. (ir)", "a": "fui", "d": ["fue", "fuiste"]},
    {"c": "Anoche ella ___ la tarea. (hacer)", "a": "hizo", "d": ["hice", "hació"]},
    {"c": "¿Qué ___ tú ayer? (hacer)", "a": "hiciste", "d": ["hizo", "haciste"]},
    {"c": "Ayer yo ___ la cuenta. (pagar)", "a": "pagué", "d": ["pagé", "pagó"], "ex": "Ayer yo pagué la cuenta.", "exT": "Yesterday I paid the check."},
    {"c": "Anoche yo ___ mis llaves. (buscar)", "a": "busqué", "d": ["buscé", "buscó"]},
    {"c": "Ayer nosotros ___ en casa. (estar)", "a": "estuvimos", "d": ["estamos", "estuvieron"]},
    {"c": "El año pasado ellos ___ a Chile. (viajar)", "a": "viajaron", "d": ["viajan", "viajó"]},
    {"c": "Ayer yo ___ un examen. (tener)", "a": "tuve", "d": ["tengo", "tení"]}
  ]
