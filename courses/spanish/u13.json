    {"c": "la ropa", "a": "clothes, clothing", "d": ["fabric", "shoes"], "ex": "Compro ropa nueva.", "exT": "I'm buying new clothes."},
    {"c": "la camisa", "a": "the shirt", "d": ["the skirt", "the jacket"], "ex": "La camisa es blanca.", "exT": "The shirt is white."},
    {"c": "la camiseta", "a": "the T-shirt", "d": ["the sweater", "the shirt collar"]},
    {"c": "los pantalones", "a": "the pants, the trousers", "d": ["the shorts", "the socks"], "ex": "Necesito pantalones nuevos.", "exT": "I need new pants."},
    {"c": "la falda", "a": "the skirt", "d": ["the dress", "the shirt"]},
    {"c": "el vestido", "a": "the dress", "d": ["the skirt", "the suit"]},
    {"c": "los zapatos", "a": "the shoes", "d": ["the socks", "the boots"], "ex": "Mis zapatos son negros.", "exT": "My shoes are black."},
    {"c": "los calcetines", "a": "the socks", "d": ["the shoes", "the gloves"]},
    {"c": "el abrigo", "a": "the coat, the overcoat", "d": ["the vest", "the scarf"], "ex": "En invierno llevo abrigo.", "exT": "In winter I wear a coat."},
    {"c": "la chaqueta", "a": "the jacket", "d": ["the coat hanger", "the shirt"]},
    {"c": "el suéter", "a": "the sweater", "d": ["the T-shirt", "the jacket"]},
    {"c": "el sombrero", "a": "the hat", "d": ["the umbrella", "the shade"]},
    {"c": "la talla", "a": "the size (of clothes)", "d": ["the price", "the color"], "ex": "¿Qué talla usa usted?", "exT": "What size do you wear?"},
    {"c": "el precio", "a": "the price", "d": ["the size", "the receipt"]},
    {"c": "el dinero", "a": "money", "d": ["price", "wallet"]},
    {"c": "barato", "a": "cheap, inexpensive", "d": ["expensive", "free"], "ex": "Este vestido es muy barato.", "exT": "This dress is very cheap."},
    {"c": "caro", "a": "expensive", "d": ["cheap", "on sale"]},
    {"c": "pagar", "a": "to pay", "d": ["to buy", "to cost"], "ex": "¿Puedo pagar en efectivo?", "exT": "Can I pay in cash?"},
    {"c": "costar", "a": "to cost", "d": ["to pay", "to count"]},
    {"c": "llevar", "a": "to wear, to carry", "d": ["to bring back", "to take off"], "ex": "Hoy llevo una camisa azul.", "exT": "Today I'm wearing a blue shirt."},
    {"c": "probarse", "a": "to try on", "d": ["to buy", "to put away"], "ex": "¿Puedo probarme la chaqueta?", "exT": "Can I try on the jacket?"},
    {"c": "la tarjeta de crédito", "a": "the credit card", "d": ["the receipt", "the cash"]},
    {"c": "en efectivo", "a": "in cash", "d": ["by card", "on sale"]},
    {"c": "¿Cuánto cuesta?", "a": "How much does it cost?", "d": ["How many are there?", "What size is it?"], "ex": "¿Cuánto cuesta esta camisa?", "exT": "How much does this shirt cost?"},
    {"c": "¿Puedo pagar con tarjeta?", "a": "Can I pay by card?", "d": ["Can I pay in cash?", "Can I have a bag?"]},
