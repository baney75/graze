      "c": "esse",
      "a": "to be",
      "d": [
        "to have",
        "to go"
      ]
    },
    {
      "c": "ego",
      "a": "I",
      "d": [
        "you (one person)",
        "we"
      ],
      "ex": "Ego sum Marcus.",
      "exT": "I am Marcus."
    },
    {
      "c": "tu",
      "a": "you (one person)",
      "d": [
        "I",
        "you (more than one)"
      ],
      "ex": "Tu es amicus meus.",
      "exT": "You are my friend."
    },
    {
