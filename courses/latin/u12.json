  "read": {
    "title": "Nuntius",
    "text": [
      "Nuntius in villam currit et clamat: \"Hostes veniunt!\" Agricola nuntium audit, sed non credit.",
      "Tum filius agricolae epistulam legit. In epistula dux scribit: \"Milites mitto. Servi et agricolae fugere debent.\"",
      "Nunc agricola credit. Familia aurum et arma capit et in silvam fugit. In silva familia dormit, sed timet.",
      "Postea milites veniunt et hostes vincunt. Tum familia laeta in villam venit."
    ],
    "q": [
      { "q": "What does the messenger shout?", "o": ["The enemy is coming!", "The soldiers are leaving!", "The farmhouse is on fire!"], "k": 0 },
      { "q": "Who wrote the letter?", "o": ["The messenger", "The general", "The farmer's son"], "k": 1 },
      { "q": "Where does the family flee?", "o": ["Into the town", "To the sea", "Into the forest"], "k": 2 }
