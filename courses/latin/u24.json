{
  "title": "Latin inside English",
  "note": "English borrows whole Latin phrases, and each is ordinary grammar. Ad hoc and ante bellum are a preposition with the accusative; anno Domini is an ablative of time (in the year) with a genitive (of the Lord); veto is a first-person present, I forbid; agenda means things to be done.",
  "src": { "t": "Wiktionary, Appendix: Latin phrases", "u": "https://en.wiktionary.org/wiki/Appendix:Latin_phrases" },
  "items": [
    { "c": "et cetera (etc.)", "a": "and the rest", "d": ["and also", "for example"] },
    { "c": "exempli gratia (e.g.)", "a": "for the sake of example", "d": ["that is", "and the rest"] },
    { "c": "id est (i.e.)", "a": "that is", "d": ["for example", "note well"] },
    { "c": "nota bene (N.B.)", "a": "note well", "d": ["that is", "good news"] },
    { "c": "et alii (et al.)", "a": "and others (people)", "d": ["and also", "by the way"] },
    { "c": "ante meridiem (a.m.)", "a": "before midday", "d": ["after midday", "at midnight"] },
    { "c": "post meridiem (p.m.)", "a": "after midday", "d": ["before midday", "after midnight"] },
    { "c": "anno Domini (A.D.)", "a": "in the year of the Lord", "d": ["after the death of the Lord", "in the age of Rome"] },
    { "c": "post scriptum (P.S.)", "a": "written after", "d": ["written before", "said again"] },
    { "c": "bona fide", "a": "in good faith", "d": ["good luck", "by good fortune"] },
    { "c": "ad hoc", "a": "for this (purpose)", "d": ["against this", "after this"] },
    { "c": "per se", "a": "by itself, in itself", "d": ["for each person", "for oneself only"] },
    { "c": "alma mater", "a": "nourishing mother", "d": ["mother of the soul", "old mother"] },
    { "c": "terra incognita", "a": "unknown land", "d": ["new land", "holy land"] },
    { "c": "status quo", "a": "the state in which (things are)", "d": ["the state of the people", "the highest rank"] },
    { "c": "quid pro quo", "a": "something for something", "d": ["what for whom", "nothing for nothing"] },
    { "c": "ad infinitum", "a": "to infinity, endlessly", "d": ["from the beginning", "until the end"] },
    { "c": "ante bellum", "a": "before the war", "d": ["after the war", "during the war"] },
    { "c": "in memoriam", "a": "in memory (of)", "d": ["by heart", "in mind"] },
    { "c": "magnum opus", "a": "great work", "d": ["great love", "great author"] },
    { "c": "persona non grata", "a": "an unwelcome person", "d": ["an unknown person", "a grateful person"] },
    { "c": "veto", "a": "I forbid", "d": ["I vote", "I see"] },
    { "c": "agenda", "a": "things to be done", "d": ["things done", "things to be said"] },
    { "c": "habeas corpus", "a": "you may have the body", "d": ["you may free the body", "you have the head"] },
    { "c": "pro bono", "a": "for the good (unpaid)", "d": ["for profit", "for the boss"] },
    { "c": "sic", "a": "thus, so (written this way)", "d": ["sick", "yes"] },
    { "c": "anno ___ (in the year of the Lord; Dominus)", "a": "Domini", "d": ["Domino", "Dominum"] },
    { "c": "ante ___ (before the war; bellum)", "a": "bellum", "d": ["bello", "belli"] },
    { "c": "post ___ (after midday; meridies)", "a": "meridiem", "d": ["meridie", "meridiei"] }
