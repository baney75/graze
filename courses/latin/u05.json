{
  "title": "Second declension: masculine nouns",
  "note": "Second-declension nouns have genitive -i: dominus, domini (m). Most end in -us; a few end in -er or -ir, like puer, ager, liber and vir, and some drop the e (ager, agri). Singular: -us, -i, -o, -um, -o. Calling someone, -us becomes -e: Marce! Domine! Plural: -i, -orum, -is, -os, -is.",
  "src": { "t": "Allen and Greenough, 2nd Declension", "u": "https://dcc.dickinson.edu/grammar/latin/2nd-declension-stem-paradigm-and-gender" },
  "items": [
    { "c": "deus", "a": "god", "d": ["king", "master"] },
    { "c": "liber, libri", "a": "book", "d": ["letter", "word"], "ex": "Liber magistri est.", "exT": "The book is the teacher's." },
    { "c": "dominus (m)", "a": "master, lord", "d": ["slave, servant", "son"], "ex": "Dominus servum vocat.", "exT": "The master calls the slave." },
    { "c": "servus (m)", "a": "slave, servant", "d": ["master, lord", "messenger"] },
    { "c": "filius (m)", "a": "son", "d": ["daughter", "brother"] },
    { "c": "populus (m)", "a": "people, nation", "d": ["army", "city"], "ex": "populus Romanus", "exT": "the Roman people" },
    { "c": "animus (m)", "a": "mind, spirit", "d": ["body", "breath"] },
    { "c": "equus (m)", "a": "horse", "d": ["dog", "wolf"] },
    { "c": "gladius (m)", "a": "sword", "d": ["shield", "spear"] },
    { "c": "ludus (m)", "a": "game; school", "d": ["garden; field", "wall; fort"] },
    { "c": "murus (m)", "a": "wall", "d": ["gate", "roof"] },
    { "c": "numerus (m)", "a": "number", "d": ["name", "year"] },
    { "c": "socius (m)", "a": "ally, companion", "d": ["enemy", "slave"] },
    { "c": "ager (m)", "a": "field", "d": ["garden", "forest"], "ex": "Agricola in agro est.", "exT": "The farmer is in the field." },
    { "c": "locus (m)", "a": "place", "d": ["road", "time"] },
    { "c": "mundus (m)", "a": "world", "d": ["mountain", "sky"] },
    { "c": "hortus (m)", "a": "garden", "d": ["field", "forest"] },
    { "c": "lupus (m)", "a": "wolf", "d": ["dog", "horse"] },
    { "c": "nuntius (m)", "a": "messenger; message", "d": ["letter; book", "ally; friend"] },
    { "c": "barbarus (m)", "a": "foreigner, barbarian", "d": ["citizen", "ally"] },
    { "c": "inimicus (m)", "a": "(personal) enemy", "d": ["friend", "neighbor"] },
    { "c": "amicus, ___ (genitive singular)", "a": "amici", "d": ["amico", "amicum"], "ex": "liber amici", "exT": "the friend's book" },
    { "c": "puer, ___ (genitive singular)", "a": "pueri", "d": ["puero", "puerum"], "ex": "equus pueri", "exT": "the boy's horse" },
    { "c": "ager, ___ (genitive singular)", "a": "agri", "d": ["ageri", "agrum"], "ex": "murus agri", "exT": "the wall of the field" },
    { "c": "Puella ___ amat. (equus)", "a": "equum", "d": ["equus", "equi"], "ex": "Puella equum amat.", "exT": "The girl loves the horse." },
    { "c": "liber ___ (the master's book; dominus)", "a": "domini", "d": ["dominum", "domino"], "ex": "liber domini", "exT": "the master's book" },
    { "c": "___, veni! (Marcus, calling him)", "a": "Marce", "d": ["Marcus", "Marcum"], "ex": "Marce, veni!", "exT": "Marcus, come!" },
    { "c": "___ in agro laborant. (servus, plural)", "a": "servi", "d": ["servos", "servus"], "ex": "Servi in agro laborant.", "exT": "The slaves work in the field." }
  ]
}
