    { "c": "Unde es?", "a": "Where are you from?", "d": ["Where are you?", "Where are you going?"], "ex": "Unde es? Roma.", "exT": "Where are you from? From Rome." },
    { "c": "Ignosce mihi.", "a": "Forgive me.", "d": ["Help me.", "Listen to me."] },
    { "c": "Pax tecum.", "a": "Peace be with you. (to one person)", "d": ["Go in peace. (to one person)", "Peace to your house."] },
    { "c": "Cura ut valeas.", "a": "Take care of yourself.", "d": ["Write back soon.", "Come back soon."], "ex": "Cura ut valeas. Vale.", "exT": "Take care of yourself. Goodbye. (a letter ending, as in Cicero)" },
    { "c": "Si vales, bene est; ego valeo.", "a": "If you are well, good; I am well.", "d": ["If you come, good; I am waiting.", "If you write, good; I am reading."] },
