    { "c": "docere", "a": "to teach", "d": ["to learn", "to lead"] },
    { "c": "monere", "a": "to warn, advise", "d": ["to move", "to remain"] },
    { "c": "tenere", "a": "to hold, keep", "d": ["to fear", "to stretch"] },
    { "c": "debere", "a": "to owe; ought", "d": ["to be able; can", "to want"], "ex": "Laborare debes.", "exT": "You ought to work." },
    { "c": "manere", "a": "to stay, remain", "d": ["to go away", "to warn"] },
    { "c": "respondere", "a": "to answer", "d": ["to ask", "to forget"] },
