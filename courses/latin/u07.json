{
  "title": "Adjectives, agreement and colors",
  "note": "Adjectives agree with their noun in gender, number and case, so bonus, bona, bonum (m, f, n) changes to match: vir bonus, femina bona, donum bonum. Agreement is not rhyme: agricola bonus, a good farmer, because agricola is masculine. Adjectives usually follow the noun. Viridis, viride follows the third declension.",
  "src": { "t": "D'Ooge, Latin for Beginners, Lesson XI: Adjectives of the First and Second Declensions", "u": "https://www.gutenberg.org/ebooks/18251" },
  "items": [
    { "c": "bonus, bona, bonum", "a": "good", "d": ["bad, evil", "great"], "ex": "Femina bona est.", "exT": "The woman is good." },
    { "c": "malus, mala, malum", "a": "bad, evil", "d": ["good", "small"] },
    { "c": "magnus, magna, magnum", "a": "big, great", "d": ["small", "many"], "ex": "Alexander Magnus", "exT": "Alexander the Great" },
    { "c": "parvus, parva, parvum", "a": "small, little", "d": ["big, great", "few"] },
    { "c": "multus, multa, multum", "a": "much; (plural) many", "d": ["few", "whole"] },
    { "c": "longus, longa, longum", "a": "long", "d": ["short", "high"] },
    { "c": "altus, alta, altum", "a": "high; deep", "d": ["long; wide", "low; short"] },
    { "c": "novus, nova, novum", "a": "new", "d": ["old", "nine"] },
    { "c": "antiquus, antiqua, antiquum", "a": "old, ancient", "d": ["new", "strange"] },
    { "c": "laetus, laeta, laetum", "a": "happy, glad", "d": ["sad", "angry"] },
    { "c": "miser, misera, miserum", "a": "wretched, unhappy", "d": ["greedy", "happy"] },
    { "c": "pulcher, pulchra, pulchrum", "a": "beautiful", "d": ["ugly", "strong"], "ex": "Rosa pulchra est.", "exT": "The rose is beautiful." },
    { "c": "liber, libera, liberum", "a": "free", "d": ["enslaved", "dear"] },
    { "c": "albus, alba, album", "a": "white", "d": ["black", "red"] },
    { "c": "niger, nigra, nigrum", "a": "black", "d": ["white", "green"] },
    { "c": "ruber, rubra, rubrum", "a": "red", "d": ["blue", "yellow"] },
    { "c": "viridis, viride", "a": "green", "d": ["red", "blue"] },
    { "c": "caeruleus, caerulea, caeruleum", "a": "blue, sky-blue", "d": ["green", "white"] },
    { "c": "plenus, plena, plenum", "a": "full", "d": ["empty", "heavy"] },
    { "c": "carus, cara, carum", "a": "dear", "d": ["hateful", "free"] },
    { "c": "verus, vera, verum", "a": "true", "d": ["false", "new"] },
    { "c": "sanctus, sancta, sanctum", "a": "holy, sacred", "d": ["wicked", "ancient"] },
    { "c": "clarus, clara, clarum", "a": "bright; famous", "d": ["dark; unknown", "dear; beloved"] },
    { "c": "meus, mea, meum", "a": "my", "d": ["your (one person)", "our"], "ex": "Filia mea est Iulia.", "exT": "My daughter is Julia." },
    { "c": "tuus, tua, tuum", "a": "your (one person)", "d": ["my", "their"] },
    { "c": "noster, nostra, nostrum", "a": "our", "d": ["your (more than one)", "my"] },
