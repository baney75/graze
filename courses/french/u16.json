{
  "title": "Questions, connectors and frequency",
  "note": "A yes/no question can use rising intonation (Tu parles français ?), est-ce que (Est-ce que tu parles français ?), or inversion (Parles-tu français ?). Quel agrees with its noun: quel jour, quelle heure, quels livres, quelles villes. Frequency words usually go right after the verb: Je vais souvent au cinéma.",
  "src": { "t": "Français interactif, Chapitre 2 vocabulaire (mots interrogatifs, adverbes)", "u": "https://laits.utexas.edu/fi/voc/02/" },
  "items": [
    { "c": "où", "a": "where", "d": ["when", "or"], "ex": "Où habites-tu ?", "exT": "Where do you live?" },
    { "c": "quand", "a": "when", "d": ["where", "how much"] },
    { "c": "comment", "a": "how", "d": ["what", "why"] },
    { "c": "pourquoi", "a": "why", "d": ["because", "for whom"] },
    { "c": "parce que", "a": "because", "d": ["why", "so that"], "ex": "Je reste ici parce qu'il pleut.", "exT": "I'm staying here because it's raining." },
    { "c": "qui", "a": "who", "d": ["what", "which"] },
    { "c": "qu'est-ce que", "a": "what (as object)", "d": ["who (as object)", "where"] },
    { "c": "combien de", "a": "how many / how much", "d": ["how long", "how often"], "ex": "Combien de frères as-tu ?", "exT": "How many brothers do you have?" },
    { "c": "quel / quelle", "a": "which / what (+ noun)", "d": ["who / whom", "how many"] },
    { "c": "et", "a": "and", "d": ["or", "is"] },
    { "c": "mais", "a": "but", "d": ["more", "and"] },
    { "c": "ou", "a": "or", "d": ["where", "and"] },
    { "c": "donc", "a": "so / therefore", "d": ["but", "because"] },
    { "c": "aussi", "a": "also / too", "d": ["only", "already"] },
    { "c": "avec", "a": "with", "d": ["without", "for"] },
    { "c": "sans", "a": "without", "d": ["with", "since"] },
    { "c": "pour", "a": "for", "d": ["by", "with"] },
    { "c": "toujours", "a": "always", "d": ["never", "often"] },
    { "c": "souvent", "a": "often", "d": ["rarely", "always"] },
    { "c": "parfois", "a": "sometimes", "d": ["often", "never"] },
    { "c": "rarement", "a": "rarely", "d": ["often", "really"] },
    { "c": "ne ... jamais", "a": "never", "d": ["always", "not yet"], "ex": "Je ne bois jamais de café.", "exT": "I never drink coffee." },
    { "c": "d'habitude", "a": "usually", "d": ["never", "finally"] },
