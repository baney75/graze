    { "c": "___ âge as-tu ?", "a": "Quel", "d": ["Quelle", "Quels"] },
    { "c": "___ heure est-il ?", "a": "Quelle", "d": ["Quel", "Quelles"] },
    { "c": "Je ne mange ___ de viande. (never)", "a": "jamais", "d": ["pas", "toujours"] },
