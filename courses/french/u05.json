    { "c": "le sel", "a": "salt", "d": ["sugar", "pepper"] },
    { "c": "le petit déjeuner", "a": "breakfast", "d": ["lunch", "snack"], "ex": "Au petit déjeuner, je bois du café.", "exT": "At breakfast, I drink coffee." },
    { "c": "le déjeuner", "a": "lunch", "d": ["breakfast", "dinner"] },
    { "c": "le dîner", "a": "dinner", "d": ["lunch", "dessert"] },
    { "c": "J'ai faim.", "a": "I'm hungry.", "d": ["I'm thirsty.", "I'm full."] },
    { "c": "J'ai soif.", "a": "I'm thirsty.", "d": ["I'm hungry.", "I'm tired."] },
    { "c": "Je voudrais un café.", "a": "I would like a coffee.", "d": ["I'm drinking a coffee.", "I want to go to the café."] },
    { "c": "L'addition, s'il vous plaît.", "a": "The check, please.", "d": ["The menu, please.", "A table, please."] },
