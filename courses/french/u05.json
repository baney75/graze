    { "c": "le poisson", "a": "fish", "d": ["chicken", "meat"] },
    { "c": "le jambon", "a": "ham", "d": ["sausage", "bacon"] },
    { "c": "les légumes (m)", "a": "vegetables", "d": ["fruits", "spices"], "say": "les légumes" },
    { "c": "la pomme", "a": "apple", "d": ["pear", "potato"] },
    { "c": "la pomme de terre", "a": "potato", "d": ["apple", "tomato"], "ex": "Il mange des pommes de terre avec le poulet.", "exT": "He eats potatoes with the chicken." },
    { "c": "la fraise", "a": "strawberry", "d": ["raspberry", "cherry"] },
    { "c": "la salade", "a": "salad / lettuce", "d": ["soup", "sauce"] },
    { "c": "l'œuf (m)", "a": "egg", "d": ["oil", "onion"], "say": "l'œuf" },
    { "c": "le lait", "a": "milk", "d": ["tea", "water"] },
    { "c": "l'eau (f)", "a": "water", "d": ["milk", "wine"], "say": "l'eau" },
    { "c": "le café", "a": "coffee", "d": ["tea", "hot chocolate"] },
    { "c": "le thé", "a": "tea", "d": ["coffee", "juice"] },
    { "c": "le vin", "a": "wine", "d": ["beer", "water"] },
