  "read": {
    "title": "Au café",
    "text": [
      "— Salut, Inès ! Ça va ?",
      "— Salut, Paul ! Ça va bien, et toi ?",
      "— Pas mal. Désolé, je suis en retard. Il y a beaucoup de monde dans le métro.",
      "— Ce n'est pas grave. Qu'est-ce que tu prends ?",
      "— Un café. Et toi ?",
      "— Moi, un thé. Alors, Paul, tu es libre samedi soir ?",
      "— Samedi ? Oui, pourquoi ?",
      "— C'est mon anniversaire. Je fais une petite fête chez moi. Tu veux venir ?",
      "— Volontiers ! À quelle heure ?",
      "— À huit heures.",
      "— Ça marche ! Et bon anniversaire !"
    ],
    "q": [
      { "q": "Why does Paul apologize?", "o": ["He forgot her birthday", "He is late", "He can't come on Saturday"], "k": 1 },
      { "q": "What does Inès order?", "o": ["Coffee", "Orange juice", "Tea"], "k": 2 },
      { "q": "What is happening on Saturday evening?", "o": ["A party at Inès's place", "A trip to Paris", "A concert at the café"], "k": 0 }
    ]
  }
