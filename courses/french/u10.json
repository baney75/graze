{
  "title": "Places in town and directions",
  "note": "À + le contracts to au and à + les to aux; à la and à l' stay as they are: au cinéma, à la gare, à l'école, aux magasins. De contracts the same way: de + le = du, de + les = des, so près du parc but près de la gare.",
  "src": { "t": "Français interactif, Chapitre 6 vocabulaire", "u": "https://laits.utexas.edu/fi/voc/06/" },
  "items": [
    { "c": "la ville", "a": "town / city", "d": ["village", "countryside"] },
    { "c": "la rue", "a": "street", "d": ["bridge", "square"], "ex": "J'habite dans la rue Victor-Hugo.", "exT": "I live on Victor Hugo Street." },
    { "c": "la place", "a": "town square", "d": ["street", "palace"] },
    { "c": "le quartier", "a": "neighborhood", "d": ["quarter hour", "suburb"] },
    { "c": "le centre-ville", "a": "downtown", "d": ["suburbs", "mall"] },
    { "c": "la gare", "a": "train station", "d": ["garage", "airport"], "ex": "La gare est à dix minutes.", "exT": "The train station is ten minutes away." },
    { "c": "la banque", "a": "bank", "d": ["bench", "post office"] },
    { "c": "la poste", "a": "post office", "d": ["bank", "police station"] },
    { "c": "l'hôpital (m)", "a": "hospital", "d": ["hotel", "pharmacy"], "say": "l'hôpital" },
    { "c": "l'église (f)", "a": "church", "d": ["school", "town hall"], "say": "l'église" },
    { "c": "la mairie", "a": "town hall", "d": ["museum", "church"] },
    { "c": "le musée", "a": "museum", "d": ["movie theater", "library"] },
    { "c": "le cinéma", "a": "movie theater", "d": ["theater (plays)", "museum"] },
    { "c": "le magasin", "a": "store", "d": ["magazine", "market"] },
    { "c": "le supermarché", "a": "supermarket", "d": ["mall", "street market"] },
    { "c": "la boulangerie", "a": "bakery", "d": ["butcher shop", "pastry shop"], "ex": "J'achète une baguette à la boulangerie.", "exT": "I buy a baguette at the bakery." },
    { "c": "la pharmacie", "a": "pharmacy", "d": ["hospital", "grocery store"] },
    { "c": "la bibliothèque", "a": "library", "d": ["bookstore", "bookshelf"] },
    { "c": "la librairie", "a": "bookstore", "d": ["library", "stationery store"] },
    { "c": "le parc", "a": "park", "d": ["parking lot", "garden"] },
    { "c": "le pont", "a": "bridge", "d": ["river", "harbor"] },
    { "c": "à droite", "a": "to the right", "d": ["to the left", "straight ahead"] },
    { "c": "à gauche", "a": "to the left", "d": ["to the right", "behind"] },
    { "c": "tout droit", "a": "straight ahead", "d": ["right here", "to the right"], "ex": "Allez tout droit, puis tournez à droite.", "exT": "Go straight ahead, then turn right." },
    { "c": "près de", "a": "near", "d": ["far from", "behind"] },
    { "c": "loin de", "a": "far from", "d": ["near", "in front of"] },
    { "c": "en face de", "a": "across from", "d": ["next to", "behind"] },
    { "c": "à côté de", "a": "next to", "d": ["across from", "inside"] },
    { "c": "derrière", "a": "behind", "d": ["in front of", "between"] },
    { "c": "devant", "a": "in front of", "d": ["behind", "under"] },
    { "c": "Où est la gare, s'il vous plaît ?", "a": "Where is the train station, please?", "d": ["Is the train station far, please?", "When does the train leave, please?"] },
    { "c": "Tournez à gauche.", "a": "Turn left.", "d": ["Turn right.", "Keep going."] },
    { "c": "Je vais ___ cinéma.", "a": "au", "d": ["à le", "à la"] },
    { "c": "Nous allons ___ gare.", "a": "à la", "d": ["au", "à l'"] },
    { "c": "Elle va ___ magasins.", "a": "aux", "d": ["au", "à les"] },
    { "c": "La banque est près ___ parc.", "a": "du", "d": ["de le", "de la"], "ex": "La banque est près du parc.", "exT": "The bank is near the park." }
