{
  "title": "Work and school",
  "note": "After être, a bare profession takes no article: Elle est médecin, Il est avocat. Use c'est un/une when you add an adjective: C'est un bon médecin. Regular -ir verbs like finir add -is, -is, -it, -issons, -issez, -issent: je finis, nous finissons.",
  "src": { "t": "Français interactif, Chapitre 12 vocabulaire", "u": "https://laits.utexas.edu/fi/voc/12/" },
  "items": [
    { "c": "le travail", "a": "work / job", "d": ["trip", "company"], "ex": "Je vais au travail en métro.", "exT": "I go to work by subway." },
    { "c": "le bureau", "a": "office / desk", "d": ["store", "meeting"] },
    { "c": "l'entreprise (f)", "a": "company / business", "d": ["factory", "boss"], "say": "l'entreprise" },
    { "c": "le patron / la patronne", "a": "boss", "d": ["customer", "colleague"] },
    { "c": "le collègue / la collègue", "a": "coworker", "d": ["boss", "college"] },
    { "c": "le client / la cliente", "a": "customer / client", "d": ["salesperson", "boss"] },
    { "c": "le salaire", "a": "salary / pay", "d": ["salad", "tax"] },
    { "c": "le stage", "a": "internship", "d": ["stage (theater)", "final exam"] },
    { "c": "Elle est médecin.", "a": "She is a doctor.", "d": ["She is a nurse.", "She is at the doctor's."] },
    { "c": "l'infirmier / l'infirmière", "a": "nurse", "d": ["doctor", "pharmacist"] },
    { "c": "l'avocat / l'avocate", "a": "lawyer", "d": ["judge", "accountant"] },
    { "c": "l'ingénieur (m)", "a": "engineer", "d": ["mechanic", "architect"], "say": "l'ingénieur" },
    { "c": "le serveur / la serveuse", "a": "waiter / waitress", "d": ["cook", "cashier"] },
    { "c": "le vendeur / la vendeuse", "a": "salesperson", "d": ["buyer", "owner"] },
    { "c": "le cuisinier / la cuisinière", "a": "cook", "d": ["waiter", "baker"] },
    { "c": "le lycée", "a": "high school", "d": ["middle school", "college"] },
    { "c": "l'université (f)", "a": "university", "d": ["high school", "library"], "say": "l'université" },
    { "c": "le cours", "a": "class / course", "d": ["courtyard", "grade"], "ex": "J'ai un cours de chimie à dix heures.", "exT": "I have a chemistry class at ten." },
    { "c": "l'examen (m)", "a": "exam / test", "d": ["exercise", "lesson"], "say": "l'examen" },
    { "c": "les devoirs (m)", "a": "homework", "d": ["grades", "lessons"], "say": "les devoirs" },
    { "c": "le livre", "a": "book", "d": ["notebook", "newspaper"] },
    { "c": "le cahier", "a": "notebook", "d": ["book", "pencil case"] },
    { "c": "le stylo", "a": "pen", "d": ["pencil", "eraser"] },
    { "c": "l'ordinateur (m)", "a": "computer", "d": ["printer", "phone"], "say": "l'ordinateur" },
    { "c": "les maths (f)", "a": "math", "d": ["physics", "science"], "say": "les maths" },
    { "c": "l'histoire (f)", "a": "history / story", "d": ["geography", "literature"], "say": "l'histoire" },
    { "c": "la chimie", "a": "chemistry", "d": ["biology", "physics"] },
    { "c": "apprendre", "a": "to learn", "d": ["to understand", "to forget"] },
