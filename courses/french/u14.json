    { "c": "réussir un examen", "a": "to pass an exam", "d": ["to take an exam", "to fail an exam"], "ex": "Bravo, tu as réussi ton examen !", "exT": "Well done, you passed your exam!" },
    { "c": "Je ___ mes devoirs. (finir)", "a": "finis", "d": ["finit", "finissons"] },
    { "c": "Nous ___ à cinq heures. (finir)", "a": "finissons", "d": ["finissez", "finissent"] },
    { "c": "Vous ___ quel cours ? (choisir)", "a": "choisissez", "d": ["choisissons", "choisit"] },
