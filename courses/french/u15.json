{
  "title": "Weather, nature and seasons",
  "note": "Most weather expressions use il fait: il fait beau, il fait froid. Rain and snow have their own verbs: il pleut, il neige. With seasons, say en été, en automne, en hiver, but au printemps.",
  "src": { "t": "Français interactif, Chapitre 3 vocabulaire (le temps, les saisons)", "u": "https://laits.utexas.edu/fi/voc/03/" },
  "items": [
    { "c": "Quel temps fait-il ?", "a": "What's the weather like?", "d": ["What time is it?", "How long does it take?"], "ex": "Quel temps fait-il à Paris ?", "exT": "What's the weather like in Paris?" },
    { "c": "Il fait beau.", "a": "The weather is nice.", "d": ["The weather is bad.", "It's very hot."] },
    { "c": "Il fait mauvais.", "a": "The weather is bad.", "d": ["The weather is nice.", "It's cool out."] },
    { "c": "Il fait chaud.", "a": "It's hot out.", "d": ["It's cold out.", "It's cool out."] },
    { "c": "Il fait froid.", "a": "It's cold out.", "d": ["It's hot out.", "It's foggy."], "ex": "En hiver, il fait froid à Montréal.", "exT": "In winter, it's cold in Montreal." },
    { "c": "Il fait frais.", "a": "It's cool out.", "d": ["It's freezing.", "It's hot out."] },
    { "c": "Il pleut.", "a": "It's raining.", "d": ["It's snowing.", "It's crying."] },
    { "c": "Il neige.", "a": "It's snowing.", "d": ["It's raining.", "It's freezing."] },
    { "c": "Il y a du vent.", "a": "It's windy.", "d": ["It's sunny.", "It's cloudy."] },
    { "c": "Il y a du soleil.", "a": "It's sunny.", "d": ["It's windy.", "It's hot."] },
    { "c": "Il y a des nuages.", "a": "It's cloudy.", "d": ["It's stormy.", "It's foggy."] },
