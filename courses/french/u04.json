{
  "title": "Family",
  "note": "Possessives agree with the thing owned, not the owner: mon père, ma mère, mes parents. Son, sa, ses mean his or her, so sa mère is \"his mother\" or \"her mother.\" Before a vowel sound, use mon, ton, son even for a feminine noun: mon amie.",
  "src": { "t": "Français interactif, Chapitre 2 vocabulaire (la famille)", "u": "https://laits.utexas.edu/fi/voc/02/" },
  "items": [
    { "c": "la famille", "a": "family", "d": ["parents", "friends"] },
    { "c": "le père", "a": "father", "d": ["mother", "grandfather"] },
    { "c": "la mère", "a": "mother", "d": ["father", "aunt"] },
    { "c": "les parents (m)", "a": "parents", "d": ["grandparents", "children"], "say": "les parents" },
    { "c": "le frère", "a": "brother", "d": ["sister", "cousin"], "ex": "J'ai un frère et deux sœurs.", "exT": "I have one brother and two sisters." },
    { "c": "la sœur", "a": "sister", "d": ["brother", "niece"] },
    { "c": "le fils", "a": "son (male child)", "d": ["daughter", "nephew"] },
    { "c": "ma fille", "a": "my daughter", "d": ["my son", "my niece"], "ex": "Ma fille a six ans.", "exT": "My daughter is six." },
    { "c": "l'enfant (m/f)", "a": "child", "d": ["baby", "grandchild"], "say": "l'enfant" },
    { "c": "le bébé", "a": "baby", "d": ["child", "boy"] },
    { "c": "le mari", "a": "husband", "d": ["wife", "boyfriend"] },
    { "c": "ma femme", "a": "my wife", "d": ["my husband", "my sister"] },
    { "c": "le grand-père", "a": "grandfather", "d": ["father", "uncle"] },
    { "c": "la grand-mère", "a": "grandmother", "d": ["mother", "aunt"] },
    { "c": "les grands-parents (m)", "a": "grandparents", "d": ["parents", "grandchildren"], "say": "les grands-parents" },
    { "c": "les petits-enfants (m)", "a": "grandchildren", "d": ["grandparents", "cousins"], "say": "les petits-enfants" },
    { "c": "l'oncle (m)", "a": "uncle", "d": ["aunt", "nephew"], "say": "l'oncle" },
    { "c": "la tante", "a": "aunt", "d": ["uncle", "niece"], "ex": "Ma tante habite à Nice.", "exT": "My aunt lives in Nice." },
    { "c": "le cousin / la cousine", "a": "cousin", "d": ["nephew", "brother-in-law"] },
    { "c": "le neveu", "a": "nephew", "d": ["niece", "uncle"] },
    { "c": "la nièce", "a": "niece", "d": ["nephew", "aunt"] },
    { "c": "le chien", "a": "dog", "d": ["cat", "horse"] },
    { "c": "le chat", "a": "cat", "d": ["dog", "bird"] },
    { "c": "Tu as des frères et sœurs ?", "a": "Do you have brothers and sisters?", "d": ["Are your brothers and sisters here?", "Where are your brothers and sisters?"] },
    { "c": "Je suis fils unique.", "a": "I'm an only child. (male)", "d": ["I'm the oldest son.", "I'm a single father."] },
    { "c": "Il est marié.", "a": "He is married.", "d": ["He is single.", "He is my husband."] },
    { "c": "Elle est célibataire.", "a": "She is single.", "d": ["She is married.", "She is divorced."], "ex": "Ma sœur est célibataire.", "exT": "My sister is single." },
    { "c": "C'est ___ mère. (my)", "a": "ma", "d": ["mon", "mes"] },
    { "c": "___ frères sont grands. (my)", "a": "Mes", "d": ["Mon", "Ma"] },
    { "c": "C'est ___ amie Julie. (my)", "a": "mon", "d": ["ma", "mes"], "ex": "C'est mon amie Julie.", "exT": "This is my friend Julie." },
    { "c": "Paul aime ___ mère. (his)", "a": "sa", "d": ["son", "ses"] },
    { "c": "Marie aime ___ père. (her)", "a": "son", "d": ["sa", "ses"], "ex": "Marie aime son père.", "exT": "Marie loves her father." },
    { "c": "Ce sont ___ parents. (our)", "a": "nos", "d": ["notre", "vos"] }
  ]
