{
  "title": "Travel and transport",
  "note": "Use en for vehicles you ride inside (en train, en voiture, en avion) and à for walking or riding on top (à pied, à vélo). With places: à + city (à Paris), en + feminine country (en France), au + masculine country (au Canada), aux + plural country (aux États-Unis).",
  "src": { "t": "Français interactif, Chapitre 3 vocabulaire (les transports)", "u": "https://laits.utexas.edu/fi/voc/03/" },
  "items": [
    { "c": "le train", "a": "train", "d": ["tram", "bus"] },
    { "c": "l'avion (m)", "a": "plane", "d": ["boat", "train"], "say": "l'avion" },
    { "c": "la voiture", "a": "car", "d": ["bus", "truck"], "ex": "Nous partons en voiture.", "exT": "We're leaving by car." },
    { "c": "le bus", "a": "bus (city)", "d": ["subway", "taxi"] },
    { "c": "le métro", "a": "subway", "d": ["tram", "train station"] },
    { "c": "le vélo", "a": "bike", "d": ["motorcycle", "scooter"] },
    { "c": "le bateau", "a": "boat", "d": ["plane", "beach"] },
    { "c": "à pied", "a": "on foot", "d": ["by bike", "by car"], "ex": "Je vais à l'école à pied.", "exT": "I walk to school." },
    { "c": "le billet", "a": "ticket", "d": ["passport", "seat"] },
    { "c": "un aller simple", "a": "a one-way ticket", "d": ["a round-trip ticket", "a simple trip"] },
    { "c": "un aller-retour", "a": "a round-trip ticket", "d": ["a one-way ticket", "a monthly pass"] },
    { "c": "le quai", "a": "platform (train)", "d": ["ticket window", "track number"] },
    { "c": "l'aéroport (m)", "a": "airport", "d": ["train station", "harbor"], "say": "l'aéroport" },
    { "c": "le passeport", "a": "passport", "d": ["ticket", "driver's license"] },
    { "c": "la valise", "a": "suitcase", "d": ["backpack", "wallet"] },
    { "c": "l'hôtel (m)", "a": "hotel", "d": ["hospital", "hostel"], "say": "l'hôtel" },
    { "c": "le voyage", "a": "trip / journey", "d": ["vacation", "flight"] },
    { "c": "les vacances (f)", "a": "vacation", "d": ["trip", "weekend"], "say": "les vacances", "ex": "Bonnes vacances !", "exT": "Have a nice vacation!" },
    { "c": "la plage", "a": "beach", "d": ["sea", "page"] },
    { "c": "voyager", "a": "to travel", "d": ["to visit", "to drive"] },
    { "c": "partir", "a": "to leave", "d": ["to arrive", "to share"] },
    { "c": "arriver", "a": "to arrive", "d": ["to leave", "to reserve"] },
    { "c": "visiter", "a": "to visit (a place)", "d": ["to travel", "to see a friend"] },
    { "c": "À quelle heure part le train ?", "a": "What time does the train leave?", "d": ["What time does the train arrive?", "Which train goes to Paris?"] },
    { "c": "Je voudrais réserver une chambre.", "a": "I'd like to book a room.", "d": ["I'd like to clean my room.", "I'd like to see the room."] },
    { "c": "Je vais ___ France.", "a": "en", "d": ["au", "à"], "ex": "Je vais en France en juillet.", "exT": "I'm going to France in July." },
    { "c": "Il habite ___ Canada.", "a": "au", "d": ["en", "à"] },
    { "c": "Nous allons ___ Paris.", "a": "à", "d": ["en", "au"] },
    { "c": "Ils vont ___ États-Unis.", "a": "aux", "d": ["au", "en"] }
