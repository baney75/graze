{
  "title": "People, pronouns and être",
  "note": "Every noun is masculine (un, le) or feminine (une, la); l' replaces le or la before a vowel sound, so this course marks those nouns (m) or (f). Être (to be) is irregular: je suis, tu es, il/elle/on est, nous sommes, vous êtes, ils/elles sont.",
  "src": { "t": "French OER 1, Unité 1 - Bonjour !", "u": "https://human.libretexts.org/Courses/Mount_Saint_Mary's_University_LA/French_OER_1_(Carrasco_Zahedi_and_Parrish)/01%3A_Unite_1_-_Bonjour" },
  "items": [
    { "c": "je", "a": "I", "d": ["you", "we"] },
    { "c": "tu", "a": "you (one person, informal)", "d": ["you (formal or plural)", "we (informal)"] },
    { "c": "il", "a": "he", "d": ["she", "they"] },
    { "c": "elle", "a": "she", "d": ["he", "we"] },
    { "c": "nous", "a": "we", "d": ["you (plural)", "they"] },
    { "c": "vous", "a": "you (formal or plural)", "d": ["you (one person, informal)", "we"] },
    { "c": "ils", "a": "they (masculine or mixed group)", "d": ["they (all feminine)", "we (informal)"], "ex": "Paul et Marie ? Ils sont à Paris.", "exT": "Paul and Marie? They are in Paris." },
    { "c": "elles", "a": "they (all feminine)", "d": ["they (masculine or mixed group)", "she"] },
    { "c": "on", "a": "we (informal) / one", "d": ["they (all feminine)", "you (formal)"], "ex": "On est en retard !", "exT": "We're late!" },
    { "c": "moi", "a": "me", "d": ["you", "him"], "ex": "Moi, je suis de Lyon.", "exT": "Me, I'm from Lyon." },
    { "c": "Et toi ?", "a": "And you? (informal)", "d": ["And him?", "And me?"] },
    { "c": "Moi aussi.", "a": "Me too.", "d": ["Me neither.", "Not me."] },
    { "c": "un homme", "a": "a man", "d": ["a woman", "a boy"] },
    { "c": "une femme", "a": "a woman", "d": ["a man", "a girl"] },
    { "c": "un garçon", "a": "a boy", "d": ["a girl", "a man"] },
    { "c": "une fille", "a": "a girl", "d": ["a boy", "a woman"] },
    { "c": "un ami", "a": "a friend (male)", "d": ["a brother", "a neighbor"] },
    { "c": "une amie", "a": "a friend (female)", "d": ["a sister", "a neighbor (female)"] },
    { "c": "un étudiant", "a": "a student (male, college)", "d": ["a teacher", "a classroom"] },
    { "c": "un professeur", "a": "a teacher / professor", "d": ["a student", "a doctor"], "ex": "Madame Roy est professeur.", "exT": "Mrs. Roy is a teacher." },
    { "c": "Qui est-ce ?", "a": "Who is it?", "d": ["What is it?", "Where is it?"] },
    { "c": "Qu'est-ce que c'est ?", "a": "What is it?", "d": ["Who is it?", "How is it?"], "ex": "Qu'est-ce que c'est ? — C'est un livre.", "exT": "What is it? — It's a book." },
    { "c": "Voici Marie.", "a": "Here is Marie. / This is Marie.", "d": ["Marie is coming.", "Marie is here today."] },
    { "c": "Tu es d'où ?", "a": "Where are you from?", "d": ["Where are you going?", "Who are you?"] },
    { "c": "Je suis de Montréal.", "a": "I'm from Montreal.", "d": ["I live near Montreal.", "I'm going to Montreal."] },
    { "c": "américain / américaine", "a": "American", "d": ["English", "Canadian"] },
    { "c": "français / française", "a": "French", "d": ["Belgian", "Swiss"], "ex": "Elle est française.", "exT": "She is French." },
    { "c": "anglais / anglaise", "a": "English", "d": ["German", "Belgian"] },
    { "c": "allemand / allemande", "a": "German", "d": ["English", "Spanish"] },
    { "c": "Je ___ étudiant. (être)", "a": "suis", "d": ["es", "est"] },
    { "c": "Tu ___ d'où ? (être)", "a": "es", "d": ["est", "êtes"] },
    { "c": "Nous ___ à Paris. (être)", "a": "sommes", "d": ["êtes", "sont"] },
    { "c": "Vous ___ canadien ? (être)", "a": "êtes", "d": ["sommes", "est"] },
    { "c": "Elles ___ françaises. (être)", "a": "sont", "d": ["est", "sommes"], "ex": "Elles sont françaises.", "exT": "They are French." }
  ]
