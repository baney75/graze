{
  "title": "The past: passé composé",
  "note": "The passé composé is avoir or être in the present + a past participle: j'ai mangé, elle est partie. Most verbs use avoir. Verbs of coming and going (aller, venir, arriver, partir, entrer, sortir, rester, naître, mourir...) and reflexive verbs use être, and then the participle usually agrees with the subject. Negation wraps the helper: Je n'ai pas mangé.",
  "src": { "t": "Tex's French Grammar, tense and mood (passé composé)", "u": "https://laits.utexas.edu/tex/gr/ta1.html" },
  "items": [
    { "c": "hier soir", "a": "last night", "d": ["tomorrow night", "tonight"] },
    { "c": "ce matin", "a": "this morning", "d": ["every morning", "tomorrow morning"] },
    { "c": "la semaine dernière", "a": "last week", "d": ["next week", "this week"] },
    { "c": "l'année dernière (f)", "a": "last year", "d": ["next year", "every year"], "say": "l'année dernière" },
    { "c": "il y a deux jours", "a": "two days ago", "d": ["in two days", "for two days"], "ex": "Je suis arrivé il y a deux jours.", "exT": "I arrived two days ago." },
    { "c": "déjà", "a": "already", "d": ["again", "not yet"] },
    { "c": "pas encore", "a": "not yet", "d": ["no more", "never again"] },
    { "c": "d'abord", "a": "first (of all)", "d": ["finally", "afterward"] },
    { "c": "ensuite", "a": "then / next", "d": ["first", "before"] },
    { "c": "enfin", "a": "finally / at last", "d": ["at first", "again"] },
    { "c": "J'ai mangé une pizza.", "a": "I ate a pizza.", "d": ["I'm eating a pizza.", "I'm going to eat a pizza."] },
    { "c": "Nous avons vu un film.", "a": "We saw a movie.", "d": ["We see a movie.", "We'll see a movie."] },
    { "c": "Elle est allée à Paris.", "a": "She went to Paris.", "d": ["She is going to Paris.", "She lives in Paris."], "ex": "L'été dernier, elle est allée à Paris.", "exT": "Last summer, she went to Paris." },
    { "c": "Ils sont arrivés hier.", "a": "They arrived yesterday.", "d": ["They arrive tomorrow.", "They are here today."] },
    { "c": "J'ai pris le train.", "a": "I took the train.", "d": ["I missed the train.", "I'm taking the train."] },
    { "c": "Qu'est-ce que tu as fait ?", "a": "What did you do?", "d": ["What are you doing?", "What will you do?"], "ex": "Qu'est-ce que tu as fait samedi ?", "exT": "What did you do on Saturday?" },
    { "c": "Je n'ai pas compris.", "a": "I didn't understand.", "d": ["I don't understand yet.", "I didn't hear."] },
    { "c": "Il a fait beau.", "a": "The weather was nice.", "d": ["The weather is nice.", "He did well."] },
    { "c": "Tu as bien dormi ?", "a": "Did you sleep well?", "d": ["Are you sleeping well?", "Did you eat well?"] },
    { "c": "Je suis né en 2005.", "a": "I was born in 2005.", "d": ["I moved in 2005.", "I graduated in 2005."], "say": "Je suis né en deux mille cinq." },
    { "c": "J'___ mangé une pomme.", "a": "ai", "d": ["suis", "as"] },
    { "c": "Ils ___ allés au cinéma.", "a": "sont", "d": ["ont", "avons"] },
    { "c": "Nous ___ restés à la maison.", "a": "sommes", "d": ["avons", "êtes"] },
    { "c": "J'ai ___ mes devoirs. (faire)", "a": "fait", "d": ["faisé", "fais"] },
    { "c": "Tu as ___ ce film ? (voir)", "a": "vu", "d": ["voyé", "vois"] },
    { "c": "Nous avons ___ du café. (boire)", "a": "bu", "d": ["buvé", "boit"] },
    { "c": "Elle a ___ le bus. (prendre)", "a": "pris", "d": ["prendu", "prend"] },
    { "c": "J'ai ___ une lettre. (écrire)", "a": "écrit", "d": ["écrivé", "écris"] },
    { "c": "Marie est ___ hier. (partir)", "a": "partie", "d": ["parti", "partis"], "ex": "Marie est partie hier matin.", "exT": "Marie left yesterday morning." },
    { "c": "J'ai ___ peur. (avoir)", "a": "eu", "d": ["avu", "été"] }
  ]
}
