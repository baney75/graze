    { "c": "Je ne parle pas anglais.", "a": "I don't speak English.", "d": ["I speak a little English.", "I'm not English."] },
    { "c": "Je n'aime pas le café.", "a": "I don't like coffee.", "d": ["I love coffee.", "I don't have coffee."], "ex": "Je n'aime pas le café, je préfère le thé.", "exT": "I don't like coffee; I prefer tea." },
    { "c": "Nous ___ français. (parler)", "a": "parlons", "d": ["parlez", "parlent"] },
    { "c": "Ils ___ à Lyon. (habiter)", "a": "habitent", "d": ["habitons", "habitez"], "ex": "Mes parents habitent à Lyon.", "exT": "My parents live in Lyon." },
    { "c": "Tu ___ la télé ? (regarder)", "a": "regardes", "d": ["regarde", "regardez"] },
