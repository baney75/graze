    { "c": "écouter", "a": "to listen to", "d": ["to hear", "to watch"] },
    { "c": "chercher", "a": "to look for", "d": ["to find", "to look at"] },
    { "c": "trouver", "a": "to find", "d": ["to look for", "to lose"] },
    { "c": "jouer", "a": "to play", "d": ["to win", "to sing"] },
