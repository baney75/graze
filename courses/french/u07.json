{
  "title": "Colors and describing things",
  "note": "Adjectives agree with the noun: add -e for feminine and -s for plural (un livre vert, une voiture verte, des livres verts). Most follow the noun, but a few short common ones come before it: beau, joli, bon, mauvais, grand, petit, jeune, vieux, nouveau. Before a masculine vowel sound, beau, vieux, nouveau become bel, vieil, nouvel.",
  "src": { "t": "Français interactif, Chapitre 4 vocabulaire", "u": "https://laits.utexas.edu/fi/voc/04/" },
  "items": [
    { "c": "rouge", "a": "red", "d": ["pink", "orange"], "ex": "J'ai une voiture rouge.", "exT": "I have a red car." },
    { "c": "bleu / bleue", "a": "blue", "d": ["green", "gray"] },
    { "c": "vert / verte", "a": "green", "d": ["blue", "yellow"] },
    { "c": "jaune", "a": "yellow", "d": ["orange", "white"] },
    { "c": "noir / noire", "a": "black", "d": ["brown", "gray"] },
    { "c": "blanc / blanche", "a": "white", "d": ["black", "beige"] },
    { "c": "gris / grise", "a": "gray", "d": ["green", "white"] },
    { "c": "marron", "a": "brown", "d": ["purple", "red"], "ex": "Il a les yeux marron.", "exT": "He has brown eyes." },
    { "c": "rose", "a": "pink", "d": ["red", "purple"] },
    { "c": "violet / violette", "a": "purple", "d": ["pink", "blue"] },
    { "c": "la couleur", "a": "color", "d": ["shape", "size"] },
    { "c": "grand / grande", "a": "big / tall", "d": ["small / short", "fat"] },
    { "c": "petit / petite", "a": "small / short", "d": ["big / tall", "thin"], "ex": "Ma sœur est petite.", "exT": "My sister is short." },
    { "c": "beau / belle", "a": "beautiful / handsome", "d": ["ugly", "young"] },
    { "c": "joli / jolie", "a": "pretty", "d": ["ugly", "funny"] },
    { "c": "jeune", "a": "young", "d": ["old", "new"] },
    { "c": "vieux / vieille", "a": "old", "d": ["young", "new"] },
    { "c": "nouveau / nouvelle", "a": "new", "d": ["old", "next"], "ex": "C'est mon nouveau téléphone.", "exT": "It's my new phone." },
    { "c": "bon / bonne", "a": "good", "d": ["bad", "pretty"] },
    { "c": "mauvais / mauvaise", "a": "bad", "d": ["good", "sad"] },
    { "c": "intéressant / intéressante", "a": "interesting", "d": ["boring", "interested"] },
    { "c": "ennuyeux / ennuyeuse", "a": "boring", "d": ["interesting", "annoyed"] },
    { "c": "facile", "a": "easy", "d": ["difficult", "fast"] },
    { "c": "difficile", "a": "difficult", "d": ["easy", "different"] },
    { "c": "gentil / gentille", "a": "kind / nice", "d": ["mean", "shy"] },
    { "c": "drôle", "a": "funny", "d": ["sad", "serious"] },
    { "c": "sérieux / sérieuse", "a": "serious", "d": ["funny", "lazy"] },
    { "c": "une voiture ___ (vert)", "a": "verte", "d": ["vert", "verts"] },
    { "c": "des chaussures ___ (noir)", "a": "noires", "d": ["noirs", "noire"], "ex": "J'ai des chaussures noires.", "exT": "I have black shoes." },
    { "c": "une ___ maison (beau)", "a": "belle", "d": ["beau", "bel"] },
    { "c": "un ___ ami (vieux)", "a": "vieil", "d": ["vieux", "vieille"], "ex": "C'est un vieil ami.", "exT": "He's an old friend." },
    { "c": "une ___ ville (grand)", "a": "grande", "d": ["grand", "grands"] },
    { "c": "Elles sont ___. (gentil)", "a": "gentilles", "d": ["gentils", "gentille"] }
  ]
}
