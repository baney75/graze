{
  "title": "Family, haben and possessives",
  "note": "haben (to have): ich habe, du hast, er/sie/es hat, wir haben, ihr habt, sie/Sie haben. Possessives take the same endings as kein: mein Vater, meine Mutter, mein Kind, meine Eltern. After haben, a masculine noun shows the accusative: Ich habe einen Bruder.",
  "src": { "t": "Deutsch im Blick, Kapitel 5: Die Familie; Grimm Grammar: Possessive determiners", "u": "https://coerll.utexas.edu/gg/gr/det_04.html" },
  "items": [
    { "c": "die Familie", "a": "the family", "d": ["the parents", "the siblings"], "ex": "Pl. die Familien: Meine Familie ist groß.", "exT": "My family is big." },
    { "c": "die Mutter", "a": "the mother", "d": ["the daughter", "the aunt"], "ex": "Pl. die Mütter" },
    { "c": "der Vater", "a": "the father", "d": ["the uncle", "the brother"], "ex": "Pl. die Väter" },
    { "c": "die Eltern", "a": "the parents", "d": ["the grandparents", "the siblings"], "ex": "Meine Eltern wohnen in Bonn. (plural only)", "exT": "My parents live in Bonn." },
    { "c": "das Kind", "a": "the child", "d": ["the girl", "the grandchild"], "ex": "Pl. die Kinder: Wir haben zwei Kinder.", "exT": "We have two children." },
    { "c": "der Sohn", "a": "the son", "d": ["the brother", "the nephew"], "ex": "Pl. die Söhne" },
    { "c": "die Tochter", "a": "the daughter", "d": ["the sister", "the mother"], "ex": "Pl. die Töchter" },
    { "c": "der Bruder", "a": "the brother", "d": ["the son", "the cousin"], "ex": "Pl. die Brüder" },
    { "c": "die Schwester", "a": "the sister", "d": ["the daughter", "the aunt"], "ex": "Pl. die Schwestern" },
    { "c": "die Geschwister", "a": "the siblings", "d": ["the parents", "the cousins"], "ex": "Hast du Geschwister?", "exT": "Do you have any siblings?" },
    { "c": "die Großmutter", "a": "the grandmother", "d": ["the aunt", "the mother-in-law"] },
    { "c": "der Großvater", "a": "the grandfather", "d": ["the uncle", "the father-in-law"] },
    { "c": "die Großeltern", "a": "the grandparents", "d": ["the parents", "the great-grandchildren"] },
    { "c": "der Onkel", "a": "the uncle", "d": ["the grandfather", "the nephew"] },
    { "c": "die Tante", "a": "the aunt", "d": ["the niece", "the grandmother"] },
    { "c": "mein Mann", "a": "my husband", "d": ["my son", "my uncle"], "ex": "Das ist mein Mann, Peter.", "exT": "This is my husband, Peter." },
    { "c": "verheiratet", "a": "married", "d": ["single", "engaged"] },
    { "c": "ich habe", "a": "I have", "d": ["I am", "he has"] },
    { "c": "du hast", "a": "you have (informal)", "d": ["you are (informal)", "we have"] },
    { "c": "er hat", "a": "he has", "d": ["he is", "I have"] },
    { "c": "Ich habe keine Geschwister.", "a": "I have no siblings.", "d": ["I have two siblings.", "I have many siblings."] },
    { "c": "unser Haus", "a": "our house", "d": ["your house", "their house"] },
    { "c": "sein Bruder", "a": "his brother", "d": ["her brother", "your brother"] },
    { "c": "Anna und ihr Bruder", "a": "Anna and her brother", "d": ["Anna and his brother", "Anna and our brother"] },
    { "c": "Ich habe ___ Bruder. (a)", "a": "einen", "d": ["ein", "eine"], "ex": "Ich habe einen Bruder und eine Schwester.", "exT": "I have a brother and a sister." },
    { "c": "Hast du ___ Schwester? (a)", "a": "eine", "d": ["einen", "ein"] },
    { "c": "Das ist ___ Vater. (my)", "a": "mein", "d": ["meine", "meinen"] },
    { "c": "Das sind ___ Eltern. (my)", "a": "meine", "d": ["mein", "meiner"] },
    { "c": "Wie heißt ___ Mutter? (your, informal)", "a": "deine", "d": ["dein", "deinen"] },
    { "c": "Wir ___ zwei Kinder. (haben)", "a": "haben", "d": ["habt", "hat"] },
    { "c": "___ ihr einen Hund? (haben)", "a": "Habt", "d": ["Haben", "Hast"] }
  ]
}
