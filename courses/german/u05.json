{
  "title": "Food, drink and the accusative",
  "note": "The direct object is in the accusative case. Only masculine forms change: der becomes den, ein becomes einen, kein becomes keinen. Die, das and plurals stay the same. To order politely, say Ich möchte ... (I would like ...).",
  "src": { "t": "Grimm Grammar: Der Akkusativ", "u": "https://coerll.utexas.edu/gg/gr/cas_03.html" },
  "items": [
    { "c": "das Essen", "a": "the food; the meal", "d": ["the drink; the beverage", "the kitchen; the stove"], "ex": "Das Essen ist lecker.", "exT": "The food is delicious." },
    { "c": "das Wasser", "a": "the water", "d": ["the juice", "the milk"], "ex": "Ein Glas Wasser, bitte.", "exT": "A glass of water, please." },
    { "c": "das Brot", "a": "the bread", "d": ["the cheese", "the butter"], "ex": "Pl. die Brote" },
    { "c": "das Brötchen", "a": "the bread roll", "d": ["the cake", "the cookie"], "ex": "Pl. die Brötchen: Ich kaufe vier Brötchen.", "exT": "I'm buying four rolls." },
    { "c": "der Apfel", "a": "the apple", "d": ["the pear", "the potato"], "ex": "Pl. die Äpfel" },
    { "c": "die Milch", "a": "the milk", "d": ["the water", "the cream"] },
    { "c": "der Kaffee", "a": "the coffee", "d": ["the tea", "the cake"] },
    { "c": "der Tee", "a": "the tea", "d": ["the coffee", "the soup"] },
    { "c": "der Saft", "a": "the juice", "d": ["the soup", "the wine"], "ex": "Pl. die Säfte: Ich trinke einen Apfelsaft.", "exT": "I'm drinking an apple juice." },
    { "c": "der Käse", "a": "the cheese", "d": ["the butter", "the sausage"] },
    { "c": "die Wurst", "a": "the sausage", "d": ["the cheese", "the soup"], "ex": "Pl. die Würste" },
    { "c": "das Fleisch", "a": "the meat", "d": ["the fish", "the vegetables"] },
    { "c": "der Fisch", "a": "the fish", "d": ["the meat", "the chicken"], "ex": "Pl. die Fische" },
    { "c": "das Ei", "a": "the egg", "d": ["the onion", "the roll"], "ex": "Pl. die Eier: Ich brauche sechs Eier.", "exT": "I need six eggs." },
    { "c": "die Kartoffel", "a": "the potato", "d": ["the tomato", "the apple"], "ex": "Pl. die Kartoffeln" },
    { "c": "das Gemüse", "a": "the vegetables", "d": ["the fruit", "the meat"] },
    { "c": "das Obst", "a": "the fruit", "d": ["the vegetables", "the bread"], "ex": "Obst ist gesund.", "exT": "Fruit is healthy." },
    { "c": "das Frühstück", "a": "the breakfast", "d": ["the lunch", "the dinner"] },
    { "c": "das Mittagessen", "a": "the lunch", "d": ["the breakfast", "the dessert"] },
    { "c": "das Abendessen", "a": "the dinner, the supper", "d": ["the lunch", "the breakfast"] },
    { "c": "Ich habe Hunger.", "a": "I'm hungry.", "d": ["I'm thirsty.", "I'm full."] },
    { "c": "Ich habe Durst.", "a": "I'm thirsty.", "d": ["I'm hungry.", "I'm tired."] },
    { "c": "Ich möchte einen Kaffee, bitte.", "a": "I'd like a coffee, please.", "d": ["I'd like a tea, please.", "I don't want coffee, thanks."] },
    { "c": "Guten Appetit!", "a": "Enjoy your meal!", "d": ["Cheers!", "Good luck!"] },
    { "c": "lecker", "a": "delicious, tasty", "d": ["salty", "spoiled"] },
    { "c": "Die Rechnung, bitte.", "a": "The check, please.", "d": ["The menu, please.", "A table, please."] },
    { "c": "Ich esse ___ Apfel. (a)", "a": "einen", "d": ["ein", "eine"], "ex": "Ich esse einen Apfel.", "exT": "I'm eating an apple." },
    { "c": "Er trinkt ___ Milch. (the)", "a": "die", "d": ["den", "der"] },
    { "c": "Wir kaufen ___ Käse. (the)", "a": "den", "d": ["der", "dem"], "ex": "Der Käse ist gut. Wir kaufen den Käse.", "exT": "The cheese is good. We're buying the cheese." },
    { "c": "Ich möchte ___ Ei. (a)", "a": "ein", "d": ["einen", "eine"] },
    { "c": "Ich habe ___ Hunger. (no)", "a": "keinen", "d": ["kein", "keine"], "ex": "Danke, ich habe keinen Hunger.", "exT": "Thanks, I'm not hungry." }
  ]
}
