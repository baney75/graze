{
  "title": "Travel, transport and two-way prepositions",
  "note": "An, auf, hinter, in, neben, über, unter, vor and zwischen take the accusative for movement toward a place (wohin?) and the dative for location (wo?): Ich lege den Koffer auf das Bett. Der Koffer liegt auf dem Bett. Use nach with most countries and cities: nach Berlin.",
  "src": { "t": "Grimm Grammar: Two-way prepositions; Deutsch im Blick, Kapitel 6", "u": "https://coerll.utexas.edu/gg/gr/cas_09.html" },
  "items": [
    { "c": "der Zug", "a": "the train", "d": ["the bus", "the plane"], "ex": "Pl. die Züge: Der Zug ist pünktlich.", "exT": "The train is on time." },
    { "c": "der Bus", "a": "the bus", "d": ["the train", "the taxi"], "ex": "Pl. die Busse" },
    { "c": "das Auto", "a": "the car", "d": ["the bike", "the bus"], "ex": "Pl. die Autos" },
    { "c": "das Flugzeug", "a": "the airplane", "d": ["the airport", "the ship"], "ex": "Pl. die Flugzeuge" },
    { "c": "der Flughafen", "a": "the airport", "d": ["the harbor", "the airplane"], "ex": "Pl. die Flughäfen" },
    { "c": "das Fahrrad", "a": "the bicycle", "d": ["the motorcycle", "the car"], "ex": "Pl. die Fahrräder: Ich fahre mit dem Fahrrad.", "exT": "I'm going by bike." },
    { "c": "die U-Bahn", "a": "the subway", "d": ["the streetcar", "the highway"] },
    { "c": "die Fahrkarte", "a": "the ticket (for travel)", "d": ["the map", "the timetable"], "ex": "Pl. die Fahrkarten" },
    { "c": "die Haltestelle", "a": "the (bus or tram) stop", "d": ["the platform", "the parking lot"] },
    { "c": "das Gleis", "a": "the track, the platform", "d": ["the ticket", "the stop"], "ex": "Der Zug fährt von Gleis 3.", "exT": "The train leaves from track 3." },
    { "c": "die Reise", "a": "the trip, the journey", "d": ["the vacation", "the rice"], "ex": "Gute Reise!", "exT": "Have a good trip!" },
    { "c": "reisen", "a": "to travel", "d": ["to tear", "to ride"] },
    { "c": "der Urlaub", "a": "the vacation", "d": ["the trip", "the weekend"], "ex": "Wir machen Urlaub in Italien.", "exT": "We're vacationing in Italy." },
    { "c": "der Koffer", "a": "the suitcase", "d": ["the backpack", "the coffee"], "ex": "Pl. die Koffer" },
    { "c": "der Pass", "a": "the passport", "d": ["the ticket", "the ID card"] },
    { "c": "das Land", "a": "the country; the countryside", "d": ["the city; downtown", "the coast; the beach"], "ex": "Pl. die Länder: Deutschland ist ein großes Land.", "exT": "Germany is a big country." },
    { "c": "abfahren", "a": "to depart, to leave", "d": ["to arrive", "to change trains"], "ex": "Der Zug fährt um neun Uhr ab.", "exT": "The train leaves at nine." },
    { "c": "ankommen", "a": "to arrive", "d": ["to depart", "to come along"] },
    { "c": "umsteigen", "a": "to change (trains, buses)", "d": ["to get in", "to arrive"] },
    { "c": "hin und zurück", "a": "round trip", "d": ["one way", "nonstop"] },
    { "c": "Wann fährt der nächste Zug?", "a": "When does the next train leave?", "d": ["Where is the next train?", "How long is the trip?"] },
    { "c": "Ich lege den Koffer auf ___ Bett. (the)", "a": "das", "d": ["dem", "den"] },
    { "c": "Der Koffer liegt auf ___ Bett. (the)", "a": "dem", "d": ["das", "den"], "ex": "Der Koffer liegt auf dem Bett.", "exT": "The suitcase is lying on the bed." },
    { "c": "Ich fahre ___ Deutschland. (to)", "a": "nach", "d": ["zu", "bei"] },
    { "c": "Wir fahren ___ Schweiz. (to the)", "a": "in die", "d": ["nach", "zur"] },
    { "c": "Ich gehe ___ Kino. (in + das)", "a": "ins", "d": ["im", "in dem"] },
    { "c": "Ich bin ___ Kino. (in + dem)", "a": "im", "d": ["ins", "in das"] },
    { "c": "Der Zug fährt um neun Uhr ___. (abfahren)", "a": "ab", "d": ["an", "auf"] },
    { "c": "Wir kommen um acht ___. (ankommen)", "a": "an", "d": ["ab", "um"] },
    { "c": "Das Bild hängt an ___ Wand. (the, die Wand)", "a": "der", "d": ["die", "den"] }
  ]
}
