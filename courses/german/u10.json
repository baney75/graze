{
  "title": "Home and household",
  "note": "Learn every noun with its article and plural, because plurals vary: das Zimmer, die Zimmer; der Stuhl, die Stühle; das Haus, die Häuser; die Tür, die Türen. Separable verbs split: aufräumen → Ich räume mein Zimmer auf. The prefix goes to the end.",
  "src": { "t": "Deutsch im Blick, Kapitel 2: In der Wohnung", "u": "https://coerll.utexas.edu/dib/voc.php?k=2&s=7" },
  "items": [
    { "c": "das Haus", "a": "the house", "d": ["the apartment", "the garden"], "ex": "Pl. die Häuser: Das Haus ist alt.", "exT": "The house is old." },
    { "c": "die Wohnung", "a": "the apartment", "d": ["the house", "the room"], "ex": "Pl. die Wohnungen: Meine Wohnung hat drei Zimmer.", "exT": "My apartment has three rooms." },
    { "c": "das Zimmer", "a": "the room", "d": ["the kitchen", "the floor"], "ex": "Pl. die Zimmer" },
    { "c": "die Küche", "a": "the kitchen", "d": ["the bathroom", "the cake"], "ex": "Pl. die Küchen" },
    { "c": "das Badezimmer", "a": "the bathroom", "d": ["the bedroom", "the kitchen"] },
    { "c": "das Schlafzimmer", "a": "the bedroom", "d": ["the living room", "the bathroom"] },
    { "c": "das Wohnzimmer", "a": "the living room", "d": ["the bedroom", "the dining room"] },
    { "c": "der Tisch", "a": "the table", "d": ["the chair", "the desk lamp"], "ex": "Pl. die Tische" },
    { "c": "der Stuhl", "a": "the chair", "d": ["the table", "the bed"], "ex": "Pl. die Stühle" },
    { "c": "das Bett", "a": "the bed", "d": ["the sofa", "the bath"], "ex": "Pl. die Betten" },
    { "c": "die Tür", "a": "the door", "d": ["the window", "the wall"], "ex": "Pl. die Türen: Die Tür ist offen.", "exT": "The door is open." },
    { "c": "das Fenster", "a": "the window", "d": ["the door", "the floor"], "ex": "Pl. die Fenster" },
    { "c": "der Schrank", "a": "the cupboard, the wardrobe", "d": ["the shelf", "the drawer"], "ex": "Pl. die Schränke" },
    { "c": "der Kühlschrank", "a": "the refrigerator", "d": ["the stove", "the dishwasher"] },
    { "c": "die Lampe", "a": "the lamp", "d": ["the clock", "the plug"] },
    { "c": "der Garten", "a": "the garden, the yard", "d": ["the balcony", "the garage"], "ex": "Pl. die Gärten" },
    { "c": "die Treppe", "a": "the stairs, the staircase", "d": ["the elevator", "the hallway"] },
    { "c": "der Schlüssel", "a": "the key", "d": ["the lock", "the door"], "ex": "Wo ist mein Schlüssel?", "exT": "Where is my key?" },
    { "c": "die Miete", "a": "the rent", "d": ["the deposit", "the bill"] },
    { "c": "putzen", "a": "to clean", "d": ["to cook", "to paint"] },
    { "c": "aufräumen", "a": "to tidy up", "d": ["to get up", "to open up"], "ex": "Ich räume mein Zimmer auf.", "exT": "I'm tidying up my room." },
    { "c": "Es gibt einen Garten.", "a": "There is a garden.", "d": ["It gives a garden.", "There was a garden."] },
    { "c": "Die Wohnung ist klein, aber schön.", "a": "The apartment is small but nice.", "d": ["The apartment is big and nice.", "The room is small and dark."] },
    { "c": "Ich ___ mein Zimmer auf. (aufräumen)", "a": "räume", "d": ["aufräume", "räumt"] },
    { "c": "Mach bitte das Fenster ___! (open)", "a": "auf", "d": ["an", "ab"] },
    { "c": "Es gibt ___ Tisch und zwei Stühle. (a)", "a": "einen", "d": ["ein", "einem"] },
    { "c": "zwei ___ (das Zimmer)", "a": "Zimmer", "d": ["Zimmern", "Zimmers"] },
    { "c": "drei ___ (der Stuhl)", "a": "Stühle", "d": ["Stuhle", "Stühlen"] },
    { "c": "zwei ___ (das Haus)", "a": "Häuser", "d": ["Hause", "Hausen"] },
    { "c": "vier ___ (die Tür)", "a": "Türen", "d": ["Tür", "Türs"] }
  ]
}
