    { "c": "Gut, danke.", "a": "Fine, thanks.", "d": ["Not well, sadly.", "Good night, thanks."], "ex": "Wie geht's? – Gut, danke. Und dir?", "exT": "How's it going? – Fine, thanks. And you?" },
    { "c": "Freut mich!", "a": "Pleased to meet you!", "d": ["Excuse me!", "Same to you!"] },
