{
  "title": "Colors, describing things and adjective endings",
  "note": "After sein an adjective has no ending: Der Hund ist groß. Before a noun it takes one. In the nominative: der große Hund, die große Stadt, das große Haus; but ein großer Hund, eine große Stadt, ein großes Haus. With ein, the ending shows the gender.",
  "src": { "t": "Grimm Grammar: Adjective endings", "u": "https://coerll.utexas.edu/gg/gr/adj_01.html" },
  "items": [
    { "c": "die Farbe", "a": "the color", "d": ["the shape", "the size"], "ex": "Pl. die Farben: Meine Lieblingsfarbe ist Blau.", "exT": "My favorite color is blue." },
    { "c": "rot", "a": "red", "d": ["pink", "brown"] },
    { "c": "blau", "a": "blue", "d": ["gray", "green"] },
    { "c": "grün", "a": "green", "d": ["gray", "blue"] },
    { "c": "gelb", "a": "yellow", "d": ["gold", "orange"] },
    { "c": "schwarz", "a": "black", "d": ["white", "dark blue"] },
    { "c": "weiß", "a": "white", "d": ["black", "light gray"], "ex": "Der Schnee ist weiß.", "exT": "The snow is white." },
    { "c": "grau", "a": "gray", "d": ["green", "brown"] },
    { "c": "braun", "a": "brown", "d": ["gray", "beige"] },
    { "c": "groß", "a": "big, tall", "d": ["small, short", "wide, broad"], "ex": "Mein Bruder ist sehr groß.", "exT": "My brother is very tall." },
    { "c": "klein", "a": "small, little", "d": ["big, tall", "clean, neat"] },
    { "c": "alt", "a": "old", "d": ["new", "young"] },
    { "c": "neu", "a": "new", "d": ["old", "nice"] },
    { "c": "jung", "a": "young", "d": ["old", "new"] },
    { "c": "gut", "a": "good", "d": ["bad", "evil"] },
    { "c": "schlecht", "a": "bad", "d": ["good", "simple"] },
    { "c": "schön", "a": "beautiful, nice", "d": ["ugly", "clean"] },
    { "c": "schnell", "a": "fast", "d": ["slow", "loud"], "ex": "Das Auto ist schnell.", "exT": "The car is fast." },
    { "c": "langsam", "a": "slow", "d": ["fast", "long"], "ex": "Bitte sprechen Sie langsam.", "exT": "Please speak slowly." },
    { "c": "lang", "a": "long", "d": ["short", "slow"] },
    { "c": "kurz", "a": "short", "d": ["long", "small, little"] },
    { "c": "interessant", "a": "interesting", "d": ["boring", "important"] },
    { "c": "langweilig", "a": "boring", "d": ["interesting", "funny"] },
    { "c": "sehr", "a": "very", "d": ["too", "not"] },
    { "c": "nicht", "a": "not", "d": ["no (none)", "never"], "ex": "Das Buch ist nicht interessant.", "exT": "The book is not interesting." },
    { "c": "Welche Farbe hat das Auto?", "a": "What color is the car?", "d": ["Where is the car?", "How old is the car?"] },
    { "c": "Das ist ein ___ Hund. (groß)", "a": "großer", "d": ["großes", "großen"] },
    { "c": "Das ist eine ___ Stadt. (schön)", "a": "schöne", "d": ["schöner", "schönes"] },
    { "c": "Das ist ein ___ Buch. (neu)", "a": "neues", "d": ["neuer", "neue"], "ex": "Das ist ein neues Buch.", "exT": "That's a new book." },
    { "c": "Der ___ Tisch ist schön. (alt)", "a": "alte", "d": ["alter", "altes"] },
    { "c": "Das Haus ist ___. (groß)", "a": "groß", "d": ["großes", "große"], "ex": "No ending after sein: Das Haus ist groß.", "exT": "The house is big." }
  ]
}
