{
  "title": "Feelings and opinions",
  "note": "Gefallen works backward from English: the thing liked is the subject and the person is dative. Das Buch gefällt mir (I like the book); Die Schuhe gefallen mir. Wissen is to know a fact (ich weiß, er weiß); kennen is to know a person or place. Gern, lieber, am liebsten = like, prefer, like most.",
  "src": { "t": "Grimm Grammar: Gefallen; Wissen vs. kennen", "u": "https://coerll.utexas.edu/gg/gr/vi_15.html" },
  "items": [
    { "c": "wissen", "a": "to know (a fact)", "d": ["to know (be familiar with)", "to wish"], "ex": "Ich weiß es nicht.", "exT": "I don't know." },
    { "c": "kennen", "a": "to know (be familiar with)", "d": ["to know (a fact)", "to be able to"], "ex": "Kennst du Berlin?", "exT": "Do you know Berlin?" },
    { "c": "denken", "a": "to think", "d": ["to thank", "to drink"] },
    { "c": "glauben", "a": "to believe", "d": ["to hope", "to know (a fact)"], "ex": "Ich glaube, er kommt heute.", "exT": "I believe he's coming today." },
    { "c": "vielleicht", "a": "maybe, perhaps", "d": ["certainly", "probably not"] },
    { "c": "lieben", "a": "to love", "d": ["to live", "to lie"] },
    { "c": "hoffen", "a": "to hope", "d": ["to help", "to hear"] },
    { "c": "glücklich", "a": "happy", "d": ["sad", "proud"] },
    { "c": "traurig", "a": "sad", "d": ["angry", "tired"] },
    { "c": "froh", "a": "glad", "d": ["afraid", "angry"] },
    { "c": "wütend", "a": "angry, furious", "d": ["sad", "worried"] },
    { "c": "toll", "a": "great, terrific", "d": ["terrible", "tall"] },
    { "c": "schrecklich", "a": "terrible, awful", "d": ["wonderful", "boring"] },
    { "c": "Ich habe Angst.", "a": "I'm afraid.", "d": ["I'm angry.", "I'm in a hurry."] },
    { "c": "Ich freue mich.", "a": "I'm glad; I'm pleased.", "d": ["I'm sorry.", "I'm bored."] },
    { "c": "Das gefällt mir.", "a": "I like that.", "d": ["That belongs to me.", "That fits me."] },
    { "c": "Ich mag Hunde.", "a": "I like dogs.", "d": ["I have dogs.", "I'm afraid of dogs."] },
    { "c": "Ich trinke lieber Tee.", "a": "I prefer to drink tea.", "d": ["I drink tea a lot.", "I'd love some tea."] },
    { "c": "Ich finde das gut.", "a": "I think that's good.", "d": ["I found that.", "I find that hard."] },
    { "c": "Meiner Meinung nach ...", "a": "In my opinion ...", "d": ["According to my mother ...", "After my meeting ..."] },
    { "c": "Das ist mir egal.", "a": "I don't care.", "d": ["That's important to me.", "That's too much for me."] },
    { "c": "Stimmt!", "a": "That's right!", "d": ["Stop!", "That's wrong!"] },
    { "c": "Ich bin einverstanden.", "a": "I agree.", "d": ["I understand.", "I'm surprised."] },
    { "c": "Ich ___ nicht, wo er wohnt. (wissen)", "a": "weiß", "d": ["wisse", "weißt"] },
    { "c": "Ich ___ ihn gut. (kennen)", "a": "kenne", "d": ["weiß", "kennt"] },
    { "c": "Gefällt ___ das Buch? (du)", "a": "dir", "d": ["dich", "du"] },
    { "c": "Die Schuhe ___ mir. (gefallen)", "a": "gefallen", "d": ["gefällt", "gefallt"] },
    { "c": "Ich ___, dass sie recht hat. (glauben)", "a": "glaube", "d": ["glaubt", "glaubst"] },
    { "c": "Er ___ Katzen. (mögen)", "a": "mag", "d": ["mögt", "magt"] }
  ]
}
