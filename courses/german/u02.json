{
  "title": "People, pronouns and sein",
  "note": "sein (to be): ich bin, du bist, er/sie/es ist, wir sind, ihr seid, sie/Sie sind. The subject is in the nominative case: der, die, das; ein, eine, ein. A noun after sein is nominative too. Jobs and nationalities after sein take no article: Ich bin Student.",
  "src": { "t": "Grimm Grammar: Sein and the nominative case", "u": "https://coerll.utexas.edu/gg/gr/cas_02.html" },
  "items": [
    { "c": "ich bin", "a": "I am", "d": ["you are", "he is"] },
    { "c": "du bist", "a": "you are (informal)", "d": ["I am", "we are"], "ex": "Du bist sehr nett.", "exT": "You are very nice." },
    { "c": "er ist", "a": "he is", "d": ["she is", "I am"] },
    { "c": "sie ist", "a": "she is", "d": ["they are", "it is"] },
    { "c": "es ist", "a": "it is", "d": ["he is", "we are"] },
    { "c": "wir sind", "a": "we are", "d": ["they are", "you all are"] },
    { "c": "ihr seid", "a": "you all are (informal)", "d": ["they are", "we are"] },
    { "c": "sie sind", "a": "they are", "d": ["she is", "we are"], "ex": "Lena und Tom sind hier.", "exT": "Lena and Tom are here." },
    { "c": "Sind Sie Frau Schmidt?", "a": "Are you Ms. Schmidt?", "d": ["Is she Ms. Schmidt?", "Is this Ms. Schmidt's?"] },
    { "c": "der Mann", "a": "the man", "d": ["the boy", "the woman"], "ex": "Pl. die Männer: Die Männer sind hier.", "exT": "The men are here." },
    { "c": "die Frau", "a": "the woman; the wife", "d": ["the girl; the daughter", "the aunt; the sister"], "ex": "Pl. die Frauen: Die Frau heißt Eva.", "exT": "The woman's name is Eva." },
    { "c": "das Mädchen", "a": "the girl", "d": ["the boy", "the woman"], "ex": "Das Mädchen ist neun. (neuter, like all -chen words)", "exT": "The girl is nine." },
    { "c": "der Junge", "a": "the boy", "d": ["the girl", "the man"], "ex": "Pl. die Jungen: Der Junge spielt.", "exT": "The boy is playing." },
    { "c": "der Freund", "a": "the (male) friend", "d": ["the (male) neighbor", "the (male) teacher"], "ex": "Pl. die Freunde: Das ist mein Freund Udo.", "exT": "This is my friend Udo." },
    { "c": "die Freundin", "a": "the (female) friend", "d": ["the (female) neighbor", "the (female) teacher"], "ex": "Pl. die Freundinnen", "exT": "the (female) friends" },
    { "c": "der Mensch", "a": "the person, the human being", "d": ["the guest", "the child"], "ex": "Pl. die Menschen: Hier wohnen viele Menschen.", "exT": "Many people live here." },
    { "c": "die Leute", "a": "people (plural only)", "d": ["the parents", "the children"] },
    { "c": "der Student", "a": "the (male) university student", "d": ["the (male) teacher", "the (male) doctor"], "ex": "Pl. die Studenten" },
    { "c": "die Lehrerin", "a": "the (female) teacher", "d": ["the (female) student", "the (female) doctor"], "ex": "Pl. die Lehrerinnen" },
    { "c": "Ich bin Student.", "a": "I'm a student.", "d": ["I'm a teacher.", "I'm studying now."] },
    { "c": "Ich bin Amerikanerin.", "a": "I'm American. (said by a woman)", "d": ["I'm in America.", "I'm from Austria."] },
    { "c": "nett", "a": "nice, kind", "d": ["tired", "rude"] },
    { "c": "Wer ist das?", "a": "Who is that?", "d": ["What is that?", "Where is that?"] },
    { "c": "Das ist Lukas.", "a": "This is Lukas.", "d": ["That was Lukas.", "Lukas is coming."] },
    { "c": "Wir ___ müde. (sein)", "a": "sind", "d": ["seid", "ist"] },
    { "c": "Du ___ sehr nett. (sein)", "a": "bist", "d": ["bin", "ist"] },
    { "c": "Ihr ___ hier. (sein)", "a": "seid", "d": ["sind", "seit"] },
    { "c": "Er ___ Lehrer. (sein)", "a": "ist", "d": ["bist", "sind"], "ex": "Er ist Lehrer.", "exT": "He is a teacher." },
    { "c": "___ Mann ist nett. (the)", "a": "Der", "d": ["Den", "Das"] },
    { "c": "___ Kind ist klein. (the)", "a": "Das", "d": ["Der", "Die"] },
    { "c": "Das ist ___ Frau. (a)", "a": "eine", "d": ["ein", "einen"] },
    { "c": "Das ist ___ Mann. (a)", "a": "ein", "d": ["eine", "einen"], "ex": "Das ist ein Mann. (nominative after sein)", "exT": "That is a man." }
  ]
}
