{
  "title": "Plans, the future and modal verbs",
  "note": "Modal verbs take second position and push the main verb to the end as an infinitive: Ich muss heute arbeiten. The ich and er forms are the same and, except in möchte, have no ending: ich kann, er kann. Careful: ich will means I want, not I will. German often uses the present for the future (Morgen fahre ich nach Wien); werden + infinitive also works.",
  "src": { "t": "Grimm Grammar: Modal verbs, present tense", "u": "https://coerll.utexas.edu/gg/gr/vm_01.html" },
  "items": [
    { "c": "können", "a": "can, to be able to", "d": ["must, to have to", "may, to be allowed to"] },
    { "c": "müssen", "a": "must, to have to", "d": ["can, to be able to", "should, to be supposed to"] },
    { "c": "wollen", "a": "to want (to)", "d": ["will (future)", "to like (to)"] },
    { "c": "dürfen", "a": "may, to be allowed to", "d": ["must, to have to", "to want (to)"] },
    { "c": "sollen", "a": "should, to be supposed to", "d": ["to want (to)", "can, to be able to"] },
    { "c": "möchten", "a": "would like (to)", "d": ["have to", "be allowed to"], "ex": "Ich möchte ein Zimmer für zwei Nächte.", "exT": "I'd like a room for two nights." },
    { "c": "werden", "a": "to become; will (future)", "d": ["to want; to wish", "to wait; to stay"] },
    { "c": "Ich will nach Hause.", "a": "I want to go home.", "d": ["I will go home.", "I have to go home."] },
    { "c": "Du musst nicht kommen.", "a": "You don't have to come.", "d": ["You must not come.", "You can't come."] },
    { "c": "Du darfst hier nicht rauchen.", "a": "You're not allowed to smoke here.", "d": ["You don't have to smoke here.", "You don't want to smoke here."] },
    { "c": "Darf ich hier sitzen?", "a": "May I sit here?", "d": ["Must I sit here?", "Do you want to sit here?"] },
    { "c": "Kannst du mir helfen?", "a": "Can you help me?", "d": ["Do you have to help me?", "Did you help me?"] },
    { "c": "Ich werde morgen arbeiten.", "a": "I will work tomorrow.", "d": ["I worked yesterday.", "I want to work tomorrow."] },
    { "c": "Morgen fahre ich nach Wien.", "a": "Tomorrow I'm going to Vienna.", "d": ["Yesterday I went to Vienna.", "Tomorrow I must go to Vienna."] },
    { "c": "Es wird kalt.", "a": "It's getting cold.", "d": ["It was cold.", "It's very cold."] },
    { "c": "Wir werden sehen.", "a": "We'll see.", "d": ["We saw it.", "We want to see."] },
    { "c": "nächste Woche", "a": "next week", "d": ["last week", "every week"] },
    { "c": "später", "a": "later", "d": ["earlier", "late"] },
    { "c": "bald", "a": "soon", "d": ["seldom", "already"], "ex": "Ich komme bald.", "exT": "I'm coming soon." },
    { "c": "Hast du Lust?", "a": "Do you feel like it?", "d": ["Are you hungry?", "Do you have time?"], "ex": "Hast du Lust auf Kino?", "exT": "Do you feel like going to the movies?" },
    { "c": "Ich ___ heute nicht kommen. (können)", "a": "kann", "d": ["könne", "kannst"] },
    { "c": "Du ___ mehr schlafen. (müssen)", "a": "musst", "d": ["muss", "müsst"] },
    { "c": "Er ___ Arzt werden. (wollen)", "a": "will", "d": ["wollt", "willt"], "ex": "Er will Arzt werden.", "exT": "He wants to become a doctor." },
    { "c": "Wir ___ ins Kino gehen. (möchten)", "a": "möchten", "d": ["möchtet", "möchte"] },
    { "c": "Ich muss heute ___.", "a": "arbeiten", "d": ["arbeite"] },
    { "c": "Ich will heute ___.", "a": "ins Kino gehen", "d": ["gehen ins Kino"] },
    { "c": "___ Sie mir helfen? (können)", "a": "Können", "d": ["Kann", "Könnt"] },
    { "c": "Ihr ___ hier nicht parken. (dürfen)", "a": "dürft", "d": ["darft", "dürfen"] },
    { "c": "Was ___ wir mitbringen? (sollen)", "a": "sollen", "d": ["sollt", "soll"] }
  ]
}
