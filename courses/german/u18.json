{
  "title": "Question words, connectors and frequency",
  "note": "Und, aber, oder and denn join two main clauses and leave the verb second. Weil, dass, wenn and ob start a subordinate clause and send its conjugated verb to the end: Ich bleibe zu Hause, weil ich krank bin. If the subordinate clause comes first, the main verb follows right after the comma: Wenn es regnet, bleibe ich zu Hause.",
  "src": { "t": "Grimm Grammar: Interrogatives and subordinating conjunctions", "u": "https://coerll.utexas.edu/gg/gr/con_05.html" },
  "items": [
    { "c": "wer", "a": "who", "d": ["where", "what"], "ex": "Wer ist das?", "exT": "Who is that?" },
    { "c": "was", "a": "what", "d": ["who", "which"] },
    { "c": "wo", "a": "where", "d": ["who", "how"], "ex": "Wo ist der Bahnhof?", "exT": "Where is the train station?" },
    { "c": "woher", "a": "where from", "d": ["where to", "since when"] },
    { "c": "wohin", "a": "where to", "d": ["where from", "how far"], "ex": "Wohin fährst du?", "exT": "Where are you going?" },
    { "c": "wann", "a": "when", "d": ["why", "who"] },
    { "c": "warum", "a": "why", "d": ["when", "how"] },
    { "c": "wie", "a": "how", "d": ["who", "why"] },
    { "c": "wie viel", "a": "how much", "d": ["how often", "how long"], "ex": "Wie viel kostet das?", "exT": "How much does that cost?" },
    { "c": "welcher, welche, welches", "a": "which", "d": ["whose", "what kind of"] },
    { "c": "aber", "a": "but", "d": ["or", "also"] },
    { "c": "oder", "a": "or", "d": ["but", "and"] },
    { "c": "denn", "a": "because (verb stays second)", "d": ["or (verb stays second)", "but (verb stays second)"] },
    { "c": "weil", "a": "because (verb goes last)", "d": ["while (verb goes last)", "whether (verb goes last)"] },
    { "c": "dass", "a": "that (conjunction)", "d": ["the (article)", "this (pronoun)"], "ex": "Ich weiß, dass er kommt.", "exT": "I know that he's coming." },
    { "c": "wenn", "a": "if; whenever", "d": ["when? (question)", "although"] },
    { "c": "ob", "a": "whether, if", "d": ["or", "because"] },
    { "c": "auch", "a": "also, too", "d": ["only", "already"] },
    { "c": "immer", "a": "always", "d": ["never", "often"] },
    { "c": "nie", "a": "never", "d": ["always", "rarely"], "ex": "Ich trinke nie Kaffee.", "exT": "I never drink coffee." },
    { "c": "oft", "a": "often", "d": ["rarely", "always"] },
    { "c": "manchmal", "a": "sometimes", "d": ["never", "every time"] },
    { "c": "selten", "a": "rarely, seldom", "d": ["often", "strangely"] },
    { "c": "jeden Tag", "a": "every day", "d": ["all day", "one day"], "ex": "Ich lerne jeden Tag Deutsch.", "exT": "I study German every day." },
    { "c": "schon", "a": "already", "d": ["still", "not yet"] },
    { "c": "noch", "a": "still, yet", "d": ["already", "never"] },
    { "c": "Ich komme nicht, weil ___.", "a": "ich krank bin", "d": ["ich bin krank"] },
    { "c": "Ich komme nicht, denn ___.", "a": "ich bin krank", "d": ["ich krank bin"] },
    { "c": "Ich weiß, dass ___.", "a": "er heute kommt", "d": ["er kommt heute"] },
    { "c": "Wenn es regnet, ___ zu Hause.", "a": "bleibe ich", "d": ["ich bleibe"], "ex": "Wenn es regnet, bleibe ich zu Hause.", "exT": "If it rains, I stay home." },
    { "c": "Weißt du, ob ___?", "a": "der Zug pünktlich ist", "d": ["ist der Zug pünktlich"] }
  ]
}
