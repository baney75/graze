{
  "title": "Around town, directions and the dative",
  "note": "The dative marks the indirect object and always follows aus, bei, mit, nach, seit, von and zu. Articles: dem (masc./neuter), der (fem.), den + -n (plural). Short forms: zum = zu dem, zur = zu der, vom = von dem, beim = bei dem. Helfen takes the dative: Ich helfe dir.",
  "src": { "t": "Grimm Grammar: Der Dativ", "u": "https://coerll.utexas.edu/gg/gr/cas_07.html" },
  "items": [
    { "c": "die Stadt", "a": "the city, the town", "d": ["the village", "the country"], "ex": "Pl. die Städte: Wien ist eine schöne Stadt.", "exT": "Vienna is a beautiful city." },
    { "c": "die Straße", "a": "the street", "d": ["the square", "the bridge"], "ex": "Pl. die Straßen" },
    { "c": "der Bahnhof", "a": "the train station", "d": ["the airport", "the bus stop"], "ex": "Pl. die Bahnhöfe" },
    { "c": "die Bank", "a": "the bank; the bench", "d": ["the post office; the mail", "the store; the shop"], "ex": "Pl. die Banken (banks), die Bänke (benches)" },
    { "c": "die Post", "a": "the post office; the mail", "d": ["the bank; the bench", "the police; the officer"] },
    { "c": "das Geschäft", "a": "the store, the shop; the business", "d": ["the bakery", "the market square"], "ex": "Pl. die Geschäfte" },
    { "c": "die Bäckerei", "a": "the bakery", "d": ["the butcher shop", "the pharmacy"] },
    { "c": "die Apotheke", "a": "the pharmacy", "d": ["the library", "the bakery"], "ex": "Pl. die Apotheken" },
    { "c": "das Krankenhaus", "a": "the hospital", "d": ["the pharmacy", "the hotel"], "ex": "Pl. die Krankenhäuser" },
    { "c": "die Kirche", "a": "the church", "d": ["the cherry", "the castle"] },
    { "c": "das Kino", "a": "the movie theater", "d": ["the theater (stage)", "the kiosk"], "ex": "Gehen wir ins Kino?", "exT": "Shall we go to the movies?" },
    { "c": "der Platz", "a": "the square, the place", "d": ["the street", "the park"], "ex": "Pl. die Plätze" },
    { "c": "die Ecke", "a": "the corner", "d": ["the end", "the side"] },
    { "c": "links", "a": "left", "d": ["right", "straight ahead"] },
    { "c": "rechts", "a": "right", "d": ["left", "back"] },
    { "c": "geradeaus", "a": "straight ahead", "d": ["around the corner", "back"], "ex": "Gehen Sie geradeaus und dann links.", "exT": "Go straight ahead and then left." },
    { "c": "weit", "a": "far", "d": ["near", "high"] },
    { "c": "in der Nähe", "a": "nearby", "d": ["far away", "downtown"] },
    { "c": "zu Hause", "a": "at home", "d": ["(going) home", "from home"], "ex": "Ich bin zu Hause.", "exT": "I'm at home." },
    { "c": "nach Hause", "a": "(going) home", "d": ["at home", "from home"], "ex": "Ich gehe nach Hause.", "exT": "I'm going home." },
    { "c": "Wie komme ich zum Bahnhof?", "a": "How do I get to the train station?", "d": ["When does the train come?", "Is the train station far?"] },
    { "c": "helfen", "a": "to help", "d": ["to hold", "to fetch"], "ex": "Kannst du mir helfen?", "exT": "Can you help me?" },
    { "c": "Ich fahre mit ___ Bus. (the)", "a": "dem", "d": ["den", "der"], "ex": "Ich fahre mit dem Bus.", "exT": "I'm going by bus." },
    { "c": "Sie kommt aus ___ Schweiz. (the)", "a": "der", "d": ["die", "dem"] },
    { "c": "Wir gehen ___ Post. (zu + der)", "a": "zur", "d": ["zum", "zu die"] },
    { "c": "Er geht ___ Arzt. (zu + dem)", "a": "zum", "d": ["zur", "zu den"] },
    { "c": "Er wohnt bei ___ Eltern. (his)", "a": "seinen", "d": ["seine", "seiner"] },
    { "c": "Ich helfe ___. (du)", "a": "dir", "d": ["dich", "du"] },
    { "c": "Ich spiele mit den ___. (die Kinder)", "a": "Kindern", "d": ["Kinder", "Kinds"] },
    { "c": "Ich wohne seit ___ Jahr hier. (one)", "a": "einem", "d": ["ein", "einen"], "ex": "Ich wohne seit einem Jahr hier.", "exT": "I have lived here for a year." }
  ]
}
