{
  "title": "Weather, nature, seasons and animals",
  "note": "Weather verbs use es: es regnet (it's raining), es schneit (it's snowing). Seasons are masculine and take im: im Sommer, im Winter. Watch the gender pair der See (the lake) and das Meer (the sea).",
  "src": { "t": "Grimm Grammar: Die Monate und Jahreszeiten", "u": "https://coerll.utexas.edu/gg/gr/cas_06.html" },
  "items": [
    { "c": "das Wetter", "a": "the weather", "d": ["the wind", "the season"], "ex": "Wie ist das Wetter heute?", "exT": "What's the weather like today?" },
    { "c": "die Sonne", "a": "the sun", "d": ["the moon", "the star"], "ex": "Die Sonne scheint.", "exT": "The sun is shining." },
    { "c": "der Mond", "a": "the moon", "d": ["the sun", "the month"] },
    { "c": "der Regen", "a": "the rain", "d": ["the snow", "the rainbow"] },
    { "c": "der Schnee", "a": "the snow", "d": ["the ice", "the rain"] },
    { "c": "die Wolke", "a": "the cloud", "d": ["the wool", "the fog"], "ex": "Pl. die Wolken" },
    { "c": "der Himmel", "a": "the sky; heaven", "d": ["the cloud; the fog", "the earth; the ground"] },
    { "c": "Es regnet.", "a": "It's raining.", "d": ["It's snowing.", "It's windy."] },
    { "c": "Es schneit.", "a": "It's snowing.", "d": ["It's raining.", "It's freezing."] },
    { "c": "warm", "a": "warm", "d": ["cool", "hot"] },
    { "c": "kalt", "a": "cold", "d": ["cool", "warm"], "ex": "Im Winter ist es kalt.", "exT": "In winter it's cold." },
    { "c": "heiß", "a": "hot", "d": ["warm", "dry"] },
    { "c": "der Frühling", "a": "spring", "d": ["fall", "summer"] },
    { "c": "der Sommer", "a": "summer", "d": ["spring", "winter"] },
    { "c": "der Herbst", "a": "fall, autumn", "d": ["spring", "winter"] },
    { "c": "der Winter", "a": "winter", "d": ["fall, autumn", "summer"] },
    { "c": "der Baum", "a": "the tree", "d": ["the bush", "the flower"], "ex": "Pl. die Bäume" },
    { "c": "die Blume", "a": "the flower", "d": ["the tree", "the grass"], "ex": "Pl. die Blumen" },
    { "c": "der Wald", "a": "the forest, the woods", "d": ["the field", "the mountain"], "ex": "Pl. die Wälder" },
    { "c": "der Berg", "a": "the mountain", "d": ["the castle", "the valley"], "ex": "Pl. die Berge" },
    { "c": "der Fluss", "a": "the river", "d": ["the lake", "the flight"], "ex": "Pl. die Flüsse" },
    { "c": "der See", "a": "the lake", "d": ["the sea", "the river"], "ex": "Pl. die Seen" },
    { "c": "das Meer", "a": "the sea, the ocean", "d": ["the lake", "the beach"], "ex": "Wir fahren ans Meer.", "exT": "We're going to the seaside." },
    { "c": "das Tier", "a": "the animal", "d": ["the plant", "the toy"], "ex": "Pl. die Tiere" },
    { "c": "der Hund", "a": "the dog", "d": ["the cat", "the horse"], "ex": "Pl. die Hunde: Der Hund spielt im Garten.", "exT": "The dog is playing in the yard." },
    { "c": "die Katze", "a": "the cat", "d": ["the dog", "the mouse"], "ex": "Pl. die Katzen" },
    { "c": "der Vogel", "a": "the bird", "d": ["the fish", "the bug"], "ex": "Pl. die Vögel" },
    { "c": "das Pferd", "a": "the horse", "d": ["the cow", "the dog"], "ex": "Pl. die Pferde" },
    { "c": "Im Winter ___ es oft. (schneien)", "a": "schneit", "d": ["schneien", "schneist"] },
    { "c": "___ Sommer ist es heiß. (in + dem)", "a": "Im", "d": ["Am", "Um"] },
    { "c": "Die Katze liegt auf ___ Sofa. (the)", "a": "dem", "d": ["das", "den"] },
    { "c": "Der Hund springt auf ___ Sofa. (the)", "a": "das", "d": ["dem", "der"] }
  ]
}
