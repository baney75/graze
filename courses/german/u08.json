{
  "title": "Everyday verbs in the present tense",
  "note": "Regular endings: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en. Stems ending in -t or -d add an e: du arbeitest, er arbeitet. Some strong verbs change the vowel in the du and er forms: essen → du isst, sprechen → er spricht, lesen → er liest, schlafen → er schläft.",
  "src": { "t": "Grimm Grammar: Present tense of regular verbs", "u": "https://coerll.utexas.edu/gg/gr/v_02.html" },
  "items": [
    { "c": "gehen", "a": "to go (on foot)", "d": ["to drive", "to stand"], "ex": "Ich gehe nach Hause.", "exT": "I'm going home." },
    { "c": "kommen", "a": "to come", "d": ["to go", "to stay"] },
    { "c": "sehen", "a": "to see", "d": ["to say", "to look for"], "ex": "Er sieht einen Film.", "exT": "He's watching a movie." },
    { "c": "sprechen", "a": "to speak", "d": ["to hear", "to write"] },
    { "c": "lesen", "a": "to read", "d": ["to learn", "to write"], "ex": "Sie liest ein Buch.", "exT": "She's reading a book." },
    { "c": "schreiben", "a": "to write", "d": ["to read", "to shout"] },
    { "c": "essen", "a": "to eat", "d": ["to drink", "to cook"] },
    { "c": "trinken", "a": "to drink", "d": ["to eat", "to think"] },
    { "c": "schlafen", "a": "to sleep", "d": ["to wake up", "to lie down"] },
    { "c": "lernen", "a": "to learn", "d": ["to teach", "to read"], "ex": "Wir lernen Deutsch.", "exT": "We're learning German." },
    { "c": "arbeiten", "a": "to work", "d": ["to play", "to rest"] },
    { "c": "machen", "a": "to do, to make", "d": ["to say, to tell", "to take, to grab"], "ex": "Was machst du heute?", "exT": "What are you doing today?" },
    { "c": "spielen", "a": "to play", "d": ["to work", "to sing"] },
    { "c": "wohnen", "a": "to live (reside)", "d": ["to stay (remain)", "to work (have a job)"], "ex": "Ich wohne in Hamburg.", "exT": "I live in Hamburg." },
    { "c": "hören", "a": "to hear, to listen", "d": ["to stop", "to belong"] },
    { "c": "fahren", "a": "to drive, to go (by vehicle)", "d": ["to fly", "to walk"], "ex": "Er fährt mit dem Bus.", "exT": "He's going by bus." },
    { "c": "kaufen", "a": "to buy", "d": ["to sell", "to run"] },
    { "c": "kochen", "a": "to cook", "d": ["to bake", "to eat"] },
    { "c": "brauchen", "a": "to need", "d": ["to want", "to bring"] },
    { "c": "finden", "a": "to find", "d": ["to look for", "to lose"] },
    { "c": "fragen", "a": "to ask", "d": ["to answer", "to say"] },
    { "c": "sagen", "a": "to say", "d": ["to ask", "to show"] },
    { "c": "Du ___ gut Deutsch. (sprechen)", "a": "sprichst", "d": ["sprechst", "spricht"] },
    { "c": "Er ___ ein Buch. (lesen)", "a": "liest", "d": ["lest", "lesst"] },
    { "c": "Ich ___ in Berlin. (wohnen)", "a": "wohne", "d": ["wohnt", "wohnst"] },
    { "c": "Anna ___ viel. (arbeiten)", "a": "arbeitet", "d": ["arbeit", "arbeitest"] },
    { "c": "Was ___ du gern? (essen)", "a": "isst", "d": ["esst", "ist"], "ex": "Was isst du gern?", "exT": "What do you like to eat?" },
    { "c": "Das Baby ___ lange. (schlafen)", "a": "schläft", "d": ["schlaft", "schlafen"] },
    { "c": "Wir ___ Fußball. (spielen)", "a": "spielen", "d": ["spielt", "spiele"] },
    { "c": "Ihr ___ Musik. (hören)", "a": "hört", "d": ["hören", "hörst"] },
    { "c": "Er ___ nach Wien. (fahren)", "a": "fährt", "d": ["fahrt", "fahrst"] }
  ]
}
