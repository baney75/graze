      "d": [
        "in, among",
        "away from"
      ],
      "ex": "εἰς τὴν πόλιν",
      "exT": "into the city",
      "r": "eis",
      "say": "εἰς"
    },
    {
      "c": "ἐκ (ἐξ) + genitive",
