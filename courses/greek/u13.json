      "a": "in, among",
      "d": [
        "into, to",
        "out of, from"
      ],
      "ex": "ἐν τῇ οἰκίᾳ",
      "exT": "in the house",
      "r": "en",
      "say": "ἐν"
    },
    {
      "c": "εἰς + accusative",
