{
  "title": "People, pronouns and \"to be\"",
  "note": "Essere (to be): io sono, tu sei, lui/lei è, noi siamo, voi siete, loro sono. Subject pronouns are often dropped because the ending shows the person. The definite article changes with the noun: il, lo (before s + consonant, z), l' (before a vowel), la; plural i, gli, le.",
  "src": { "t": "Voci, Unità 1: Grammatica (essere, nouns, articles)", "u": "https://human.libretexts.org/Bookshelves/Languages/Italian/Voci%3A_Corso_elementare_di_lingua_e_culture_italiane_I_(Bozzato_Benetollo_and_Mugnai)/01%3A_Unita_1/1.03%3A_Unita_1_-_Grammatica" },
  "items": [
    { "c": "io", "a": "I", "d": ["you", "we"] },
    { "c": "tu", "a": "you (one friend)", "d": ["you (a group)", "he"] },
    { "c": "lui", "a": "he", "d": ["she", "they"] },
    { "c": "lei", "a": "she", "d": ["he", "we"] },
    { "c": "Lei (capitalized, formal)", "a": "you (formal, one person)", "d": ["they (formal)", "we (formal)"], "ex": "Lei è il signor Bianchi?", "exT": "Are you Mr. Bianchi?" },
    { "c": "noi", "a": "we", "d": ["they", "you (a group)"] },
    { "c": "voi", "a": "you (a group)", "d": ["we", "they"] },
    { "c": "loro", "a": "they", "d": ["we", "you (a group)"] },
    { "c": "Io ___ italiano. (essere)", "a": "sono", "d": ["sei", "è"] },
    { "c": "Tu ___ americana? (essere)", "a": "sei", "d": ["sono", "siete"] },
    { "c": "Marco ___ di Roma. (essere)", "a": "è", "d": ["sei", "siete"] },
    { "c": "Noi ___ studenti. (essere)", "a": "siamo", "d": ["siete", "sono"] },
    { "c": "Voi ___ stanchi? (essere)", "a": "siete", "d": ["siamo", "sei"] },
    { "c": "l'uomo", "a": "man", "d": ["woman", "boy"], "ex": "L'uomo è alto.", "exT": "The man is tall." },
    { "c": "la donna", "a": "woman", "d": ["man", "girl"] },
    { "c": "il ragazzo", "a": "boy; young man", "d": ["girl", "child"] },
    { "c": "la ragazza", "a": "girl; young woman", "d": ["boy", "lady"] },
    { "c": "il bambino", "a": "child; little boy", "d": ["old man", "young woman"] },
    { "c": "l'amico", "a": "friend (male)", "d": ["teacher (male)", "brother"], "ex": "Paolo è il mio amico.", "exT": "Paolo is my friend." },
    { "c": "l'amica", "a": "friend (female)", "d": ["teacher (female)", "sister"] },
    { "c": "lo studente", "a": "student (male)", "d": ["teacher (male)", "neighbor (male)"] },
    { "c": "la studentessa", "a": "student (female)", "d": ["teacher (female)", "doctor (female)"] },
    { "c": "il professore", "a": "teacher; professor (male)", "d": ["student (male)", "doctor (male)"] },
    { "c": "la persona", "a": "person", "d": ["people", "family"] },
    { "c": "la gente", "a": "people (singular noun)", "d": ["person", "gentleman"], "ex": "La gente è simpatica qui.", "exT": "People are nice here." },
    { "c": "___ studente (the)", "a": "lo", "d": ["il", "la"] },
    { "c": "___ amico (the)", "a": "l'", "d": ["lo", "il"] },
    { "c": "___ studenti (the, plural)", "a": "gli", "d": ["i", "le"] },
    { "c": "___ ragazze (the, plural)", "a": "le", "d": ["i", "gli"] },
    { "c": "___ amica (a, an)", "a": "un'", "d": ["un", "uno"] },
    { "c": "___ zaino (a, an)", "a": "uno", "d": ["un", "una"] },
    { "c": "Di dove sei?", "a": "Where are you from?", "d": ["Where do you live?", "Where are you going?"] },
    { "c": "Sono di Milano.", "a": "I'm from Milan.", "d": ["I live near Milan.", "I'm going to Milan."], "ex": "Sono di Milano, ma abito a Roma.", "exT": "I'm from Milan, but I live in Rome." },
    { "c": "Sono americana.", "a": "I'm American (woman speaking).", "d": ["I'm Italian (woman speaking).", "I live in America."] },
    { "c": "Chi è?", "a": "Who is it?", "d": ["Where is it?", "What is it?"] },
    { "c": "Questo è Marco.", "a": "This is Marco.", "d": ["That is Marco's.", "Where is Marco?"] }
  ]
}
