{
  "title": "Places in town and directions",
  "note": "Use a for cities (a Roma) and in for countries and regions (in Italia). Da means \"from\" or \"at someone's place\": vengo da Napoli, vado dal medico. Say a casa and a piedi with no article, but al cinema.",
  "src": { "t": "Voci, Unità 7: Grammatica (usi delle preposizioni)", "u": "https://human.libretexts.org/Bookshelves/Languages/Italian/Voci%3A_Corso_elementare_di_lingua_e_culture_italiane_I_(Bozzato_Benetollo_and_Mugnai)/07%3A_Unita_7/7.02%3A_Unita_7_-_Grammatica" },
  "items": [
    { "c": "la città", "a": "city; town", "d": ["village", "country"], "ex": "Roma è una città bellissima.", "exT": "Rome is a very beautiful city." },
    { "c": "il centro", "a": "downtown; city center", "d": ["suburbs", "outskirts"] },
    { "c": "la piazza", "a": "square; plaza", "d": ["street", "park"] },
    { "c": "la strada", "a": "road; street", "d": ["square", "bridge"] },
    { "c": "la chiesa", "a": "church", "d": ["castle", "school"] },
    { "c": "il negozio", "a": "shop; store", "d": ["warehouse", "market"] },
    { "c": "il supermercato", "a": "supermarket", "d": ["mall", "bakery"] },
    { "c": "la farmacia", "a": "pharmacy", "d": ["hospital", "farm"] },
    { "c": "la banca", "a": "bank", "d": ["school", "post office"] },
    { "c": "l'ufficio postale", "a": "post office", "d": ["police station", "bank"] },
    { "c": "il bar", "a": "café; coffee bar", "d": ["nightclub", "restaurant"], "ex": "Prendiamo un caffè al bar?", "exT": "Shall we have a coffee at the café?" },
    { "c": "il ristorante", "a": "restaurant", "d": ["café", "hotel"] },
    { "c": "il museo", "a": "museum", "d": ["theater", "library"] },
    { "c": "la biblioteca", "a": "library", "d": ["bookstore", "bookshelf"] },
    { "c": "la libreria", "a": "bookstore", "d": ["library", "stationery store"] },
    { "c": "il parco", "a": "park", "d": ["parking lot", "square"] },
    { "c": "il ponte", "a": "bridge", "d": ["port", "tower"] },
    { "c": "il semaforo", "a": "traffic light", "d": ["crosswalk", "road sign"] },
    { "c": "a destra", "a": "to the right", "d": ["to the left", "straight ahead"] },
    { "c": "a sinistra", "a": "to the left", "d": ["to the right", "behind"] },
    { "c": "sempre dritto", "a": "straight ahead", "d": ["back", "to the right"], "ex": "Vada sempre dritto, poi a destra.", "exT": "Go straight ahead, then right." },
    { "c": "vicino", "a": "near; close by", "d": ["far", "above"] },
    { "c": "lontano", "a": "far", "d": ["near", "behind"] },
    { "c": "accanto a", "a": "next to", "d": ["across from", "far from"] },
    { "c": "davanti a", "a": "in front of", "d": ["behind", "above"] },
    { "c": "dietro", "a": "behind", "d": ["in front of", "under"] },
    { "c": "Dov'è il museo?", "a": "Where is the museum?", "d": ["What is the museum?", "When is the museum open?"] },
    { "c": "Gira a sinistra.", "a": "Turn left.", "d": ["Turn right.", "Go back."] },
    { "c": "È lontano da qui?", "a": "Is it far from here?", "d": ["Is it near the station?", "Is it open today?"] },
    { "c": "Vado ___ Roma.", "a": "a", "d": ["in", "su"] },
    { "c": "Abito ___ Italia.", "a": "in", "d": ["a", "di"] },
    { "c": "Vengo ___ Napoli. (from)", "a": "da", "d": ["di", "a"] },
    { "c": "Stasera andiamo ___ cinema.", "a": "al", "d": ["a", "in"] },
    { "c": "Oggi vado ___ medico. (to the)", "a": "dal", "d": ["da", "nel"] }
  ]
}
