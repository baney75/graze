{
  "title": "The past tense (passato prossimo)",
  "note": "Form the passato prossimo with avere or essere plus a past participle: -are → -ato, -ere → -uto, -ire → -ito. Most verbs use avere. Verbs of motion or change (andare, venire, partire, uscire, nascere) use essere, and the participle agrees: Anna è andata.",
  "src": { "t": "Voci, Unità 9: Grammatica (il passato prossimo)", "u": "https://human.libretexts.org/Bookshelves/Languages/Italian/Voci%3A_Corso_elementare_di_lingua_e_culture_italiane_I_(Bozzato_Benetollo_and_Mugnai)/09%3A_Unita_9/9.02%3A_Unita_9_-_Grammatica" },
  "items": [
    { "c": "Ieri ho mangiato la pizza.", "a": "Yesterday I ate pizza.", "d": ["Tomorrow I'll eat pizza.", "Today I'm eating pizza."] },
    { "c": "Sono andato al mare.", "a": "I went to the beach (man speaking).", "d": ["I'm going to the beach.", "I like the beach."] },
    { "c": "Che cosa hai fatto ieri?", "a": "What did you do yesterday?", "d": ["What are you doing tomorrow?", "Where did you go yesterday?"], "ex": "Che cosa hai fatto ieri? Ho studiato.", "exT": "What did you do yesterday? I studied." },
    { "c": "l'anno scorso", "a": "last year", "d": ["next year", "this year"] },
    { "c": "la settimana scorsa", "a": "last week", "d": ["next week", "every week"] },
    { "c": "due giorni fa", "a": "two days ago", "d": ["in two days", "for two days"] },
    { "c": "ieri sera", "a": "last night; yesterday evening", "d": ["tomorrow night", "tonight"] },
    { "c": "già", "a": "already", "d": ["not yet", "still"], "ex": "Ho già mangiato, grazie.", "exT": "I've already eaten, thanks." },
    { "c": "non ancora", "a": "not yet", "d": ["already", "never again"] },
    { "c": "Maria ___ andata a Roma.", "a": "è", "d": ["ha", "sono"] },
    { "c": "Noi ___ mangiato bene.", "a": "abbiamo", "d": ["siamo", "avete"] },
    { "c": "Ieri sera ___ uscita con Anna. (io)", "a": "sono", "d": ["ho", "è"] },
    { "c": "Le ragazze sono ___. (uscire)", "a": "uscite", "d": ["uscito", "uscita"] },
    { "c": "Marco è ___ a casa. (tornare)", "a": "tornato", "d": ["tornata", "tornati"] },
    { "c": "Ho ___ i compiti. (fare)", "a": "fatto", "d": ["fato", "faciuto"] },
    { "c": "Ho ___ un bel film. (vedere)", "a": "visto", "d": ["vedato", "vista"] },
    { "c": "Ho ___ una lettera. (scrivere)", "a": "scritto", "d": ["scrivuto", "scrivato"] },
    { "c": "Ho ___ il treno. (prendere)", "a": "preso", "d": ["prenduto", "prendato"] },
    { "c": "Avete ___ il giornale? (leggere)", "a": "letto", "d": ["leggiuto", "leggito"] },
    { "c": "Che cosa ha ___? (dire)", "a": "detto", "d": ["dito", "diciuto"] },
    { "c": "Hai ___ la finestra? (aprire)", "a": "aperto", "d": ["aprito", "apruto"] },
    { "c": "Ho ___ la porta. (chiudere)", "a": "chiuso", "d": ["chiuduto", "chiudito"] },
    { "c": "Dove hai ___ le chiavi? (mettere)", "a": "messo", "d": ["mettuto", "metto"] },
    { "c": "Sono ___ a casa tutto il giorno. (rimanere)", "a": "rimasto", "d": ["rimanuto", "rimaso"] },
    { "c": "Mio nonno è ___ nel 1950. (nascere)", "a": "nato", "d": ["nasciuto", "nasceto"] },
    { "c": "Abbiamo ___ troppo vino. (bere)", "a": "bevuto", "d": ["beuto", "berito"] },
    { "c": "Paolo, sei mai ___ in Italia? (essere)", "a": "stato", "d": ["essuto", "essato"] },
    { "c": "Lucia è ___ alle tre. (arrivare)", "a": "arrivata", "d": ["arrivato", "arrivate"] },
    { "c": "Ho ___ tre ore. (dormire)", "a": "dormito", "d": ["dormuto", "dormato"] },
    { "c": "Abbiamo ___ due libri. (comprare)", "a": "comprato", "d": ["compruto", "comprati"] }
  ]
}
