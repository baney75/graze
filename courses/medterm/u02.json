{
  "title": "Prefixes: number, size, position, time and negation",
  "note": "Prefixes sit in front of a root and change its meaning without a linking vowel. Many come in opposite pairs worth learning together: hyper-/hypo- (above/below normal), brady-/tachy- (slow/fast), endo-/ecto- (inside/outside), pre-/post- (before/after), ab-/ad- (away from/toward).",
  "src": { "t": "Medical Terminology 2e (Open RN), 1.3 Common Prefixes", "u": "https://med.libretexts.org/Bookshelves/Medicine/Medical_Terminology_2e_(OpenRN)/01%3A_Foundational_Concepts_-_Identifying_Word_Parts/1.03%3A_Common_Prefixes" },
  "items": [
    { "c": "a-, an-", "a": "without, absence of", "d": ["around, surrounding", "against, opposing"], "ex": "Apnea: absence of breathing." },
    { "c": "anti-", "a": "against", "d": ["before", "between"], "ex": "An antibiotic acts against bacteria." },
    { "c": "dys-", "a": "painful, difficult, abnormal", "d": ["good, normal", "fast, rapid"], "ex": "Dysphagia: difficulty swallowing." },
    { "c": "eu-", "a": "good, normal", "d": ["bad, painful", "slow"], "ex": "Eupnea: normal, easy breathing." },
    { "c": "uni-", "a": "one", "d": ["two", "three"], "ex": "Unilateral: on one side." },
    { "c": "bi-", "a": "two", "d": ["one", "four"], "ex": "Bilateral: on both sides." },
    { "c": "tri-", "a": "three", "d": ["two", "half"], "ex": "The tricuspid valve has three cusps." },
    { "c": "quadri-", "a": "four", "d": ["three", "many"], "ex": "Quadriplegia: paralysis of all four limbs." },
    { "c": "hemi-", "a": "half", "d": ["double", "all"], "ex": "Hemiplegia: paralysis of one side of the body." },
    { "c": "poly-", "a": "many, much", "d": ["few, scanty", "none"], "ex": "Polyuria: passing large amounts of urine." },
    { "c": "nulli-", "a": "none", "d": ["first", "many"], "ex": "Nulligravida: never pregnant." },
    { "c": "primi-", "a": "first", "d": ["none", "second"], "ex": "Primigravida: pregnant for the first time." },
    { "c": "pan-", "a": "all, entire", "d": ["half, partial", "one, single"], "ex": "Pancytopenia: decrease in all blood cell types." },
    { "c": "macro-", "a": "large", "d": ["small", "new"], "ex": "Macrocyte: an abnormally large cell." },
    { "c": "micro-", "a": "small", "d": ["large", "many"], "ex": "A microscope magnifies small objects." },
    { "c": "hyper-", "a": "above normal, excessive", "d": ["below normal, deficient", "beside, near"], "ex": "Hyperglycemia: high blood sugar." },
    { "c": "hypo-", "a": "below normal, deficient", "d": ["above normal, excessive", "across, through"], "ex": "Hypothermia: low body temperature." },
    { "c": "brady-", "a": "slow", "d": ["fast", "painful"], "ex": "Bradycardia: slow heart rate." },
    { "c": "tachy-", "a": "fast, rapid", "d": ["slow, delayed", "normal, good"], "ex": "Tachypnea: rapid breathing." },
    { "c": "endo-", "a": "within, inside", "d": ["outside, outer", "upon, over"], "ex": "Endoscopy: viewing inside the body." },
    { "c": "ecto-", "a": "outside, outer", "d": ["within, inside", "behind, backward"], "ex": "Ectopic: located outside the usual place." },
    { "c": "epi-", "a": "upon, over", "d": ["below, under", "between"], "ex": "Epidermis: the layer upon the dermis." },
    { "c": "peri-", "a": "around, surrounding", "d": ["within", "after"], "ex": "Pericardium: the sac around the heart." },
    { "c": "para-", "a": "beside, near", "d": ["through, across", "above"], "ex": "The parathyroid glands lie beside the thyroid." },
    { "c": "sub-", "a": "below, under", "d": ["above, upon", "around"], "ex": "Subcutaneous: beneath the skin." },
    { "c": "supra-", "a": "above", "d": ["below", "between"], "ex": "Suprapubic: above the pubic bone." },
    { "c": "inter-", "a": "between", "d": ["within", "around"], "ex": "Intercostal: between the ribs." },
    { "c": "intra-", "a": "within", "d": ["between", "outside"], "ex": "Intramuscular: within a muscle." },
    { "c": "trans-", "a": "across, through", "d": ["around, surrounding", "below, under"], "ex": "Transdermal: through the skin." },
    { "c": "retro-", "a": "behind, backward", "d": ["in front, forward", "inside, within"], "ex": "Retroperitoneal: behind the peritoneum." },
    { "c": "ab-", "a": "away from", "d": ["toward", "together with"], "ex": "Abduction moves a limb away from the midline." },
    { "c": "ad-", "a": "toward", "d": ["away from", "against"], "ex": "Adduction moves a limb toward the midline." },
    { "c": "pre-", "a": "before", "d": ["after", "new"], "ex": "Prenatal: before birth." },
    { "c": "post-", "a": "after", "d": ["before", "again"], "ex": "Postoperative: after surgery." },
    { "c": "neo-", "a": "new", "d": ["old", "false"], "ex": "Neonate: a newborn infant." }
  ]
}
