    "geo": "node scripts/build-geo.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "d3-geo": "3.1.1",
    "flag-icons": "7.2.3",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2"
  }
}
